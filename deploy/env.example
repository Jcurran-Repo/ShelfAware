# ShelfAware droplet config -- copy to /etc/shelfaware/env, keep it root-owned, then:
#   chmod 600 /etc/shelfaware/env
# The systemd unit reads it via EnvironmentFile. Keys use env-var form: double
# underscore for the colon, so Llm__KeyMode is appsettings' Llm:KeyMode.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
DataDir=/var/lib/shelfaware

# Defense in depth for anything built from the request's Host header (the password-
# reset AND new-account activation email links -- both carry a set-password token --
# and OAuth redirect URIs): Caddy and the tunnel only proxy their exact hostname, but
# setting this makes the APP enforce it too - required reading if you swapped in the
# Nginx alternative (see docs/deploy-droplet.md).
# AllowedHosts=demo.shelfaware.net

# --- Whose keys? (the README's "Whose keys?" section is the full story) ---------
# Three postures:
#
# 1) Public DEMO box (demo.shelfaware.net) -- MANAGED with a DEDICATED, spend-capped key,
#    so a visitor can try the AI (receipts + chat + recipe reading) with NO key of their
#    own. Bound it hard, in layers: the per-household daily quotas below, the BOX-WIDE
#    daily valve in the "Demo box" section further down, the account cap + email
#    confirmation, AND -- the real ceiling -- a daily spend limit set ON THE KEY in the
#    Anthropic console. The box-wide valve hands a polite "come back tomorrow" BEFORE the
#    key's own limit hard-stops.
# Llm__KeyMode=Managed
# Llm__ApiKey=sk-ant-...        # a DEDICATED key, spend-capped in the provider console
# ElevenLabs__ApiKey=...        # only if the demo should read NEW recipes aloud (see Demo caps)
# ElevenLabs__AgentId=...       # only for the realtime cook-along agent
#
# 2) Self-host -- BYOK: the server ships NO usable keys; visitors paste their own in
#    Settings. Leaving KeyMode unset infers this from the missing key; stating it is explicit.
Llm__KeyMode=Byok
#
# 3) Family / private box -- MANAGED like (1) but private (no public sign-ups), so it
#    needs no demo caps; just the host keys and, optionally, the per-household quotas.
#
# Per-household daily quotas, managed mode only (BYOK is never metered; unset = unlimited):
# Llm__DailyCallLimit=200
# Llm__DailyTokenLimit=2000000
# ElevenLabs__DailySignedUrlLimit=40

# Self-host only: lets Settings point at a local OpenAI-compatible server (Ollama,
# LM Studio). Leave OFF on a public box -- a visitor-supplied URL the server will
# call is an SSRF invitation.
# Llm__AllowCustomEndpoint=true

# --- Read-aloud voice (TTS) -----------------------------------------------------
# Which provider voices recipe read-aloud + the chat's spoken confirmations. Default
# ElevenLabs (cloud; per-character cost; uses the ElevenLabs__ApiKey above). Set Local
# to run a self-hosted Kokoro sidecar ON THIS BOX instead -- $0 per call, no key,
# nothing to meter, which is why the managed demo box uses it. The sidecar is a
# separate systemd service; stand it up first: docs/deploy-kokoro.md.
# The STT "ear" (cook-along "next"/"stop" recognition) stays ElevenLabs regardless --
# moving speech RECOGNITION off ElevenLabs is a separate seam.
# Speech__Provider=Local
# Speech__Local__BaseUrl=http://127.0.0.1:8880   # where the Kokoro sidecar listens (loopback only)
# Speech__Local__Voice=af_heart                  # a Kokoro voice (af_bella, am_michael, ...)
# Speech__Local__Speed=0.9                        # under 1.0 so a busy cook can follow along
# Speech__Local__Model=kokoro
# Speech__Local__Format=mp3
# Speech__Local__ApiKey=                          # ONLY if the sidecar is secured; blank for a loopback one
#
# Read-aloud clip cache (both providers). A cache HIT needs no provider call, so seeded/
# demo recipes read for free. Per household; 0 = no cache (synthesize every time).
# Speech__CacheMegabytes=256

# --- Accounts -------------------------------------------------------------------
# Self-registration is open by default (the demo posture). Set false to close it;
# the very first account and invite-code joins stay possible either way.
# Auth__AllowRegistration=false

# Demo box abuse controls (docs/subscription-plan.md §10). Both default OFF, so the
# family/self-host posture is unchanged.
# Require a confirmed email before sign-in. On this box registration creates a
# PASSWORDLESS account and emails a link where the inbox-holder sets the password
# (which activates the account) -- so it NEEDS the Email section below (no mailer, no
# activation). Blocks EVERY unconfirmed account, so on a box with existing accounts,
# back-fill first (they already have passwords, so this just lets them sign in):
#   sqlite3 auth.db "UPDATE AspNetUsers SET EmailConfirmed = 1;"
# The family box needs neither: Cloudflare Access already verifies email at the edge.
# Auth__RequireEmailConfirmation=true
# Box-wide cap on NEW accounts created per day. On a RequireEmailConfirmation box, unset
# falls back to a default of 10/day so a public box is never accidentally unbounded; on a
# direct box, unset = no limit. Set explicitly to raise or lower it (a high value runs a
# confirmation-required box uncapped on purpose). On a direct box a valid invite-join is never
# capped; on a confirmation box the join happens later (uncapped) at the chooser, so the cap
# gates every registration there -- an invitee registers under it, then joins once activated.
# Auth__DailyAccountCreationLimit=10

# Box-wide daily AI valve (managed demo box only; docs/subscription-plan.md §10). The per-household
# quotas above are fair-per-visitor but DON'T bound the box under open registration -- every new
# household gets its own allowance. These are the box-wide bound: once the day's total across ALL
# households hits the cap, every AI call gets the polite "come back tomorrow" (until the key's own
# spend limit, the real ceiling, would otherwise hard-stop). All unset = unbounded, so the
# family/self-host box is untouched. Tune against your key's spend limit and expected traffic.
# Demo__DailyGlobalCallLimit=300        # host-key LLM calls/day across everyone (chat + receipts + advisors)
# Demo__AlertThreshold=50               # log a Warning (server logs; the crossing also shows on /admin's
                                        # "Demo box usage" panel) when the day crosses this -- an early
                                        # "traffic is arriving / cost is accruing" heads-up under the cap

# --- Email (the password-reset link, and the demo box's account-activation link) -
# Config-gated: leave it out and the feature stands down everywhere it shows. Gmail
# route (same as the family box): an app password needs 2-Step Verification on.
# Email__SmtpHost=smtp.gmail.com
# Email__SmtpPort=587
# Email__SmtpUser=you@gmail.com
# Email__SmtpPassword=your-16-char-app-password
# Email__From=you@gmail.com
# Email__FromName=Reginald
# Outbound-mail bounds — matter on a PUBLIC box, where registration and forgot-password are an anonymous
# send surface. The per-recipient cooldown defaults to 60s (0 disables). Set a daily cap BELOW your
# provider's own send quota (a Gmail app password is ~500/day) so a flood of requests can't exhaust it and
# silently break activation for everyone:
# Email__DailyOutboundLimit=400
# Email__PerRecipientCooldownSeconds=60

# In-app problem reporting: sign-in email(s) granted the admin view (/admin — the
# error log plus every household's bug reports). Unset = the feature stands down
# everywhere (no footer link, no report form).
# Admin__Emails__0=you@example.com

# Google sign-in registers only when configured. Redirect URI in Google's console:
# https://<your-domain>/signin-google
# Authentication__Google__ClientId=...
# Authentication__Google__ClientSecret=...

# --- Timezone (docs/deploy-droplet.md step 2 -- read it before skipping) --------
# Every "today" in the app is server-local. Prefer setting the whole box:
#   timedatectl set-timezone America/New_York
# or set it for the service alone:
# TZ=America/New_York

# --- Locale (the timezone gotcha's sibling; found on the first live deploy) -----
# A systemd service starts with NO locale, and with none set .NET falls back to
# the invariant culture -- every price renders as "¤3.99" instead of "$3.99".
# Set the household's real locale:
LANG=en_US.UTF-8
