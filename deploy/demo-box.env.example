# ============================================================================
#  Reginald -- DEMO BOX config  (demo.shelfaware.net)
#
#  A ready-to-edit /etc/shelfaware/env for the MANAGED demo box. Fill the two
#  <SET ME ...> secrets below (nothing else needs editing for the standard demo
#  posture), then on the droplet:
#
#    sudo cp demo-box.env /etc/shelfaware/env
#    sudo chown root:root /etc/shelfaware/env
#    sudo chmod 600 /etc/shelfaware/env         # secrets live here -- keep it locked down
#    sudo systemctl restart shelfaware          # REQUIRED: this file is read once at boot
#
#  Then watch it come up:  journalctl -u shelfaware -f
#
#  Env-var form: double underscore for appsettings' colon (Llm__KeyMode = Llm:KeyMode).
#  Full reference for every option: deploy/env.example. How the valve works: docs/deploy-droplet.md.
# ============================================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
DataDir=/var/lib/shelfaware

# Prices render as "¤3.99" (invariant culture) without a locale; a systemd service has none.
LANG=en_US.UTF-8
# TZ=America/New_York          # uncomment if the box's own timezone isn't set (timedatectl)

# The password-reset AND account-activation email links are built from the request Host --
# pin the hostname so the app refuses foreign hosts (Caddy/the tunnel already only proxy it).
AllowedHosts=demo.shelfaware.net

# --- Managed AI: the demo runs on YOUR key so visitors need none of their own ------------
Llm__KeyMode=Managed
Llm__ApiKey=<SET ME: a DEDICATED Anthropic key -- and set a daily spend limit ON THE KEY in the console (the real ceiling)>
# Per-household daily quotas (fair-per-visitor; separate from the box-wide valve below):
Llm__DailyCallLimit=200
Llm__DailyTokenLimit=2000000

# --- Box-wide daily AI valve: the wallet bound open registration needs -------------------
# Once the day's total across ALL households hits the cap, every AI surface shows the polite
# "come back tomorrow" until midnight (server time). The REAL ceiling is the key's own spend
# limit above; this just hands the friendly message first. Tune to your traffic + budget.
Demo__DailyGlobalCallLimit=300
Demo__AlertThreshold=50        # log a Warning + show "· reached" on /admin's Demo box usage panel

# --- Sign-up abuse controls (a public box wants these) ----------------------------------
# Require a confirmed email before sign-in. NEEDS the Email block below (no mailer, no boot).
# NOTE: on a box with EXISTING accounts this locks them out until you backfill --
#   sqlite3 /var/lib/shelfaware/auth.db "UPDATE AspNetUsers SET EmailConfirmed = 1;"
# -- or just start from a fresh DB (nothing to backfill).
Auth__RequireEmailConfirmation=true
Auth__DailyAccountCreationLimit=10          # box-wide cap on new accounts per day

# --- Email (Gmail app-password route; 2-Step Verification must be ON for the account) ---
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=<SET ME: your-gmail-address@gmail.com>
Email__SmtpPassword=<SET ME: the 16-char Gmail APP password (not your login password)>
Email__From=<SET ME: your-gmail-address@gmail.com>
Email__FromName=Reginald
Email__DailyOutboundLimit=400               # below Gmail's ~500/day so a flood can't exhaust sending
Email__PerRecipientCooldownSeconds=60

# --- /admin dashboard (household roster, errors, AND the Demo box usage panel) -----------
Admin__Emails__0=<SET ME: the email of the account that should see /admin>

# --- Read-aloud voice: $0 in this process, and on THIS box it must be Piper --------------
# Leave COMMENTED until the model is unpacked on the box (the deploy's bootstrap does it) -- the
# app refuses to START if it is told to use a model that isn't there, which is right but is
# not what you want mid-deploy. Chat + receipts don't need it; with it off, read-aloud just
# fails soft. Turn it on after:
# Speech__Provider=Piper
# Speech__Piper__ModelDirectory=/var/lib/shelfaware-models/vits-piper-en_US-ryan-medium
# Speech__Piper__Speed=0.9
# Speech__Piper__NumThreads=2
#
# Ryan-medium, picked by ear in the bake-off (docs/voice-bakeoff.md) and measured on this droplet at
# 0.12-0.14x real time once loaded. The directory is the whole voice: the app reads the weights'
# name off it, so there is no ModelFile line to keep in step. The voice before it, lessac-medium, is
# still unpacked -- going back is that one line and a restart:
# Speech__Piper__ModelDirectory=/var/lib/shelfaware-models/vits-piper-en_US-lessac-medium
#
# ⚠️ Moving a box that ran lessac to Ryan, two things first:
#   1. Run the deploy once with bootstrap ticked. A box bootstrapped before Ryan became the default
#      does not have its directory, and the app refuses to START pointed at one that is not there.
#   2. DELETE any Speech__Piper__ModelFile line. An older env.example shipped one naming lessac's
#      file; left in, it wins over the directory, and Ryan's directory does not hold that file -- the
#      app refuses to start, naming it.
#
# ⚠️ NOT a -high Piper voice here, however much better it sounds: ryan-high measured 0.8-0.95x on
# this box, right at the line, on two cores the website shares.
#
# ⚠️ And NOT Kokoro, however much warmer it sounds. Measured on this droplet (DO-Regular, 2 vCPU):
# Kokoro takes 3.1x real time, so an 8.9-second reply costs 28 seconds of silence before a word is
# spoken. A demo visitor's clip cache always starts empty, so every visitor pays that in full.
# The bootstrap unpacks it too, so moving is one line and a restart:
# Speech__Provider=Kokoro
# Speech__Kokoro__ModelDirectory=/var/lib/shelfaware-models/kokoro-int8-en-v0_19
#
# Two more families exist -- Kitten (24 MB) and Matcha (an acoustic model plus a separate vocoder),
# neither measured on this droplet -- and the settings for both are in deploy/env.example. They are NOT offered above because the bootstrap unpacks only
# Piper and Kokoro: pointing this box at one of them without first putting its archive on disk by
# hand is a box that refuses to boot. docs/voice-bakeoff.md renders all four so the choice is made
# by ear, and says what to unpack where; teaching bootstrap about a winner is the follow-up.

# --- Speech recognition: $0 via Moonshine, in this process -------------------------------
# Same rule as the voice above -- leave COMMENTED until the model is unpacked (docs/deploy-moonshine.md),
# because the app refuses to START pointed at a model that isn't there. With BOTH this and the voice
# block on, the demo box needs no ElevenLabs key at all, which is the point: voice IN and OUT for free.
# Without it, a managed box with no ElevenLabs key simply offers no microphone (it does not offer one
# that fails) -- so chat and receipts still work, and the mic affordances stand down.
# Speech__Ear=Moonshine
# Speech__Moonshine__ModelDirectory=/var/lib/shelfaware-models/sherpa-onnx-moonshine-tiny-en-int8
# Speech__Moonshine__NumThreads=2

# --- Deliberately NOT set on the demo box -----------------------------------------------
# * No "ElevenLabs" section -> with a local mouth + Moonshine above, no voice bill to run up.
#                             ⚠️ An ElevenLabs key on a public managed box is host-key spend the
#                             box-wide valve does NOT bound (it counts LLM calls only). Leave it unset.
# * No "Payments" section  -> billing is off, so AI simply works for every fresh household
#                             (gated only by the caps above). The demo is free.
# * No "Authentication:Google" -> no OAuth surface (add it later if you want Google sign-in).
# * No "GraphQL" -> the read-only API stays off (a demo doesn't need it).
# * Auth__AllowRegistration defaults TRUE (open sign-ups) -- that's the demo posture; leave it.
