{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // The hands-free reader logs what it HEARD at Debug — a microphone in a kitchen shouldn't record
      // its owner's speech to disk on a real deployment, but in dev it's the only way to see why a
      // misheard phrase went the wrong way. Development only; production keeps it off.
      "ShelfAware.Web.Components.RecipeReadAloud": "Debug"
    }
  },

  // Turns on GET /dev/login — a one-navigation sign-in past the auth wall for driving the dev server.
  // This file only loads under ASPNETCORE_ENVIRONMENT=Development, and DevAuth.IsEnabled ALSO requires
  // the Development environment, so this flag is inert on any real deployment (all Production) even if
  // the file rides along in the publish. See ShelfAware.Web.Auth.DevAuth.
  "Dev": {
    "QuickLogin": true
  },

  // The quick-login sandbox account doubles as the admin in dev, so the problem-reporting surfaces
  // (/bugs, /admin, the footer) are drive-testable one navigation past /dev/login. Development-only
  // for the same reason as the flag above; a real deployment configures its own Admin:Emails.
  "Admin": {
    "Emails": [ "dev@shelfaware.local" ]
  }
}
