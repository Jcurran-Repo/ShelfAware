<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ShelfAware.Core\ShelfAware.Core.csproj" />
    <ProjectReference Include="..\ShelfAware.Llm\ShelfAware.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Override the vulnerable SQLitePCLRaw 2.1.11 that EF Core 10.0.9 pulls in transitively
         (GHSA-2m69-gcr7-jv3q, high severity). The 2.1.x line was never patched; the fix ships
         in the 3.x line, which is API-compatible with Microsoft.Data.Sqlite. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample pantry's one un-reviewed receipt, shipped inside the assembly rather than under
         wwwroot: it is demo CONTENT, not a public asset, and nothing should be able to fetch it by
         URL. Its printed lines are the ground truth for the PendingReview rows DemoDataSeeder writes
         — change one and you must change the other, or the review screen describes a different
         receipt from the one it can show you. (A copy of test-fixtures/walmart-receipt.png, which
         serves browser-upload testing; the app owns this one so the fixture can change freely.) -->
    <EmbeddedResource Include="Data\demo-receipt.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page-test harness scripts the browser side of the voice components, which means
         constructing the JS-interop DTO records (VoiceCapture, SessionResult, HeardResult) that
         the components deserialize from their modules. Those records are internal, not public —
         they mirror private JS shapes and are nobody else's contract. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ShelfAware.Web.UI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>3d6755e6-9881-43a6-813c-fe3ebd974cd9</UserSecretsId>
  </PropertyGroup>

</Project>
