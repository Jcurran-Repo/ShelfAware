@page "/history"
@using ShelfAware.Core.Domain
@using ShelfAware.Web.Undo
@inject ActivityLogService ActivityLog
@inject ILogger<History> Logger

<PageTitle>History — Shelf Aware</PageTitle>

<div class="page-head">
    <h1>Activity history</h1>
</div>

<p class="muted">Everything you've done here, newest first — undo anything that's still reversible.</p>

@* Persistent announcer, mounted before any action: a live region first filled on insert isn't
   reliably announced, so the region exists up front and only its text changes (items 47/49). *@
<div class="visually-hidden" role="status" aria-live="polite">@announcement</div>
@if (actionError is not null)
{
    <p class="error" role="alert">@actionError</p>
}

@if (pendingConfirm is not null)
{
    <div class="picker-backdrop" @onclick="CancelDestructiveUndo">
        <div class="panel picker-modal" @onclick:stopPropagation="true" role="alertdialog"
             aria-label="Confirm delete" aria-describedby="destructive-undo-warning">
            <p id="destructive-undo-warning">@confirmWarning</p>
            <div class="modal-actions">
                <button class="danger" @onclick="ConfirmDestructiveUndo" disabled="@busy">Delete anyway</button>
                <button class="secondary" @onclick="CancelDestructiveUndo" disabled="@busy">Cancel</button>
            </div>
        </div>
    </div>
}

<section class="panel history">
    @if (loadError is not null)
    {
        <p class="error" role="alert">@loadError</p>
    }
    else if (rows is null)
    {
        <p>Loading…</p>
    }
    else if (rows.Count == 0)
    {
        <p class="muted">Nothing yet — your purchases, counts, and edits will show up here.</p>
    }
    else
    {
        @foreach (var day in rows.GroupBy(r => DayOf(r.Entry)))
        {
            <table>
                <caption>@DayLabel(day.Key)</caption>
                <tbody>
                    @foreach (var row in day)
                    {
                        @* Greyed unless it can actually be undone right now — never a dead Undo button. A
                           NeedsConfirmation row IS actionable (it warns first), so it isn't greyed either. *@
                        <tr @key="row.Entry.Id"
                            class="@(row.State is UndoOutcome.Done or UndoOutcome.NeedsConfirmation ? null : "muted")">
                            <td class="history-time muted">@row.Entry.OccurredAt.ToString("h:mm tt")</td>
                            <td class="history-what">@row.Entry.Summary</td>
                            <td class="history-action">
                                @switch (row.State)
                                {
                                    case UndoOutcome.Done:
                                        <button class="linkish" @onclick="() => UndoAsync(row.Entry)" disabled="@busy"
                                                aria-label="@($"Undo: {row.Entry.Summary}")">↩ Undo</button>
                                        break;
                                    case UndoOutcome.NeedsConfirmation:
                                        @* Still undoable, but destructive (a recipe used since it was saved) — click
                                           warns first. Not greyed. *@
                                        <button class="linkish" @onclick="() => UndoAsync(row.Entry)" disabled="@busy"
                                                title="You've used this since saving it — undoing will confirm first"
                                                aria-label="@($"Undo: {row.Entry.Summary} — will confirm first")">↩ Undo…</button>
                                        break;
                                    case UndoOutcome.AlreadyUndone:
                                        @* Peek can report AlreadyUndone from a concurrent undo AFTER this
                                           row's snapshot was fetched, so UndoneAt may be stale-null — omit
                                           the date rather than render "undone " with a blank. *@
                                        <span>undone@(row.Entry.UndoneAt is { } at ? $" {at:MMM d}" : "")</span>
                                        break;
                                    case UndoOutcome.Superseded:
                                        <span title="Something changed this since — undoing would overwrite it">changed since</span>
                                        break;
                                    case UndoOutcome.Gone:
                                        <span>no longer here</span>
                                        break;
                                    default:
                                        <span>can't be undone</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (canShowMore)
        {
            <button class="secondary" @onclick="ShowAllAsync" disabled="@busy">Show all history</button>
        }
        else if (truncated)
        {
            <p class="muted">Showing the most recent @rows.Count actions.</p>
        }
    }
</section>

@code {
    private sealed record Row(ActivityEntry Entry, UndoOutcome State);

    private const int RecentCount = 30;
    private const int AllCap = 500;

    private List<Row>? rows;
    private string? announcement;
    private string? actionError;
    private string? loadError;
    private bool busy;
    private bool showingAll;
    private bool canShowMore;
    private bool truncated;
    /// <summary>The entry a destructive undo is being confirmed for (a recipe used since it was saved), and
    /// the warning to show; null when no confirm is pending.</summary>
    private ActivityEntry? pendingConfirm;
    private string? confirmWarning;

    protected override Task OnInitializedAsync() => LoadAsync(all: false);

    /// <summary>Load the history and, for each shown entry, its live undoability via <c>PeekAsync</c> —
    /// the SAME precondition the real undo runs, so the button shows only when it would truly act.</summary>
    private async Task LoadAsync(bool all)
    {
        try
        {
            var limit = all ? AllCap : RecentCount;
            var fetched = await ActivityLog.GetHistoryAsync(limit + 1); // +1 to detect "there's more"
            canShowMore = !all && fetched.Count > RecentCount;
            truncated = all && fetched.Count > AllCap;

            var built = new List<Row>();
            foreach (var entry in fetched.Take(limit))
                built.Add(new Row(entry, await ActivityLog.PeekAsync(entry.Id)));
            rows = built;
            showingAll = all;
            loadError = null;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the activity history failed.");
            loadError = "Couldn't load your history just now — reload the page to try again.";
        }
    }

    private async Task ShowAllAsync()
    {
        if (busy) return;
        busy = true;
        try { await LoadAsync(all: true); }
        finally { busy = false; }
    }

    private async Task UndoAsync(ActivityEntry entry)
    {
        if (busy) return;
        busy = true;
        announcement = null; // cleared first so the change is re-announced even if the text repeats
        actionError = null;
        try
        {
            // No cancellation token: an undo is a one-shot write and must not be torn down by a
            // navigate-away mid-flight (the same posture as ReportResolutionService, item 49).
            var outcome = await ActivityLog.UndoAsync(entry.Id); // confirmDestructive: false
            if (outcome == UndoOutcome.NeedsConfirmation)
            {
                // Destructive (a recipe used since it was saved) — nothing was deleted; warn and ask.
                confirmWarning = await ActivityLog.DescribeDestructiveUndoAsync(entry.Id)
                    ?? "Undoing this deletes the recipe and everything you've added to it since. Delete anyway?";
                pendingConfirm = entry;
                return; // finally clears busy; the dialog takes it from here
            }
            await LoadAsync(showingAll); // re-read: the undo may have changed sibling entries' states too
            announcement = Announce(outcome, entry);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            // Only reachable when the undo itself threw (its commit failed) — LoadAsync is self-catching
            // (it sets loadError, never rethrows non-cancellation) and Announce is pure, so past a committed
            // undo nothing lands here. So "try again" is always accurate: nothing was committed.
            Logger.LogError(ex, "Undoing activity {Id} failed.", entry.Id);
            actionError = "Couldn't undo just now — please try again.";
        }
        finally { busy = false; }
    }

    /// <summary>The user confirmed a destructive undo — do it for real.</summary>
    private async Task ConfirmDestructiveUndo()
    {
        if (pendingConfirm is not { } entry || busy) return;
        busy = true;
        announcement = null;
        actionError = null;
        try
        {
            var outcome = await ActivityLog.UndoAsync(entry.Id, confirmDestructive: true);
            pendingConfirm = null;
            confirmWarning = null;
            await LoadAsync(showingAll);
            announcement = Announce(outcome, entry);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            // As in UndoAsync: reachable only when the undo itself threw, so "try again" is accurate.
            Logger.LogError(ex, "Confirming a destructive undo of activity {Id} failed.", entry.Id);
            actionError = "Couldn't undo just now — please try again.";
        }
        finally { busy = false; }
    }

    private void CancelDestructiveUndo()
    {
        pendingConfirm = null;
        confirmWarning = null;
    }

    private static string Announce(UndoOutcome outcome, ActivityEntry entry) => outcome switch
    {
        UndoOutcome.Done => $"Undone: {entry.Summary}",
        UndoOutcome.AlreadyUndone => "That was already undone.",
        UndoOutcome.Superseded => "Couldn't undo — something changed since.",
        UndoOutcome.Gone => "Couldn't undo — it's no longer here.",
        _ => "That can't be undone.",
    };

    // The day an entry belongs to, by its recorded (server-local) date — the same ".Date" reading the
    // rest of the app uses for a stamped time (SignalDate.Of, item 19), so grouping matches everywhere.
    private static DateOnly DayOf(ActivityEntry e) => DateOnly.FromDateTime(e.OccurredAt.Date);

    private static string DayLabel(DateOnly day)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (day == today) return "Today";
        if (day == today.AddDays(-1)) return "Yesterday";
        return day.ToString("dddd, MMM d, yyyy");
    }
}
