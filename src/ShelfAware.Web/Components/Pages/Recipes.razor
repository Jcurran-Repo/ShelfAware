@page "/recipes"
@implements IDisposable
@using System.Text.Json
@using ShelfAware.Core.Chat
@using ShelfAware.Core.Prediction
@using ShelfAware.Core.Recipes
@using ShelfAware.Core.Settings
@using ShelfAware.Core.Shopping
@using ShelfAware.Web.Undo
@inject IHouseholdDbFactory DbFactory
@inject IPantryStore Store
@inject ActivityLogService ActivityLog
@inject IAppSettings Settings
@inject IRecipeAdvisor Advisor
@inject IRecipeAdapter Adapter
@inject IIngredientAlternativesAdvisor AltAdvisor
@inject ShelfAware.Core.Speech.IVoiceCredentials Voice
@inject VoiceCoordinator Coordinator
@inject NavigationManager Nav
@inject ILogger<Recipes> Logger

<PageTitle>Recipes — Shelf Aware</PageTitle>

<div class="page-head">
    <h1>Recipes</h1>
</div>

<p class="recipe-disclaimer" role="note">
    ⚠️ Ideas only — <strong>always check ingredient labels yourself</strong>. This is not allergy-safe or
    medical advice; the “won’t eat” list is a best-effort filter, not a guarantee.
</p>

<section class="panel">
    <h2>Foods I won’t eat</h2>
    <p class="muted">Allergies or dislikes — recipes will avoid these. Applies to every suggestion.</p>
    <div class="tag-list">
        @foreach (var f in excludedFoods)
        {
            <span class="tag-chip">@f.Value<button type="button" class="tag-x" @onclick="() => RemoveExcluded(f)" aria-label="Remove @f.Value">×</button></span>
        }
        @if (excludedFoods.Count == 0)
        {
            <span class="muted">Nothing excluded yet.</span>
        }
    </div>
    <div class="tag-add">
        <input placeholder="e.g. mushrooms" @bind="newExcluded" @bind:event="oninput"
               aria-label="Add a food you won't eat" />
        <button type="button" @onclick="AddExcluded" disabled="@string.IsNullOrWhiteSpace(newExcluded)">Add</button>
    </div>
</section>

<section class="panel">
    <h2>What can I make?</h2>
    <form @onsubmit="Suggest" @formname="recipe-request">
        <input @bind="request" @bind:event="oninput" placeholder="e.g. I'm feeling Mediterranean tonight"
               aria-label="Describe what you're in the mood for" disabled="@suggesting" />
        <button type="submit" disabled="@(suggesting || string.IsNullOrWhiteSpace(request))">
            @(suggesting ? "Thinking…" : "Get ideas")
        </button>
    </form>
    @if (suggestError is not null)
    {
        <p class="error">@suggestError</p>
    }

    @if (suggestions.Count > 0)
    {
        <div class="suggestions-head">
            <p class="muted small">
                Ideas for &ldquo;@suggestedFor&rdquo; — @suggestedAt.ToString("MMM d")
                <span class="muted"> · kept until you clear or get new ideas</span>
            </p>
            <button type="button" class="secondary" @onclick="ClearSuggestions" aria-label="Clear these recipe ideas">Clear ideas</button>
        </div>
        <div class="recipe-suggestions">
            @foreach (var s in suggestions)
            {
                <article class="recipe-card">
                    <div class="recipe-card-top">
                        <h3>@s.Name</h3>
                        <button class="secondary" @onclick="() => Save(s)" disabled="@savedNames.Contains(s.Name)">
                            @(savedNames.Contains(s.Name) ? "Saved ✓" : "Save")
                        </button>
                    </div>
                    <p class="muted">@s.Blurb</p>
                    @if (s.CaloriesPerServing is { } cal)
                    {
                        <p class="recipe-cal">~@cal cal / serving <span class="muted">(est.)</span></p>
                    }
                    <ul class="ingredient-list">
                        @foreach (var i in s.Ingredients.Where(i => i.IsMain))
                        {
                            var haveIt = HaveSuggested(i);
                            <li class="@(haveIt ? "have" : "grab")">
                                @(haveIt ? "✓" : "🛒") @Qty(i.Quantity, i.Name)
                                @if (!haveIt && MaybeHave(i.Name, i.MatchedProduct) is { } outItem)
                                {
                                    @if (outItem.Untracked)
                                    {
                                        <span class="maybe-have">you have this as <strong>@outItem.Name</strong>, but it's untracked</span>
                                        <button type="button" class="restock-btn" @onclick="() => TrackIt(outItem.Id)"
                                                disabled="@restockBusy"
                                                title="Track @outItem.Name again so recipes and the grocery list can see it"
                                                aria-label="Track @outItem.Name again">Track it</button>
                                    }
                                    else
                                    {
                                        <span class="maybe-have">you may still have <strong>@outItem.Name</strong> — it just looks run-out</span>
                                        <button type="button" class="restock-btn" @onclick="() => Restocked(outItem.Id)"
                                                disabled="@restockBusy"
                                                title="Still have @outItem.Name at home — clears the run-out and this goes green"
                                                aria-label="Mark @outItem.Name restocked — you still have it">Restocked</button>
                                    }
                                }
                            </li>
                        }
                        @{ var seasonings = s.Ingredients.Where(i => !i.IsMain).Select(i => i.Name).ToList(); }
                        @if (seasonings.Count > 0)
                        {
                            <li class="muted">+ @string.Join(", ", seasonings)</li>
                        }
                    </ul>
                    @{ var grab = s.Ingredients.Where(i => i.IsMain && !HaveSuggested(i)).ToList(); }
                    @if (grab.Count > 0)
                    {
                        <p class="recipe-grab">Grab: <strong>@string.Join(", ", grab.Select(g => g.Name))</strong></p>
                    }
                    else
                    {
                        <p class="recipe-grab all-good">You’ve got everything for this. 🎉</p>
                    }
                    @if (s.Steps.Count > 0)
                    {
                        <details class="recipe-steps">
                            <summary>Steps (@s.Steps.Count)</summary>
                            <ol>
                                @foreach (var step in s.Steps)
                                {
                                    <li>@step</li>
                                }
                            </ol>
                        </details>
                    }
                </article>
            }
        </div>
    }
</section>

<section class="panel">
    <div class="page-head">
        <h2>Saved recipes <span class="muted">— @displayed.Count</span></h2>
        @if (PickPool.Count > 0)
        {
            <button @onclick="PickForMe">🎲 Pick for me</button>
        }
    </div>
    @if (filterProductName is not null)
    {
        <p class="filter-banner" role="status">Showing recipes that use <strong>@filterProductName</strong> — <a href="/recipes">show all</a></p>
    }
    @if (readingRecipe is not null)
    {
        @* Keyed on the MODE as well as the recipe: switching the same recipe between hands-free and
           buttons has to build a new reader, or the ears never open (or never close) — the mic is
           acquired on first render, which a parameter change alone doesn't repeat. *@
        <RecipeReadAloud Recipe="readingRecipe" HandsFree="readingHandsFree"
                         @key="(readingRecipe.Id, readingHandsFree)" OnClosed="StopReading" />
    }
    @if (cookingRecipe is not null)
    {
        <CookAlong Recipe="cookingRecipe" @key="cookingRecipe.Id" OnClosed="StopCooking" OnUnavailable="HandleAgentUnavailable" />
    }
    @if (picked is not null)
    {
        <p class="picked-banner">Tonight: <strong>@picked.Name</strong>@(picked.Blurb is { Length: > 0 } pb ? $" — {pb}" : "")</p>
    }
    @if (extraNote is not null)
    {
        <p class="chat-reply" role="status">@extraNote</p>
    }
    @if (adaptNote is not null)
    {
        <p class="chat-reply" role="status">@adaptNote</p>
    }
    @if (imOutNote is not null)
    {
        <p class="muted" role="status">@imOutNote</p>
    }
    @if (displayed.Count == 0)
    {
        <p class="muted">
            @(filterProductName is null
                ? "None yet — get some ideas above and hit Save on the ones you like."
                : $"No saved recipes use {filterProductName} yet.")
        </p>
    }
    else
    {
        <ul class="saved-recipes">
            @foreach (var (r, kind) in renderList)
            {
                if (kind == RowKind.ParentReference)
                {
                    <li id="recipe-@r.Id" class="recipe-reference">
                        <div class="saved-top">
                            <strong>@r.Name</strong>
                            <span class="chip variant-chip" title="Original recipe — the adapted version that uses this item is below">for reference</span>
                        </div>
                        <p class="muted small">You’ve adapted this to use what you have — the matching version is below.</p>
                    </li>
                    continue;
                }
                var isVariant = kind == RowKind.Variant;
                var makeability = r.MakeabilityWith(onHand);
                <li id="recipe-@r.Id" class="@(isVariant ? "recipe-variant" : null)">
                    <div class="saved-top">
                        <strong>@r.Name</strong>
                        <span class="@MakeabilityFormat.ChipClass(makeability)">@MakeabilityFormat.Label(makeability)</span>
                        @if (isVariant)
                        {
                            <span class="chip variant-chip" title="Adapted to use what you have">🔀 adapted</span>
                        }
                        <span class="saved-actions">
                            @* Cook-along is OUR reader now: it listens between steps, answers on the same
                               brain as the assistant, and re-reads a recipe for free once it's cached.
                               The caret carries the alternatives — a no-microphone read, and the
                               ElevenLabs realtime agent for anyone who wants interruption mid-sentence
                               and is paying for it. The caret IS the choice: per-recipe, at the moment
                               you care, rather than a preference buried in Settings. *@
                            @if (r.Steps.Count > 0)
                            {
                                <SplitButton PrimaryLabel="🎙 Cook-along" MainClass="secondary" OnPrimary="() => StartHandsFree(r)"
                                             PrimaryAriaLabel="@($"Hands-free cook-along for {r.Name}")">
                                    <button class="secondary" @onclick="() => StartReading(r)"
                                            aria-label="Read @r.Name aloud without the microphone"
                                            title="Buttons only — no microphone. Synthesized once, then free to re-read.">🔊 Read it to me</button>
                                    @if (CookAlongAvailable)
                                    {
                                        <button class="secondary" @onclick="() => StartAgent(r)"
                                                aria-label="Live ElevenLabs agent cook-along for @r.Name"
                                                title="Interrupt it mid-sentence. Runs on your ElevenLabs key and is billed per minute of conversation.">💬 Live agent</button>
                                    }
                                </SplitButton>
                            }
                            <button class="secondary" @onclick="() => MarkEaten(r)" disabled="@eatBusy"
                                    aria-label="Mark @r.Name eaten">Ate it</button>
                            @if (makeability == Makeability.Missing)
                            {
                                <button class="secondary" @onclick="() => AddMissingToList(r)" aria-label="Add missing ingredients for @r.Name to the grocery list">Add missing to list</button>
                            }
                            <button class="secondary" @onclick="() => AdaptRecipe(r)" disabled="@(adaptingId == r.Id)"
                                    aria-label="Adapt @r.Name to use what you have">@(adaptingId == r.Id ? "Adapting…" : "🔀 Adapt to what I have")</button>
                            <button class="icon-btn" @onclick="() => DeleteSaved(r)" aria-label="Delete @r.Name" title="Delete @r.Name"><span aria-hidden="true">🗑</span></button>
                        </span>
                    </div>
                    @* "Makeable with a swap": every main is covered, but at least one only by a stand-in you
                       own (chuck roast for steak). "Also works as" means you'll EAT it, not that it cooks the
                       same — so point at Adapt to rebuild the steps, never imply "cook this as written". *@
                    @if (makeability == Makeability.NeedsSwap)
                    {
                        <p class="muted small" role="note">Uses a stand-in you own — the steps are written for the original and can cook differently. <strong>🔀 Adapt to what I have</strong> rebuilds them for what you're actually using.</p>
                    }
                    @* §13.3: tell, don't ask. The tap commits in one go; this notice then says exactly
                       what it took — the decrement is approximate by design (it can't parse "2 lbs"),
                       so it must never be silent — with Undo as the one-tap way back. *@
                    @if (eatError is { } problem && problem.RecipeId == r.Id)
                    {
                        <p class="error" role="alert">@problem.Message</p>
                    }
                    @if (lastEat is { } done && done.RecipeId == r.Id)
                    {
                        <div class="panel inline-confirm" role="status">
                            @if (done.Taken.Count > 0)
                            {
                                <p>Marked eaten — and taken off what you have on hand:</p>
                                <ul>
                                    @foreach (var take in done.Taken)
                                    {
                                        <li>
                                            <strong>@take.ProductName</strong> —
                                            @QuantityFormat.Describe(take.Taken, take.DefaultUnit) off,
                                            @QuantityFormat.Describe(take.Remaining, take.DefaultUnit) left
                                        </li>
                                    }
                                </ul>
                                <p class="muted small">One package each — the app can't tell from "2 lbs" how much
                                    of a pack a recipe really used, so it charges a whole one. That errs toward
                                    rebuying early. Wrong? Undo puts it back, or set the real number on the
                                    item's page.</p>
                            }
                            else
                            {
                                <p>Marked eaten.</p>
                            }
                            @* Questions the picker asked and the human clicked away from — said, not
                               hidden, or a count would go quietly un-maintained. *@
                            @if (done.Skipped.Count > 0)
                            {
                                <p class="muted">
                                    Left uncounted — you didn't pick a product for:
                                    @string.Join("; ", done.Skipped.Select(s => s.Ingredient)).
                                    Set the number by hand on whichever you actually used, or pin the recipe
                                    to one of them with the ⇄ swap so it stops being a question.
                                </p>
                            }
                            <button type="button" class="secondary" @onclick="UndoEat" disabled="@eatBusy">
                                @(eatBusy ? "Working…" : "↩ Undo")
                            </button>
                            <button type="button" class="secondary" @onclick="DismissEat"
                                    disabled="@eatBusy">Dismiss</button>
                        </div>
                        @* §13.3's picker: the app can't know WHICH counted product came off the shelf, so
                           it asks — once, on the spot, with the candidates on screen. Click-away answers
                           "none of these" and no count moves. *@
                        @if (done.ToPick.Count > 0)
                        {
                            <div class="picker-backdrop" @onclick="ClosePicker">
                                <div class="panel picker-modal" @onclick:stopPropagation="true"
                                     role="dialog" aria-label="Which did you use?">
                                    <p><strong>Which did you use?</strong> <span class="muted">More than one
                                        thing you count could be what the recipe means. Pick what came off
                                        the shelf, or click away and the counts stay put.</span></p>
                                    @foreach (var question in done.ToPick)
                                    {
                                        <p class="muted small">@question.Ingredient</p>
                                        <div class="alt-cloud" role="group"
                                             aria-label="Counted products that could be @question.Ingredient">
                                            @foreach (var candidate in question.Candidates)
                                            {
                                                <button type="button" class="alt-bubble have" disabled="@eatBusy"
                                                        @onclick="() => PickCandidate(question, candidate)">
                                                    @candidate.ProductName —
                                                    @QuantityFormat.Describe(candidate.OnHand, candidate.DefaultUnit) on hand
                                                </button>
                                            }
                                        </div>
                                    }
                                    <button type="button" class="secondary" @onclick="ClosePicker"
                                            disabled="@eatBusy">None of these</button>
                                </div>
                            </div>
                        }
                    }
                    @if (r.Blurb is { Length: > 0 })
                    {
                        <p class="muted">@r.Blurb</p>
                    }
                    @if (r.EstimatedCaloriesPerServing is { } cal)
                    {
                        <p class="recipe-cal">~@cal cal / serving <span class="muted">(est.)</span></p>
                    }
                    <ul class="ingredient-list">
                        @foreach (var i in r.MainIngredients)
                        {
                            @* Covering products computed ONCE per main (both the tick and the confidence read
                               them — the same matcher, so they can't disagree). *@
                            var coverage = CoveringInStock(i.Name, i.MatchedProduct);
                            var have = coverage.Count > 0;
                            var confident = coverage.Any(c => c.CountBacked);
                            // Direct (you own the food) vs Substitute (only a declared stand-in covers it) —
                            // same matcher as `have`, so they can't disagree about coverage.
                            var cover = i.CoverageBy(onHand);
                            <li class="@(have ? (confident ? "have" : "have likely") : "grab")">
                                <span class="ingredient-name">@(have ? "✓" : "🛒") @Qty(i.Quantity, i.Name)</span>
                                @* A ✓ that comes only from a declared stand-in (chuck roast for steak) says so:
                                   the steps are written for the original and may cook differently, so it points
                                   at Adapt rather than reading as "cook this as written". *@
                                @if (cover == IngredientCoverage.Substitute)
                                {
                                    <span class="swap-note" title="You don't have @i.Name, but a stand-in you own covers it. The steps are written for @i.Name and may cook differently — use 🔀 Adapt to rebuild them.">stand-in — Adapt for the right steps</span>
                                }
                                @* Part A — honesty: a ✓ backed only by the rhythm (no fresh count) reads "likely",
                                   not a confident tick. Asserting the guess is the false positive that erodes trust. *@
                                @if (have && !confident)
                                {
                                    <span class="likely-note" title="You haven't counted this — Shelf Aware is going by your usual buying rhythm. Tap &quot;I'm out&quot; if you don't actually have it.">likely</span>
                                }
                                <button type="button" class="alt-swap" @onclick="() => ToggleAlternatives(i)"
                                        aria-label="Swap @i.Name for something else" title="Swap this ingredient">⇄</button>
                                @* Part B — the correction the feature was missing: the recipe said you have it, but
                                   you don't. Files a real OutNow (sticks, undoable) and flips the row to Missing. *@
                                @if (have)
                                {
                                    <button type="button" class="imout-btn" @onclick="() => ImOut(i)" disabled="@restockBusy"
                                            title="Not actually got @i.Name? Mark it out — it moves to your grocery list and dashboard"
                                            aria-label="Mark @i.Name out — you don't actually have it">I'm out</button>
                                }
                                @if (!have && MaybeHave(i.Name, i.MatchedProduct) is { } outItem)
                                {
                                    @if (outItem.Untracked)
                                    {
                                        <span class="maybe-have">you have this as <strong>@outItem.Name</strong>, but it's untracked</span>
                                        <button type="button" class="restock-btn" @onclick="() => TrackIt(outItem.Id)"
                                                disabled="@restockBusy"
                                                title="Track @outItem.Name again so recipes and the grocery list can see it"
                                                aria-label="Track @outItem.Name again">Track it</button>
                                    }
                                    else
                                    {
                                        @* If you JUST tapped "I'm out" on this, it's a DECLARED out — don't say "it just
                                           looks run-out" (that would contradict your own tap: one prediction, one story).
                                           The predicted-run-out copy still serves a row the engine merely inferred. Either
                                           way Restocked is the one-tap reverse. *@
                                        @if (justMarkedOut.Contains(outItem.Id))
                                        {
                                            <span class="maybe-have">you marked <strong>@outItem.Name</strong> out</span>
                                        }
                                        else
                                        {
                                            <span class="maybe-have">you may still have <strong>@outItem.Name</strong> — it just looks run-out</span>
                                        }
                                        <button type="button" class="restock-btn" @onclick="() => Restocked(outItem.Id)"
                                                disabled="@restockBusy"
                                                title="Have @outItem.Name after all? Restocked clears it and this goes green"
                                                aria-label="Mark @outItem.Name restocked — you still have it">Restocked</button>
                                    }
                                }
                                @if (openAltFor == i.Id)
                                {
                                    var cloud = CloudFor(i);
                                    <div class="alt-cloud" role="group" aria-label="Swap @i.Name">
                                        @if (generatingAltFor == i.Id)
                                        {
                                            <span class="muted small">Finding swaps…</span>
                                        }
                                        else if (cloud.Count == 0)
                                        {
                                            <span class="muted small">No good swaps for this one.</span>
                                        }
                                        else
                                        {
                                            @foreach (var alt in cloud)
                                            {
                                                var altHave = HaveForm(alt);
                                                <button type="button" class="alt-bubble @(altHave ? "have" : "grab")"
                                                        disabled="@(adaptingId == r.Id)"
                                                        @onclick="() => AdaptToChoice(r, i, alt)"
                                                        title="Make a version with @alt">@(altHave ? "✓" : "🛒") @alt</button>
                                            }
                                        }
                                    </div>
                                }
                            </li>
                        }
                        @{ var extras = r.Seasonings.Select(i => i.Name).ToList(); }
                        @if (extras.Count > 0)
                        {
                            <li class="muted">+ @string.Join(", ", extras)</li>
                        }
                    </ul>
                    @if (r.TimesEaten > 0)
                    {
                        <p class="muted small">eaten @r.TimesEaten×</p>
                    }
                    @if (r.Steps.Count > 0)
                    {
                        <details class="recipe-steps">
                            <summary>Steps (@r.Steps.Count)</summary>
                            <ol>
                                @foreach (var step in r.Steps.OrderBy(s => s.Order))
                                {
                                    <li>@step.Text</li>
                                }
                            </ol>
                        </details>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private List<ExcludedFood> excludedFoods = [];
    private string newExcluded = "";

    private string request = "";
    private bool suggesting;
    private string? suggestError;
    private List<RecipeSuggestion> suggestions = [];
    // What the current batch was generated for and when — shown above the cards, persisted with them.
    private string suggestedFor = "";
    private DateTimeOffset suggestedAt;

    /// <summary>The persisted shape of a "Get ideas" batch (SettingKeys.LastRecipeSuggestions): an AI
    /// call's results are too expensive to evaporate on navigation or a server restart, so the latest
    /// batch is kept per household until replaced or cleared. Have/grab marks are NOT stored — they
    /// recompute live against the current pantry on every render, so an old batch stays truthful.</summary>
    private sealed record SuggestionSnapshot(string Request, DateTimeOffset GeneratedAt, List<RecipeSuggestion> Suggestions);

    private List<Recipe> savedRecipes = [];
    private HashSet<string> savedNames = new(StringComparer.OrdinalIgnoreCase);

    // The originals actually rendered — all of them, or just those using a product when ?uses is set.
    private List<Recipe> displayed = [];
    // Flattened for rendering: originals and their adapted variants, grouped. Under a ?uses filter a
    // variant can match on its own ingredients while its original doesn't (Adapt swaps the main), so a
    // non-matching original may appear as a ParentReference — shown for context only, not as a result.
    private enum RowKind { Original, Variant, ParentReference }
    private List<(Recipe Recipe, RowKind Kind)> renderList = [];
    private Dictionary<int, string> productNamesById = [];
    private string? filterProductName;
    private int? adaptingId;      // the recipe currently being adapted (button shows a spinner)
    private string? adaptNote;    // result of the last Adapt
    private int? openAltFor;      // RecipeIngredient.Id whose swap bubble-cloud is open (one at a time)
    private int? generatingAltFor; // RecipeIngredient.Id whose alternates are being generated

    private List<PantryProduct> onHand = [];
    // The same in-stock products WITH their id and whether a FRESH COUNT backs each (vs the rhythm's mere
    // not-overdue guess) — so a have-main knows which product(s) "I'm out" should mark out, and whether its
    // ✓ is confident (counted) or only "likely" (predicted). onHand is derived from this, so one pass.
    private List<(int Id, PantryProduct Product, bool CountBacked)> onHandDetail = [];
    // Every tracked edible product with its curated substitutes — the swap clouds draw stand-ins from
    // the whole matrix, including out-of-stock items (they render as "grab" bubbles).
    private List<PantryProduct> cloudProducts = [];
    // Tracked edible products the engine thinks you've RUN OUT of — the exact items the on-hand list
    // silently drops. Surfaced on red ingredient rows so "why is this red?" answers itself, with a
    // one-tap Restocked to correct the engine when the shelf disagrees.
    private List<(int Id, PantryProduct Product)> outOfStock = [];
    // Edible products the user UNTRACKED — the third way a red row can lie ("I own that!"). Surfaced
    // with a one-tap Track-it; used for the hint only, never for on-hand or the swap clouds.
    private List<(int Id, PantryProduct Product)> untrackedEdible = [];
    private bool restockBusy;
    // Products the user just declared out via "I'm out" this session — so the run-out hint reads "you
    // marked X out" rather than falsely blaming a soft prediction ("it just looks run-out"). Per-circuit,
    // so it resets on a full navigation (a stale OutNow then reads as the ordinary run-out it now is).
    private readonly HashSet<int> justMarkedOut = [];
    // A one-line note after "I'm out" when the OutNow was inert (bought too recently — §6.6), so the tap
    // isn't a silent no-op.
    private string? imOutNote;
    // Per product: would an OutNow filed TODAY be inert (§6.6 same-day tie)? The engine's own
    // SignalTodayWouldBeInert, read (not re-derived) so the "I'm out" note reflects what actually
    // happened to the marked product — NOT whether the row stayed green, which a second same-food
    // product also does while the OutNow really fired.
    private Dictionary<int, bool> signalInertById = [];

    private Recipe? picked;
    private string? extraNote;
    private Recipe? readingRecipe;
    private bool readingHandsFree; // ...with the mic open, listening between steps
    private Recipe? cookingRecipe; // the ElevenLabs realtime agent
    private readonly Random rng = new();

    /// <summary>Deep link from the chat's read_recipe tool (/recipes?read={id}) — auto-starts our own
    /// hands-free reader, so the whole voice chain (including leaving by voice) stays hands-free without
    /// depending on a configured ElevenLabs agent or a per-minute session.</summary>
    [SupplyParameterFromQuery(Name = "read")] public int? ReadId { get; set; }

    /// <summary>Deep link from open_page(page="recipes", product_name) (/recipes?uses={id}) — scopes the
    /// saved list to recipes that use that product, the middle step of the hands-free navigation chain.</summary>
    [SupplyParameterFromQuery(Name = "uses")] public int? UsesProductId { get; set; }

    // The ElevenLabs realtime agent is an ALTERNATIVE now, not the cook-along: it only appears in the
    // caret when the visitor has brought their own agent id (per circuit; empty = the option is hidden).
    // Our own hands-free reader needs no agent, so cook-along itself is always available.
    private bool CookAlongAvailable => !string.IsNullOrEmpty(Voice.AgentId);

    // Adapt a recipe to what's on hand and save it as a variant (on-demand — one AI call per click).
    private async Task AdaptRecipe(Recipe r)
    {
        if (adaptingId is not null) return;
        adaptingId = r.Id;
        adaptNote = null;
        try
        {
            var result = await Adapter.AdaptToOnHandAsync(r.Id);
            adaptNote = result.Message;
            await LoadAsync(); // pull in the new variant
        }
        finally
        {
            adaptingId = null;
        }
    }

    // Open/close an ingredient's swap bubble-cloud. On first open, generate its alternate forms once and
    // cache them on the ingredient (AlternativesJson) so re-opening costs no AI call.
    private async Task ToggleAlternatives(RecipeIngredient i)
    {
        if (openAltFor == i.Id) { openAltFor = null; return; }
        openAltFor = i.Id;
        if (!string.IsNullOrEmpty(i.AlternativesJson)) return;

        generatingAltFor = i.Id;
        try
        {
            var alts = await AltAdvisor.SuggestAsync(i.Name);
            var json = JsonSerializer.Serialize(alts);
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.RecipeIngredients.FindAsync(i.Id) is { } row)
            {
                row.AlternativesJson = json;
                await db.SaveChangesAsync();
            }
            i.AlternativesJson = json; // reflect immediately without a full reload
        }
        finally
        {
            generatingAltFor = null;
        }
    }

    private static List<string> AlternativesOf(RecipeIngredient i) =>
        string.IsNullOrEmpty(i.AlternativesJson) ? [] : JsonSerializer.Deserialize<List<string>>(i.AlternativesJson) ?? [];

    // The cloud shows the user's own stand-in products (their curated "also works as" matrix) first,
    // then the AI-generated generic forms that aren't already represented by one.
    private List<string> CloudFor(RecipeIngredient i) =>
        SwapCloud.Merge(SwapCloud.CuratedStandIns(i.Name, cloudProducts), AlternativesOf(i));

    // Green when an on-hand product covers this alternate form (same matcher the ingredients use).
    private bool HaveForm(string form) => IngredientMatcher.IsSatisfied(form, null, onHand);

    // Picking a bubble adapts the recipe to that specific form for this ingredient, saved as a variant.
    private async Task AdaptToChoice(Recipe r, RecipeIngredient i, string form)
    {
        if (adaptingId is not null) return;
        adaptingId = r.Id;
        adaptNote = null;
        try
        {
            var result = await Adapter.AdaptToOnHandAsync(r.Id, new IngredientSwap(i.Name, form));
            adaptNote = result.Message;
            openAltFor = null;
            await LoadAsync();
        }
        finally
        {
            adaptingId = null;
        }
    }

    // Only one voice surface at a time — starting one closes the other.
    private void StartHandsFree(Recipe r) { cookingRecipe = null; readingHandsFree = true; readingRecipe = r; }
    private void StartReading(Recipe r) { cookingRecipe = null; readingHandsFree = false; readingRecipe = r; }
    private void StopReading() => readingRecipe = null;
    private void StartAgent(Recipe r) { readingRecipe = null; cookingRecipe = r; }
    private void StopCooking() => cookingRecipe = null;

    // The ElevenLabs agent couldn't connect (bad wifi is the classic). Fall back to our own hands-free
    // reader — which since it listens and answers on the same brain, is no longer a downgrade the way
    // falling back to a button-only read used to be. Unconditional now: whoever started the agent, a
    // dead-end error they can't tap away is worse than the reader that does work.
    private void HandleAgentUnavailable()
    {
        if (cookingRecipe is { } r) StartHandsFree(r);
    }

    // A saved recipe is makeable when every MAIN ingredient is covered by something on hand — by food
    // family, not exact product name, so a recipe calling for chicken breast counts when you have chicken
    // tenderloins or any chicken (IngredientMatcher). Seasonings/staples are ignored.
    private bool Makeable(Recipe r) => r.IsMakeableWith(onHand);

    private bool Have(RecipeIngredient i) => i.IsSatisfiedBy(onHand);

    // Pre-save cards run the SAME rule as saved rows: the model's matched_product counts only while
    // that product is actually on hand (a restored week-old snapshot must not replay a stale ✓ for
    // something since run out), and a null match falls back to name/substitute coverage (the model
    // misses spelling gaps a human wouldn't — "lean ground beef" vs "93% Lean Ground Beef").
    private bool HaveSuggested(SuggestedIngredient i) =>
        IngredientMatcher.IsSatisfied(i.Name, i.MatchedProduct, onHand);

    // The first product that would cover this ingredient but is invisible to on-hand — predicted
    // run-out (tracked), or untracked entirely — so a red mark can explain itself. Null = a genuine
    // gap. Run-out is checked first: for a tracked item that's the precise story, and the untracked
    // pool only matters when nothing the engine watches would cover the row.
    private (int Id, string Name, bool Untracked)? MaybeHave(string ingredientName, string? matchedProduct)
    {
        foreach (var (id, product) in outOfStock)
        {
            if (IngredientMatcher.IsSatisfied(ingredientName, matchedProduct, [product]))
                return (id, product.Name, false);
        }
        foreach (var (id, product) in untrackedEdible)
        {
            if (IngredientMatcher.IsSatisfied(ingredientName, matchedProduct, [product]))
                return (id, product.Name, true);
        }
        return null;
    }

    // The in-stock product(s) currently covering this ingredient — the ones its ✓ is ABOUT. Same matcher
    // as the tick (IngredientMatcher.Covering, so they can't disagree), mapped back to the real products by
    // identity so "I'm out" knows what to mark and Confident knows what backs it. A grounded main yields
    // exactly one; a food-family match ("ground beef" → two cuts) can yield several — "I'm out" marks all,
    // since the person said they don't have the ingredient (any it wrongly caught is one Restocked away).
    private List<(int Id, bool CountBacked)> CoveringInStock(string? ingredientName, string? matchedProduct)
    {
        var keys = IngredientMatcher.Covering(ingredientName, matchedProduct, onHand)
            .Select(pp => ProductMatcher.IdentityKey(pp.Name))
            .ToHashSet();
        return onHandDetail
            .Where(x => keys.Contains(ProductMatcher.IdentityKey(x.Product.Name)))
            .Select(x => (x.Id, x.CountBacked))
            .ToList();
    }

    // Same status-only write as the dashboard/grocery-list Restocked (§6 two-stream model: it clears
    // the run-out and re-anchors the due date, never feeds the cadence). Reload flips the row green.
    private async Task Restocked(int productId)
    {
        if (restockBusy) return;
        restockBusy = true;
        imOutNote = null; // a prior "I'm out" note is about a different act — don't leave it stale over this one
        try
        {
            await Store.RecordSignalAsync(productId, SignalKind.Restocked);
            await LoadAsync();
        }
        finally { restockBusy = false; }
    }

    // "The recipe says I have this, but I don't" — the have-side correction, symmetric to Restocked on the
    // grab side. Files an OutNow on the covering in-stock product(s): the honest signal that STICKS (the
    // dashboard and grocery list see it too, and it's undoable via History), not a display-only mark. The
    // reload flips the row to Missing, where the existing "you may still have X" hint offers the reverse.
    private async Task ImOut(RecipeIngredient i)
    {
        if (restockBusy) return;
        restockBusy = true;
        imOutNote = null;
        try
        {
            var covering = CoveringInStock(i.Name, i.MatchedProduct);
            // Was the tap a genuine no-op? ONLY when every product it marks would treat today's OutNow as
            // inert — §6.6's same-day tie — read from the engine's SignalTodayWouldBeInert, captured before
            // the write. NOT inferred from the row staying green: a second same-food product on hand keeps
            // it green while the OutNow really fired (the bug this replaced).
            var wasInert = covering.Count > 0 && covering.All(c => signalInertById.GetValueOrDefault(c.Id));
            foreach (var (id, _) in covering)
            {
                justMarkedOut.Add(id); // so the row's hint reads "you marked X out", not "it just looks run-out"
                await Store.RecordSignalAsync(id, SignalKind.OutNow);
            }
            await LoadAsync();
            if (wasInert)
            {
                // Bought this morning, so the OutNow can't take effect today — nothing visibly changed.
                // Say why, or the tap looks silently ignored.
                imOutNote = $"You bought {i.Name} very recently, so marking it out won't take effect until tomorrow.";
            }
            else if (Have(i))
            {
                // The OutNow DID fire, but the row stays green because a DIFFERENT on-hand product also
                // covers this ingredient (food family). Name it, so a still-checked row after "I'm out"
                // reads as "you have an alternative", not "the tap was ignored".
                var stillId = CoveringInStock(i.Name, i.MatchedProduct).FirstOrDefault().Id;
                imOutNote = productNamesById.GetValueOrDefault(stillId) is { } stillName
                    ? $"Marked out — but you still have {stillName}, which also covers {i.Name} here."
                    : "Marked out.";
            }
            // else: the row went to Missing — its own "you marked X out" hint explains it; no page note.
        }
        finally { restockBusy = false; }
    }

    // One tap to let the engine watch a product again (the same write as the Products-grid checkbox and
    // the set_tracking chat tool). The reload recomputes the row honestly: green if the item's in stock,
    // the run-out hint if its history says it ran dry — exactly what tracking it re-enables.
    private async Task TrackIt(int productId)
    {
        if (restockBusy) return;
        restockBusy = true;
        imOutNote = null; // a prior "I'm out" note is about a different act — don't leave it stale over this one
        try
        {
            await Store.SetTrackingAsync(productId, tracked: true);
            await LoadAsync();
        }
        finally { restockBusy = false; }
    }

    // "2 lbs chicken breast" when the recipe gives a quantity, else just the name. The rule lives once in
    // RecipeFormat.Line so this page, the cookbook, and the printed products list can't phrase it three ways.
    private static string Qty(string? quantity, string name) => RecipeFormat.Line(quantity, name);

    // "Pick for me" pool: saved recipes you've eaten before AND can make right now — the reliable
    // "I can definitely eat this, just tell me" set.
    private List<Recipe> PickPool => savedRecipes.Where(r => r.TimesEaten > 0 && Makeable(r)).ToList();

    private void PickForMe()
    {
        var pool = PickPool;
        picked = pool.Count > 0 ? pool[rng.Next(pool.Count)] : null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await RestoreSuggestionsAsync();
    }

    // Bring back the household's last "Get ideas" batch so the page reopens where it left off.
    // A snapshot that no longer parses (shape changed between builds) is discarded, not fatal.
    private async Task RestoreSuggestionsAsync()
    {
        var json = await Settings.GetAsync(SettingKeys.LastRecipeSuggestions);
        if (string.IsNullOrEmpty(json)) return;
        try
        {
            if (JsonSerializer.Deserialize<SuggestionSnapshot>(json) is { Suggestions.Count: > 0 } snapshot)
            {
                suggestions = snapshot.Suggestions;
                suggestedFor = snapshot.Request;
                suggestedAt = snapshot.GeneratedAt;
            }
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex, "Stored recipe suggestions no longer parse — discarding the snapshot.");
            await Settings.SetAsync(SettingKeys.LastRecipeSuggestions, null);
        }
    }

    // Re-derive the ?uses filter and consume any ?read command whenever the query changes. This runs
    // after OnInitializedAsync has loaded the data AND on every later query-only navigation — the
    // read_recipe deep link usually arrives as the latter: the voice chain is often already ON /recipes
    // ("recipes that use chicken" → "read the second one"), and a same-component navigation never
    // re-runs OnInitializedAsync, which is where this handling used to live (the auto-start silently
    // never fired).
    protected override void OnParametersSet()
    {
        ApplyFilter();
        ConsumeReadDeepLink();
    }

    /// <summary>Deep link from the chat's read_recipe tool (/recipes?read={id}) — auto-starts a hands-free
    /// read: the listening cook-along agent when it's configured (voice "next"/"back"/"stop"/"go to the
    /// assistant", so the whole chain stays hands-free), else the button-controlled read-aloud (also the
    /// later fallback if cook-along can't connect — HandleCookUnavailable). ?read is a one-shot command,
    /// not view state, so it's stripped from the URL once consumed: a repeat of the same request still
    /// changes the query (null → id), and a refresh doesn't surprise-relaunch a mic session. Interactive
    /// only — during prerender there's no circuit to run a voice surface on, and navigating would turn
    /// into a redirect that eats the parameter before the interactive run could see it.</summary>
    private void ConsumeReadDeepLink()
    {
        if (!RendererInfo.IsInteractive || ReadId is not { } id) return;
        if (savedRecipes.FirstOrDefault(r => r.Id == id) is { Steps.Count: > 0 } target)
        {
            StartHandsFree(target);
        }
        Nav.NavigateTo(UsesProductId is { } u ? $"/recipes?uses={u}" : "/recipes", replace: true);
    }

    private void ApplyFilter()
    {
        filterProductName = UsesProductId is { } pid && productNamesById.TryGetValue(pid, out var n) ? n : null;
        var topLevel = savedRecipes.Where(r => !r.IsVariant);

        if (filterProductName is not { } name)
        {
            // No filter: every original followed by all its adapted variants (most recent first).
            displayed = topLevel.ToList();
            renderList = displayed
                .SelectMany(p => new[] { (p, RowKind.Original) }
                    .Concat(VariantsOf(p).Select(v => (v, RowKind.Variant))))
                .ToList();
            PublishScreenContext();
            return;
        }

        // Filtered to a product: a recipe "uses" it when an ingredient is grounded to that product. Match
        // each ADAPTED VARIANT on its OWN ingredients — Adapt swaps the main, so a variant usually uses a
        // product its original never did. Only recipes that actually use the product are results; a
        // non-matching original rides along solely as a muted reference so its matching variant isn't
        // orphaned.
        bool Uses(Recipe r) => r.Uses(name); // one definition of "recipe uses X", shared with the cookbook

        var rows = new List<(Recipe Recipe, RowKind Kind)>();
        var results = new List<Recipe>();
        foreach (var p in topLevel)
        {
            var matchingVariants = VariantsOf(p).Where(Uses).ToList();
            if (Uses(p))
            {
                rows.Add((p, RowKind.Original));
                results.Add(p);
            }
            else if (matchingVariants.Count > 0)
            {
                rows.Add((p, RowKind.ParentReference)); // context only — this original doesn't use the product
            }
            else
            {
                continue; // neither the original nor any variant uses the product
            }
            foreach (var v in matchingVariants)
            {
                rows.Add((v, RowKind.Variant));
                results.Add(v);
            }
        }
        displayed = results;
        renderList = rows;
        PublishScreenContext();
    }

    // A recipe's adapted variants, most recent first.
    private IEnumerable<Recipe> VariantsOf(Recipe original) =>
        savedRecipes.Where(v => v.IsVariantOf(original)).OrderByDescending(v => v.SavedAt);

    // Tell the roaming voice agent what's on screen and in what order, so "read me the second one"
    // resolves to the right recipe. Cleared on navigate-away so it can't leak to another page.
    private void PublishScreenContext()
    {
        // Reference-only rows are context, not results — keep them out of the positional list the voice
        // agent uses for "read me the second one".
        var listed = renderList.Where(x => x.Kind != RowKind.ParentReference).Select(x => x.Recipe).ToList();
        Coordinator.ScreenContext = listed.Count == 0
            ? null
            : (filterProductName is { } fn ? $"The user is viewing recipes that use {fn}. " : "The user is viewing the Recipes page. ")
              + "Recipes listed, in display order:\n"
              + string.Join("\n", listed.Select((r, i) => $"{i + 1}. {r.Name}"));
    }

    public void Dispose() => Coordinator.ScreenContext = null;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        excludedFoods = await db.ExcludedFoods.OrderBy(f => f.Value).ToListAsync();
        // SQLite can't ORDER BY a DateTimeOffset column — sort client-side.
        savedRecipes = (await db.Recipes.AsNoTracking().Include(r => r.Ingredients).Include(r => r.Steps).ToListAsync())
            .OrderByDescending(r => r.SavedAt).ToList();
        savedNames = savedRecipes.Select(r => r.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        // Id → name for the ?uses filter (all products, tracked or not — a recipe may point at an
        // item that's since been untracked).
        productNamesById = await db.Products.Select(p => new { p.Id, p.Name }).ToDictionaryAsync(x => x.Id, x => x.Name);

        // "Likely on hand" = tracked, EDIBLE products the engine doesn't think you've run out of. Edible
        // only so a family match ("chicken") can't be satisfied by "Chicken Jerky Dog Treats" or a
        // chicken-scented cleaner — recipes only reason over food. Untracked products load too, but ONLY
        // to power the "you have this, but it's untracked" hint — every other pool filters them out.
        var products = await db.Products.AsNoTracking()
            .Include(p => p.Purchases).Include(p => p.Signals).Include(p => p.Substitutes).ToListAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var trackExpirations = await Settings.GetTrackExpirationDatesAsync();
        // Whether an OutNow filed today would be inert, per product — asked of the engine so the "I'm out"
        // note tells the truth about the signal, not about the row's colour. (Flag-independent: it's
        // lastStockBack >= today; the flags just match the on-hand pass beside it.)
        signalInertById = products.ToDictionary(p => p.Id,
            p => ReplenishmentPredictor.Predict(p, today, trackExpirations, honorQuantity: true).SignalTodayWouldBeInert);
        onHandDetail = PantryOnHand.EdibleInStockDetailed(products, today, trackExpirations)
            .Select(d => (d.Product.Id, Product: new PantryProduct(d.Product.Name, d.Product.Substitutes.Select(s => s.Value).ToList()), d.CountBacked))
            .OrderBy(x => x.Product.Name)
            .ToList();
        onHand = onHandDetail.Select(x => x.Product).ToList(); // same in-stock set, for the matcher
        cloudProducts = products
            .Where(p => p.IsTracked && p.Category.IsEdible())
            .Select(p => new PantryProduct(p.Name, p.Substitutes.Select(s => s.Value).ToList()))
            .OrderBy(x => x.Name)
            .ToList();
        outOfStock = PantryOnHand.EdibleOutOfStock(products, today, trackExpirations)
            .Select(p => (p.Id, Product: new PantryProduct(p.Name, p.Substitutes.Select(s => s.Value).ToList())))
            .OrderBy(x => x.Product.Name)
            .ToList();
        untrackedEdible = PantryOnHand.EdibleUntracked(products)
            .Select(p => (p.Id, Product: new PantryProduct(p.Name, p.Substitutes.Select(s => s.Value).ToList())))
            .OrderBy(x => x.Product.Name)
            .ToList();

        ApplyFilter(); // keep the ?uses view in sync after any reload
    }

    private async Task AddExcluded()
    {
        var value = newExcluded.Trim();
        if (value.Length == 0) return;
        if (!excludedFoods.Any(f => string.Equals(f.Value, value, StringComparison.OrdinalIgnoreCase)))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.ExcludedFoods.Add(new ExcludedFood { Value = value });
            // Undoable: the entry matches the food by value, so it needs no generated id — staged on this
            // same save, so the exclusion and its undo record commit together.
            ActivityLog.Record(db, ActivityKind.ExcludedFoodChanged, new ExcludedFoodChangedPayload(WasAdded: true, value));
            await db.SaveChangesAsync();
            await ActivityLog.TrimAsync();
        }
        newExcluded = "";
        await LoadAsync();
    }

    private async Task RemoveExcluded(ExcludedFood f)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // See the note in DeleteSaved: no fallback to the detached entity.
        if (await db.ExcludedFoods.FindAsync(f.Id) is { } row)
        {
            db.ExcludedFoods.Remove(row);
            ActivityLog.Record(db, ActivityKind.ExcludedFoodChanged, new ExcludedFoodChangedPayload(WasAdded: false, row.Value));
            await db.SaveChangesAsync();
            await ActivityLog.TrimAsync();
        }
        await LoadAsync();
    }

    private async Task Suggest()
    {
        if (suggesting || string.IsNullOrWhiteSpace(request)) return;
        suggesting = true;
        suggestError = null;
        try
        {
            // onHand grounds the suggestions in real catalog items. The card's have/grab marks trust the
            // model's matched_product only when POSITIVE; a null falls back to the plain-code matcher
            // (HaveSuggested), so the pre-save card always agrees with what saving would show.
            // The previous batch stays on screen (and in storage) until this one actually succeeds.
            var fresh = (await Advisor.SuggestAsync(request, onHand.Select(p => p.Name).ToList(), excludedFoods.Select(f => f.Value).ToList())).ToList();
            if (fresh.Count == 0)
            {
                suggestError = "No ideas came back — try rephrasing.";
            }
            else
            {
                suggestions = fresh;
                suggestedFor = request;
                suggestedAt = DateTimeOffset.Now;
                await Settings.SetAsync(SettingKeys.LastRecipeSuggestions,
                    JsonSerializer.Serialize(new SuggestionSnapshot(suggestedFor, suggestedAt, suggestions)));
            }
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Recipe suggestion failed for request \"{Request}\".", request);
            suggestError = "Couldn't get ideas just now — please try again.";
        }
        finally
        {
            suggesting = false;
        }
    }

    private async Task ClearSuggestions()
    {
        suggestions = [];
        suggestedFor = "";
        await Settings.SetAsync(SettingKeys.LastRecipeSuggestions, null);
    }

    private async Task Save(RecipeSuggestion s)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var recipe = new Recipe
        {
            Name = s.Name,
            Blurb = s.Blurb,
            SavedAt = DateTimeOffset.Now,
            Ingredients = s.Ingredients.Select(i => new RecipeIngredient { Name = i.Name, IsMain = i.IsMain, MatchedProduct = i.MatchedProduct, Quantity = i.Quantity }).ToList(),
            Steps = s.Steps.Select((t, idx) => new RecipeStep { Order = idx + 1, Text = t }).ToList(),
            EstimatedCaloriesPerServing = s.CaloriesPerServing,
        };
        db.Recipes.Add(recipe);
        // Undoable: the entry keys on the recipe's generated id (so undo can delete it), so the recipe
        // saves inside a transaction to assign it, then the entry is staged and saved — one commit (like a
        // create in EfPantryStore).
        await using var tx = await db.Database.BeginTransactionAsync();
        await db.SaveChangesAsync(); // assigns recipe.Id
        ActivityLog.Record(db, ActivityKind.RecipeSaved, new RecipeSavedPayload(recipe.Id, s.Name));
        await db.SaveChangesAsync();
        await tx.CommitAsync();
        await ActivityLog.TrimAsync();
        await LoadAsync();
    }

    /// <summary>What the last "Ate it" did — the meal event's id, the ACTUAL takes (auto + picked), the
    /// picker's open questions, and what the human declined to answer — kept so the notice can say it
    /// and <see cref="UndoEat"/> can reverse all of it. One at a time: a new tap replaces it, because
    /// the restore is only exact against the takes it stored. Mutable on purpose: picks move entries
    /// from <see cref="ToPick"/> into <see cref="Taken"/> as they land.</summary>
    private sealed class EatDone
    {
        public required int RecipeId { get; init; }
        public required string RecipeName { get; init; }
        public required int MealEventId { get; init; }
        /// <summary>The MealLogged activity entry recorded with this meal — both the inline "↩ Undo" and
        /// the /history undo reverse THROUGH it (one reversal path), and a picker answer restates its
        /// payload so the durable record keeps matching <see cref="Taken"/>.</summary>
        public required int ActivityEntryId { get; init; }
        public List<MealStock.Applied> Taken { get; } = [];
        public List<MealStock.Ambiguity> ToPick { get; } = [];
        public List<MealStock.Ambiguity> Skipped { get; } = [];
    }

    private EatDone? lastEat;
    private bool eatBusy;
    /// <summary>Keyed by recipe: the saved list renders every recipe, so an unkeyed message would
    /// appear under all of them.</summary>
    private (int RecipeId, string Message)? eatError;

    /// <summary>"Ate it" — §13.3's tell-don't-ask. One tap commits everything (the counter, the dated
    /// MealEvent, one package off each counted main), and the notice then says exactly what happened
    /// with Undo at hand. The decrement is approximate by design (recipe quantities are free-form
    /// strings the app must not parse), so it must never be silent — but asking first on every cook of
    /// the same stew is friction that gets blown through unread, which protects nothing.</summary>
    private async Task MarkEaten(Recipe r)
    {
        if (eatBusy) return;
        eatBusy = true;
        eatError = null; // a fresh tap must not sit under the last attempt's message
        // Whether SaveChanges completed, so the catch can tell a failed WRITE from a failed RELOAD.
        // Conflating them is not cosmetic: "didn't save — try again" after a successful save invites a
        // second tap, and this tap is NOT idempotent (a second MealEvent, a second package off).
        var saved = false;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var rec = await db.Recipes.FindAsync(r.Id);
            if (rec is null)
            {
                eatError = (r.Id, "That recipe isn't here any more — nothing was recorded.");
                return;
            }

            var resolution = await MealStock.ResolveAsync(db, r);
            rec.TimesEaten++;
            // The counter answers "how reliable is this recipe" (Pick for me); the event answers "when did
            // we eat it" (the Reports tab's meals/calories charts). Same tap writes both.
            var meal = new MealEvent { RecipeId = rec.Id, AteAt = DateOnly.FromDateTime(DateTime.Today) };
            db.MealEvents.Add(meal);
            var taken = MealStock.Apply(resolution); // same save as the MealEvent — one tap, one transaction

            // The meal AND its undo record commit together (like a create in EfPantryStore): the entry keys
            // on the meal's generated id, so the meal saves inside the transaction to assign it, then the
            // entry is staged and saved. The transaction is scoped to close BEFORE LoadAsync opens its own
            // context on this shared connection.
            ActivityEntry entry;
            await using (var tx = await db.Database.BeginTransactionAsync())
            {
                await db.SaveChangesAsync(); // assigns meal.Id + the counter/take on the same commit
                entry = ActivityLog.Record(db, ActivityKind.MealLogged,
                    new MealLoggedPayload(meal.Id, r.Name, taken.ToList()));
                await db.SaveChangesAsync();
                await tx.CommitAsync();
            }
            saved = true;
            var done = new EatDone
            {
                RecipeId = r.Id, RecipeName = r.Name, MealEventId = meal.Id, ActivityEntryId = entry.Id,
            };
            done.Taken.AddRange(taken);
            done.ToPick.AddRange(resolution.Ambiguous); // the picker asks these; click-away skips them
            lastEat = done;
            await LoadAsync();
            await ActivityLog.TrimAsync(); // retention: decoupled, best-effort, after the commit
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Recording a meal for recipe {RecipeId} failed (saved: {Saved}).", r.Id, saved);
            eatError = saved
                ? (r.Id, "Recorded — but the page couldn't refresh. Reload to see it; don't tap again.")
                : (r.Id, "That didn't save. Try again, or reload the page.");
        }
        finally { eatBusy = false; }
    }

    /// <summary>Reverse the last "Ate it" through the ONE undo path — <see cref="ActivityLogService"/> —
    /// exactly as the /history page does: the meal event goes, the counter steps back, the ACTUAL taken
    /// amounts (auto + any picked) return, and the entry is stamped undone so /history shows it reversed.
    /// The reversal itself is <see cref="MealStock.ReverseMealOnAsync"/> (via the handler), so the inline
    /// and history surfaces can never disagree about what undoing a meal does. Restoring commutes with
    /// anything that moved the counts in between; a product whose counting stopped meanwhile stays dormant
    /// — the ledger's own gate.</summary>
    private async Task UndoEat()
    {
        if (lastEat is not { } done || eatBusy) return;
        eatBusy = true;
        eatError = null;
        var undone = false;
        try
        {
            var outcome = await ActivityLog.UndoAsync(done.ActivityEntryId);
            if (outcome != UndoOutcome.Done)
            {
                // Gone/Superseded/AlreadyUndone — another surface already reversed it (an /history undo,
                // another device). Nothing coherent left to undo here.
                lastEat = null;
                eatError = (done.RecipeId, "That meal is no longer on record — nothing to undo.");
                return;
            }
            undone = true; // the reversal is committed; only the reload can fail past here
            lastEat = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Undoing the last meal for recipe {RecipeId} failed (undone: {Undone}).", done.RecipeId, undone);
            eatError = undone
                ? (done.RecipeId, "Undone — but the page couldn't refresh. Reload to see it.")
                : (done.RecipeId, "The undo didn't save. Try again, or reload the page.");
        }
        finally { eatBusy = false; }
    }

    private void DismissEat()
    {
        // Same gate as ClosePicker: dismissing mid-pick would null the state a completing pick is
        // about to record into, leaving a saved decrement with no notice and no Undo.
        if (eatBusy) return;
        lastEat = null;
        eatError = null;
    }

    /// <summary>The human pointed at what came off the shelf (§13.3's picker). The decrement is the
    /// same take "Ate it" makes — <see cref="MealStock.TakeOne"/>: ledger clamp, no signal, clock
    /// untouched — recorded into <see cref="EatDone.Taken"/> so the notice shows it and Undo reverses
    /// it with everything else.</summary>
    private async Task PickCandidate(MealStock.Ambiguity question, MealStock.Candidate candidate)
    {
        if (lastEat is not { } done || eatBusy) return;
        eatBusy = true;
        eatError = null;
        var saved = false;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // The meal itself may have been undone on another surface since the picker opened (an /history
            // undo, another tab) — its MealEvent removed and its auto-takes already restored. Taking a
            // package now would strand a decrement for a meal no longer on record, un-undoable (the notice's
            // Undo would then report AlreadyUndone). Undo removes the event and stamps the entry in ONE
            // transaction, so a missing event is the reliable "this was reversed" signal.
            if (await db.MealEvents.FindAsync(done.MealEventId) is null)
            {
                lastEat = null;
                eatError = (done.RecipeId, "That meal was undone elsewhere — nothing was taken.");
                return;
            }
            var product = await db.Products.Include(p => p.Purchases)
                .FirstOrDefaultAsync(p => p.Id == candidate.ProductId);
            var taken = product is null ? null : MealStock.TakeOne(product);
            if (taken is not null)
            {
                // Restate the meal's undo record so it keeps matching what was actually taken: a /history
                // (or inline) undo after this pick must restore the pick too, not just the auto-takes. The
                // count take and the payload restate commit in ONE save. Built from a prospective list so
                // done.Taken is mutated only after the DB commits (a failed save must leave page state
                // untouched — the split failure advice below relies on it).
                var updated = new List<MealStock.Applied>(done.Taken) { taken };
                if (await db.ActivityEntries.FindAsync(done.ActivityEntryId) is { } entry)
                    ActivityLog.Restate(entry, new MealLoggedPayload(done.MealEventId, done.RecipeName, updated));
                await db.SaveChangesAsync();
                saved = true;
                done.Taken.Add(taken);
                done.ToPick.Remove(question);
            }
            else
            {
                // The shelf moved between the ask and the answer (emptied, counting stopped, product
                // deleted) — nothing was written, so `saved` stays false. The question is spent but
                // must not VANISH: it lands in Skipped so the notice still says the ingredient went
                // uncounted (§13.3's no-silent-refusal rule holds even for a pick that found nothing).
                done.ToPick.Remove(question);
                done.Skipped.Add(question);
            }
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Applying a picked decrement for product {ProductId} failed (saved: {Saved}).",
                candidate.ProductId, saved);
            eatError = saved
                ? (done.RecipeId, "Recorded — but the page couldn't refresh. Reload to see it; don't pick again.")
                : (done.RecipeId, "That didn't save. Try again, or reload the page.");
        }
        finally { eatBusy = false; }
    }

    /// <summary>Click-away (§13.3): the human didn't say which product came off the shelf, so no count
    /// moves — the open questions land in the notice as "left uncounted" rather than vanishing.
    /// <para>Gated on <c>eatBusy</c>, as is <see cref="DismissEat"/>: a pick's awaits yield the
    /// dispatcher, so an ungated backdrop click could file a question as skipped while the pick for
    /// that same question was completing — the notice would then claim both "taken" and "left
    /// uncounted" about one ingredient.</para></summary>
    private void ClosePicker()
    {
        if (eatBusy || lastEat is not { } done || done.ToPick.Count == 0) return;
        done.Skipped.AddRange(done.ToPick);
        done.ToPick.Clear();
    }

    // Send the main ingredients you don't currently have to the grocery list's manual "extras" section.
    private async Task AddMissingToList(Recipe r)
    {
        var missing = r.MissingMains(onHand).Select(i => i.Name).ToList();
        if (missing.Count == 0) { extraNote = "You already have everything for this."; return; }

        // Through the store's ONE add-extras path: it skips ones already on the list (no re-implemented
        // "skip existing" here) and logs a GroceryExtrasAdded. The count back is what was actually added.
        var added = (await Store.AddGroceryExtrasAsync(missing)).Count;
        extraNote = added > 0
            ? $"Added {added} item{(added == 1 ? "" : "s")} to your grocery list."
            : "Those are already on your grocery list.";
    }

    private async Task DeleteSaved(Recipe r)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // No fallback to the detached `r`: the lookup is household-filtered, so a miss means the recipe is
        // already gone (a double tap) or isn't ours — and removing `r` anyway would delete it keyed on the
        // id alone, with no household predicate. Nothing to delete is a no-op, not an error.
        if (await db.Recipes.FindAsync(r.Id) is { } row)
        {
            db.Recipes.Remove(row);
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }
}
