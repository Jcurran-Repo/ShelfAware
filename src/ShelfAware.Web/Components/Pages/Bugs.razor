@page "/bugs"
@using Microsoft.Extensions.Options
@using ShelfAware.Web.Auth
@using ShelfAware.Web.Components.Layout
@inject IHouseholdDbFactory DbFactory
@inject IOptions<AdminOptions> Admin
@inject ReporterReportService Reporter
@inject ILogger<Bugs> Logger

<PageTitle>Report a bug — Shelf Aware</PageTitle>

<div class="page-head">
    <h1>Report a bug</h1>
</div>

@if (!Admin.Value.Configured)
{
    @* No admin configured = nobody reads reports, so inviting one would be dishonest. The past
       list still renders below — history the household already filed stays theirs to see. *@
    <p class="muted">This deployment doesn't have an admin set up to read bug reports, so there's
        nowhere for a new one to go. (If you run this server: set <code>Admin:Emails</code> in
        configuration to turn this on.)</p>
}
else
{
    <section class="panel">
        <h2>Something looks wrong?</h2>
        <p class="muted">Your report goes to this deployment's admin, along with your household
            name and sign-in email so they can follow up. Nothing else is attached.</p>
        <form class="stacked" @onsubmit="SubmitAsync" @formname="bug-report">
            <label class="field">
                <span>What happened</span>
                <textarea @bind="body" @bind:event="oninput" maxlength="4000" rows="5"
                          aria-label="Describe what looked wrong" disabled="@busy"></textarea>
            </label>
            <label class="field">
                <span>Where (which page)</span>
                @* Built from SiteNav — the SAME list the header nav renders, so the choices can't
                   drift from the app's real pages and nobody has to type "/list" by hand. The
                   escape hatch keeps the old free text for anywhere more specific. *@
                <select @bind="wherePage" disabled="@busy" aria-label="Which page it happened on">
                    <option value="">—</option>
                    @* `entry`, not `page`: Razor reads inline `@page.` as the @page directive. *@
                    @foreach (var entry in SiteNav.Pages)
                    {
                        <option value="@entry.Href">@entry.Label</option>
                    }
                    <option value="@Elsewhere">Somewhere else…</option>
                </select>
            </label>
            @if (wherePage == Elsewhere)
            {
                <label class="field">
                    <span>Where exactly</span>
                    <input @bind="where" maxlength="300" aria-label="Where it happened" disabled="@busy" />
                </label>
            }
            <button type="submit" disabled="@busy">@(busy ? "Sending…" : "Send report")</button>
        </form>
        <div role="status" aria-live="polite">
            @if (note is not null)
            {
                <p class="chat-reply">@note</p>
            }
        </div>
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
    </section>
}

<section class="panel">
    <h2>Your household's reports</h2>
    @* A persistent announcer, mounted before any action, so a resolve/reopen is announced to a screen
       reader even though the row it changed re-renders in place (the item 47/49 pattern). *@
    <div role="status" aria-live="polite">
        @if (actionMsg is not null)
        {
            <p class="@(actionOk ? "muted small" : "error")">@actionMsg</p>
        }
    </div>
    @if (loadError is not null)
    {
        <p class="error" role="alert">@loadError</p>
    }
    else if (reports is null)
    {
        <p>Loading…</p>
    }
    else if (reports.Count == 0)
    {
        <p class="muted">None yet.</p>
    }
    else
    {
        <table>
            <caption class="visually-hidden">Bug reports this household has filed</caption>
            <thead>
                <tr><th>When</th><th>Who</th><th>Where</th><th>What</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in reports)
                {
                    <tr>
                        <td>@r.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>@(r.ReportedBy ?? "—")</td>
                        <td class="muted">@(r.PageUrl ?? "—")</td>
                        <td>@r.Body</td>
                        <td>
                            @* The loop closed: you see (and now DECIDE) the outcome of a report you
                               filed. Resolving/reopening your own report is a household-SCOPED write —
                               you can only ever touch your own household's, by the query filter. *@
                            @if (r.Resolved)
                            {
                                @* ✓, the app's one affirmative glyph (Receipts/Recipes use it) —
                                   and the year, because the When cell beside it carries one. *@
                                <span class="chip chip-stocked" title="Marked handled">✓ resolved @r.ResolvedAt?.ToString("MMM d, yyyy")</span>
                                <button class="secondary" @onclick="() => ReopenAsync(r.Id)" disabled="@(acting || busy)"
                                        aria-label="Reopen your report: @r.Body">Reopen</button>
                            }
                            else if (r.AwaitingReporter)
                            {
                                <span class="chip chip-duesoon" title="The admin thinks this is fixed — is it?">proposed fixed</span>
                                <button class="secondary" @onclick="() => ResolveAsync(r.Id)" disabled="@(acting || busy)"
                                        aria-label="Confirm the fix for your report: @r.Body">Confirm fixed</button>
                                <button class="secondary" @onclick="() => ReopenAsync(r.Id)" disabled="@(acting || busy)"
                                        aria-label="Say your report is still broken: @r.Body">Still broken</button>
                            }
                            else
                            {
                                <span class="muted">open</span>
                                <button class="secondary" @onclick="() => ResolveAsync(r.Id)" disabled="@(acting || busy)"
                                        aria-label="Mark your report fixed: @r.Body">Mark fixed</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Where the reporter came from — the footer link carries the current page so the
    /// form can pre-fill it. Visible and editable; never captured silently.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    /// <summary>The "Somewhere else…" sentinel — leads with a character no app path can, so it can
    /// never collide with a SiteNav href.</summary>
    private const string Elsewhere = "~elsewhere";

    private List<BugReport>? reports;
    private string body = "";
    private string wherePage = "";
    private string where = "";
    private string? note;
    private string? error;
    private string? loadError;
    private bool busy;
    private bool acting;      // a resolve/reopen is in flight (guards double-taps, disables the row buttons)
    private string? actionMsg;
    private bool actionOk;

    protected override async Task OnInitializedAsync()
    {
        // Only a relative app path is accepted as a pre-fill — anything else in the query string
        // (a full URL, junk) is ignored rather than rendered into the form. "//host" is a
        // protocol-relative URL and "/\" its backslash twin, so neither counts as app-relative.
        if (From is ['/', ..] && From is not ['/', '/', ..] && From is not ['/', '\\', ..])
        {
            // A page the menu knows preselects itself; anything more specific (a product page,
            // say) keeps its EXACT path in the free-text box — the admin wants /product/12, not
            // "Products", and the footer link's specificity must survive the dropdown.
            if (SiteNav.Pages.FirstOrDefault(p => p.Href == From) is { } known)
            {
                wherePage = known.Href;
            }
            else
            {
                wherePage = Elsewhere;
                where = From;
            }
        }
        await LoadAsync();
    }

    /// <summary>Self-catching (returns whether it worked), so a transient DB failure lands as a
    /// friendly message beside the list — on the page people visit precisely when something is
    /// broken — and never as a circuit teardown or as false "couldn't save" advice from a caller.</summary>
    private async Task<bool> LoadAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            reports = await db.BugReports.AsNoTracking()
                .OrderByDescending(r => r.Id) // insert order IS chronological; SQLite can't ORDER BY DateTimeOffset
                .ToListAsync();
            loadError = null;
            return true;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the household's bug reports failed.");
            loadError = "Couldn't load your reports just now — reload the page to try again.";
            return false;
        }
    }

    private async Task SubmitAsync()
    {
        if (busy) return;
        if (string.IsNullOrWhiteSpace(body))
        {
            error = "Say what looked wrong first — even one sentence helps.";
            note = null;
            return;
        }
        busy = true;
        error = null;
        note = null;
        try
        {
            var user = AuthState is null ? null : (await AuthState).User;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                db.BugReports.Add(new BugReport
                {
                    // Server-side truncation mirroring the form's maxlength: the attribute is
                    // browser-enforced only, and a stripped attribute must not become an
                    // unbounded row (the machine half truncates too — 2000/6000).
                    Body = Clamp(body.Trim(), 4000),
                    // A picked page stores its path (the same string the footer's from= carries);
                    // only the escape hatch consults the free-text box.
                    PageUrl = wherePage switch
                    {
                        "" => null,
                        Elsewhere => string.IsNullOrWhiteSpace(where) ? null : Clamp(where.Trim(), 300),
                        // Allowlisted against the SAME list that rendered the options: a select's
                        // @bind takes whatever string arrives over the circuit — it does NOT
                        // re-validate against the option set — so a tampered value could otherwise
                        // skip the clamp above and land verbatim on the admin's screen.
                        _ => SiteNav.Pages.Any(p => p.Href == wherePage) ? wherePage : null,
                    },
                    ReportedBy = user?.Identity?.Name,
                    CreatedAt = DateTimeOffset.Now,
                });
                await db.SaveChangesAsync();
            }
            body = "";
            // The where selection resets WITH the body: a retained dropdown pick reads as a
            // deliberate default, and a second, unrelated report typed into the fresh-looking
            // form was silently filed against the previous report's page.
            wherePage = "";
            where = "";
            // The save is DONE — a reload failure past this point must not read as one (the
            // opposite-advice rule: inviting a retry of a recorded report files it twice).
            note = await LoadAsync()
                ? "Sent — thank you. Your report is listed below."
                : "Sent — thank you. (The list below couldn't refresh just now.)";
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Filing a bug report failed.");
            error = "Couldn't save the report just now — please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private Task ResolveAsync(int id) => ActAsync(() => Reporter.ResolveOwnAsync(id), "Marked fixed — thanks for confirming.");
    private Task ReopenAsync(int id) => ActAsync(() => Reporter.ReopenOwnAsync(id), "Reopened — the admin will see it's open again.");

    /// <summary>Resolve/reopen the reporter's OWN report, then refresh. Advice splits by failure point
    /// (item 27): a failed WRITE says nothing changed (safe — the write is idempotent); a failed refresh
    /// AFTER a successful write says "saved, reload to see it" — the list must never show a stale state
    /// beside advice inviting a retry of a write that already landed. The write is household-scoped
    /// (ReporterReportService), so it can only ever touch this household's own report.</summary>
    private async Task ActAsync(Func<Task<bool>> write, string done)
    {
        if (acting || busy) return;
        acting = true;
        actionMsg = null;
        try
        {
            var ok = await write();
            var refreshed = await LoadAsync();
            // Only a clean write-and-refresh reads as success (muted); a refresh failure after a
            // successful write is surfaced as an alert so the "Reload to see it" instruction lands,
            // matching Admin.razor's treatment of the same partial-success.
            actionOk = ok && refreshed;
            actionMsg = !ok ? "That report isn't there any more."
                : !refreshed ? "Saved — but the list couldn't refresh just now. Reload to see it."
                : done;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resolving or reopening the household's own bug report failed.");
            actionOk = false;
            actionMsg = "Couldn't update that just now — please try again.";
        }
        finally { acting = false; }
    }

    private static string Clamp(string s, int max) => s.Length > max ? s[..max] : s;
}
