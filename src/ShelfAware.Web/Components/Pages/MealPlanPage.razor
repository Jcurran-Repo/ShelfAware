@page "/meal-plan"
@implements IDisposable
@using ShelfAware.Core.Domain
@using ShelfAware.Core.MealPlanning
@using ShelfAware.Core.Recipes
@using ShelfAware.Web.Data
@inject MealPlanService Planner
@inject IMealPlanJobs Jobs
@inject ICurrentHousehold Household
@inject ILogger<MealPlanPage> Logger

<PageTitle>Meal Plan — Shelf Aware</PageTitle>

<div class="page-head">
    <h1>Meal Plan</h1>
</div>

<p class="recipe-disclaimer" role="note">
    ⚠️ Ideas only — <strong>always check ingredient labels yourself</strong>. Calorie figures are rough AI
    estimates for planning, not precise nutrition.
</p>

<section class="panel">
    <h2>Set up your plan</h2>
    <p class="muted">Everything's optional — leave it as-is for varied, home-cooked dinners built from your
        pantry. Generating replaces your current plan.</p>

    <div class="mealplan-setup">
        <label class="field">
            <span>Days</span>
            <input type="number" min="1" max="31" @bind="days" aria-label="How many days to plan" />
        </label>
        <fieldset class="mealplan-slots">
            <legend>Meals each day</legend>
            <label class="checkbox-field"><input type="checkbox" @bind="breakfast" /> Breakfast</label>
            <label class="checkbox-field"><input type="checkbox" @bind="lunch" /> Lunch</label>
            <label class="checkbox-field"><input type="checkbox" @bind="dinner" /> Dinner</label>
            <label class="checkbox-field"><input type="checkbox" @bind="snack" /> Snack</label>
        </fieldset>
        <label class="field">
            <span>Calories per meal</span>
            <input type="number" min="0" @bind="calories" placeholder="no target" aria-label="Calorie target per meal (optional)" />
        </label>
        <label class="field">
            <span>Protein / day (g)</span>
            <input type="number" min="0" @bind="protein" placeholder="no target" aria-label="Daily protein target in grams (optional)" />
        </label>
        <label class="field">
            <span>Carbs / day (g)</span>
            <input type="number" min="0" @bind="carbs" placeholder="no target" aria-label="Daily carb target in grams (optional)" />
        </label>
        <label class="field mealplan-foodgroups">
            <span>Food groups to balance</span>
            <input type="text" @bind="foodGroupsText" placeholder="e.g. vegetables, whole grains, lean protein"
                   aria-label="Food groups to cover, comma-separated (optional)" />
        </label>
        <label class="field">
            <span>Time &amp; effort</span>
            <select @bind="effort" aria-label="How ambitious the meals should be">
                <option value="@TimeEffort.Quick">Quick &amp; simple</option>
                <option value="@TimeEffort.Standard">Standard</option>
                <option value="@TimeEffort.Ambitious">Ambitious</option>
            </select>
        </label>
        <fieldset class="mealplan-slots">
            <legend>Appliances <span class="muted">(beyond oven &amp; stovetop)</span></legend>
            <label class="checkbox-field"><input type="checkbox" @bind="slowCooker" /> Slow cooker</label>
            <label class="checkbox-field"><input type="checkbox" @bind="airFryer" /> Air fryer</label>
            <label class="checkbox-field"><input type="checkbox" @bind="grill" /> Grill</label>
            <label class="checkbox-field"><input type="checkbox" @bind="pressureCooker" /> Pressure cooker</label>
            <label class="checkbox-field"><input type="checkbox" @bind="blender" /> Blender</label>
            <label class="checkbox-field"><input type="checkbox" @bind="smoker" /> Smoker</label>
        </fieldset>
        <label class="checkbox-field mealplan-invent">
            <input type="checkbox" @bind="invent" />
            <span>Invent new meals <span class="muted">(otherwise: known dishes from what you buy)</span></span>
        </label>
    </div>

    <button @onclick="Generate" disabled="@generating">
        @(generating
            ? (progressTotal > 0 ? $"Planning… ({progressDone} of {progressTotal})" : "Planning…")
            : plan is null ? "Generate my plan" : "Regenerate")
    </button>
    @if (generating)
    {
        <p class="muted small" role="status">
            Generating your plan — this can take a minute or two. Feel free to leave this page; it keeps
            going and will be here when you come back.
        </p>
    }
    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    @if (note is not null)
    {
        <p class="chat-reply" role="status">@note</p>
    }
</section>

@if (plan is { } p)
{
    <section class="panel">
        <div class="page-head">
            <h2>Your plan <span class="muted">— @p.Meals.Count meal@(p.Meals.Count == 1 ? "" : "s")</span></h2>
        </div>
        @foreach (var day in p.Meals.GroupBy(m => m.Date).OrderBy(g => g.Key))
        {
            <div class="mealplan-day">
                <h3>@day.Key.ToString("ddd, MMM d")</h3>
                @foreach (var meal in day.OrderBy(m => m.Slot))
                {
                    <article class="recipe-card mealplan-meal">
                        <div class="recipe-card-top">
                            <h4><span class="chip chip-stocked">@meal.Slot</span> @meal.Recipe!.Name</h4>
                        </div>
                        @if (meal.Recipe.Blurb is { Length: > 0 } blurb)
                        {
                            <p class="muted">@blurb</p>
                        }
                        @if (meal.Recipe.EstimatedCaloriesPerServing is { } cal)
                        {
                            <p class="recipe-cal">~@cal cal / serving <span class="muted">(est.)</span></p>
                        }
                        <ul class="ingredient-list">
                            @foreach (var i in meal.Recipe.MainIngredients)
                            {
                                <li>@RecipeFormat.Line(i.Quantity, i.Name)</li>
                            }
                            @{ var seasonings = meal.Recipe.Seasonings.Select(i => i.Name).ToList(); }
                            @if (seasonings.Count > 0)
                            {
                                <li class="muted">+ @string.Join(", ", seasonings)</li>
                            }
                        </ul>
                        @if (meal.Recipe.Steps.Count > 0)
                        {
                            <details class="recipe-steps">
                                <summary>Steps (@meal.Recipe.Steps.Count)</summary>
                                <ol>
                                    @foreach (var step in meal.Recipe.Steps.OrderBy(s => s.Order))
                                    {
                                        <li>@step.Text</li>
                                    }
                                </ol>
                            </details>
                        }
                    </article>
                }
            </div>
        }
    </section>
}
else if (!generating)
{
    <section class="panel">
        <p class="muted">No plan yet — set it up above and hit <strong>Generate my plan</strong>.</p>
    </section>
}

@code {
    // Mutable form state (MealPlanSettings is init-only, so the form binds to locals and builds it on submit).
    private int days = 7;
    private bool breakfast, lunch, dinner = true, snack;
    private int? calories;
    private TimeEffort effort = TimeEffort.Standard;
    private bool invent;
    private int? protein, carbs;
    private string foodGroupsText = "";
    private bool slowCooker, airFryer, grill, pressureCooker, blender, smoker;

    private MealPlan? plan;
    private bool generating;
    private int progressDone, progressTotal;
    private string? householdId;
    private CancellationTokenSource? pollCts;
    private string? error;
    private string? note;

    protected override async Task OnInitializedAsync()
    {
        var setup = await Planner.LoadSettingsAsync();
        days = setup.Days;
        breakfast = setup.Slots.Contains(MealSlot.Breakfast);
        lunch = setup.Slots.Contains(MealSlot.Lunch);
        dinner = setup.Slots.Contains(MealSlot.Dinner);
        snack = setup.Slots.Contains(MealSlot.Snack);
        calories = setup.CaloriesPerMeal;
        effort = setup.Effort;
        invent = setup.Invent;
        protein = setup.ProteinGramsPerDay;
        carbs = setup.CarbGramsPerDay;
        foodGroupsText = string.Join(", ", setup.FoodGroups);
        slowCooker = setup.Appliances.Contains("slow cooker");
        airFryer = setup.Appliances.Contains("air fryer");
        grill = setup.Appliances.Contains("grill");
        pressureCooker = setup.Appliances.Contains("pressure cooker");
        blender = setup.Appliances.Contains("blender");
        smoker = setup.Appliances.Contains("smoker");

        householdId = await Household.GetIdAsync();
        plan = await Planner.GetCurrentPlanAsync();

        // Resume showing an in-flight generation the user left and came back to.
        if (householdId is not null && Jobs.Current(householdId) is { State: MealPlanJobState.Running })
        {
            generating = true;
            StartPolling();
        }
    }

    private async Task Generate()
    {
        if (generating || householdId is null) return;
        error = null;
        note = null;

        var slots = new List<MealSlot>();
        if (breakfast) slots.Add(MealSlot.Breakfast);
        if (lunch) slots.Add(MealSlot.Lunch);
        if (dinner) slots.Add(MealSlot.Dinner);
        if (snack) slots.Add(MealSlot.Snack);

        var setup = new MealPlanSettings
        {
            Days = days,
            Slots = slots.Count > 0 ? slots : [MealSlot.Dinner],
            CaloriesPerMeal = calories,
            Effort = effort,
            Invent = invent,
            ProteinGramsPerDay = protein,
            CarbGramsPerDay = carbs,
            FoodGroups = ParseCsv(foodGroupsText),
            Appliances = SelectedAppliances(),
        };
        try
        {
            await Planner.SaveSettingsAsync(setup);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the meal-plan setup failed.");
            error = "Couldn't save your setup — please try again.";
            return;
        }

        // Kick off a DETACHED background job and watch it: the generation survives navigating away, and the
        // page just polls for the result (or re-attaches to it on return via OnInitialized).
        generating = true;
        progressDone = 0;
        progressTotal = 0;
        Jobs.Start(householdId);
        StartPolling();
    }

    // Poll the background job until it finishes, then load the plan (or surface its error). A fresh poll
    // cancels any previous one; Dispose cancels it when the user leaves (the JOB keeps running regardless).
    private void StartPolling()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = new CancellationTokenSource();
        _ = PollAsync(pollCts.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                if (householdId is null) return;
                var snap = Jobs.Current(householdId); // check FIRST — a finished job is picked up at once
                if (snap is null) { generating = false; await InvokeAsync(StateHasChanged); return; }

                if (snap.State != MealPlanJobState.Running)
                {
                    generating = false;
                    if (snap.State == MealPlanJobState.Done)
                    {
                        plan = await Planner.GetCurrentPlanAsync();
                        note = $"Planned {snap.MealCount} meal{(snap.MealCount == 1 ? "" : "s")}.";
                    }
                    else
                    {
                        error = snap.Error ?? "Couldn't generate a plan just now — please try again.";
                    }
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                progressDone = snap.Done;
                progressTotal = snap.Total;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(2500, token);
            }
        }
        catch (OperationCanceledException) { /* the page went away, or a newer poll replaced this one */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Watching the meal-plan job failed.");
        }
    }

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
    }

    private static IReadOnlyList<string> ParseCsv(string text) =>
        [.. text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    private IReadOnlyList<string> SelectedAppliances()
    {
        var list = new List<string>();
        if (slowCooker) list.Add("slow cooker");
        if (airFryer) list.Add("air fryer");
        if (grill) list.Add("grill");
        if (pressureCooker) list.Add("pressure cooker");
        if (blender) list.Add("blender");
        if (smoker) list.Add("smoker");
        return list;
    }
}
