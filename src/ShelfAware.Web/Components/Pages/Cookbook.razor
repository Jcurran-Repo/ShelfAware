@page "/cookbook"
@implements IAsyncDisposable
@using ShelfAware.Core.Recipes
@using ShelfAware.Core.Settings
@inject IHouseholdDbFactory DbFactory
@inject IAppSettings Settings
@inject RecipeTagService TagService
@inject IShelfPhotoLoader PhotoLoader
@inject RecipeImageStorage Images
@inject IEntitlements Entitlements
@inject CircuitAiSettings AiSettings
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<Cookbook> Logger

<PageTitle>Cookbook — Reginald</PageTitle>

@* Wrapped so the print rules can hide this page's chrome (page-head, disclaimer, the interactive
   carousel) without touching the page-head of other printable pages — @media print is global CSS. *@
<div class="cookbook-root">

<div class="page-head">
    <h1>Cookbook</h1>
    <span class="cookbook-head-actions">
        <a class="tag-chip" href="/cookbook/import">📷 Add a recipe</a>
        <a class="tag-chip" href="/recipes">＋ Get recipe ideas</a>
    </span>
</div>

<p class="recipe-disclaimer" role="note">
    ⚠️ Ideas only — <strong>always check ingredient labels yourself</strong>. This is not allergy-safe or
    medical advice.
</p>

@* ─────────────────────────────────────── Filters ─────────────────────────────────────── *@
@if (allRecipes.Count > 0)
{
    <section class="panel cookbook-interactive">
        @{ var planCount = allRecipes.Count(r => r.PlanGenerated); var mineCount = allRecipes.Count - planCount; }
        @if (planCount > 0 && mineCount > 0)
        {
            @* Two libraries: your own kept recipes, and the meal-plan generated ones — kept apart so the
               plan's output doesn't drown the recipes you chose to save. Only shown when both exist. *@
            <div class="cookbook-source" role="group" aria-label="Which recipes to show">
                <button type="button" class="secondary @(showPlanRecipes ? null : "active")"
                        aria-pressed="@(showPlanRecipes ? "false" : "true")" @onclick="() => SetSource(plan: false)">
                    My recipes <span class="tag-count">@mineCount</span>
                </button>
                <button type="button" class="secondary @(showPlanRecipes ? "active" : null)"
                        aria-pressed="@(showPlanRecipes ? "true" : "false")" @onclick="() => SetSource(plan: true)">
                    Meal-plan recipes <span class="tag-count">@planCount</span>
                </button>
            </div>
        }
        <div class="cookbook-filters">
            @if (productOptions.Count > 0)
            {
                <label class="field cookbook-product-filter">
                    <span>Recipes that use…</span>
                    @* Type-and-guess: a datalist of the products some recipe is grounded to. Typing (or
                       picking) a NAME resolves to the product id the ?uses deep link needs, and
                       CommitProductFilter navigates there — exactly what the old dropdown did, so every
                       filter is still a shareable URL that combines with the tag chips. *@
                    <input class="cookbook-product-input" list="cookbook-product-filter-options" type="search"
                           autocomplete="off" @bind="productFilterText" @bind:after="CommitProductFilter"
                           placeholder="Type a product… (blank shows all)"
                           aria-label="Filter recipes by a product they use — type to search" />
                    <datalist id="cookbook-product-filter-options">
                        @foreach (var (_, name) in productOptions)
                        {
                            <option value="@name"></option>
                        }
                    </datalist>
                    @if (filterHint is not null)
                    {
                        <span class="muted small" role="status">@filterHint</span>
                    }
                </label>
            }
            @{ var untaggedCount = allRecipes.Count(r => r.Tags.Count == 0); }
            @if (untaggedCount > 0)
            {
                <button type="button" class="secondary cookbook-bulk-tag" @onclick="TagUntagged" disabled="@taggingBusy"
                        title="Let AI suggest tags for every recipe that has none yet (one short call each).">
                    @(bulkTagging ? $"Tagging… {bulkDone}/{untaggedCount}" : $"✨ Tag {untaggedCount} untagged")
                </button>
            }
        </div>

        @if (tagCounts.Count > 0)
        {
            <div class="tag-cloud" role="group" aria-label="Filter recipes by tag">
                @foreach (var (value, count) in tagCounts)
                {
                    var active = IsActiveTag(value);
                    <button type="button" class="tag-chip tag-cloud-chip @(active ? "active" : null)"
                            aria-pressed="@(active ? "true" : "false")" @onclick="() => ToggleTag(value)">
                        @value <span class="tag-count">@count</span>
                    </button>
                }
            </div>
        }

        @if (filterProductName is not null || activeTag is not null)
        {
            <p class="filter-banner" role="status">@FilterBannerText() — <a href="/cookbook">show all</a></p>
        }

        @if (filtered.Count == 0)
        {
            <p class="muted">@EmptyMessage()</p>
        }
        else if (Current is { } r)
        {
            @* Which recipe is centred, announced for everyone (visible) and to screen readers (the live
               region). Updates as you page with the arrow keys, click a preview, or drag the shelf. *@
            <p class="cookbook-position" role="status" aria-live="polite">
                <strong>@r.Name</strong> — @(index + 1) of @filtered.Count
            </p>

            @* The preview shelf: a horizontal scroll-snap track of read-only previews, one per recipe. The
               centred one is emphasised; its neighbours peek at a smaller scale + softer opacity. Touch and
               trackpad swipe come free from scroll-snap; mouse click-drag and centre-reporting come from
               /js/cookbook-carousel.js. Focusable (tabindex=0) so the arrow keys page it; the previews are
               tabindex=-1 options so the shelf is a single tab stop, not one per recipe. *@
            <div class="cookbook-shelf-wrap">
                <div class="cookbook-shelf" role="group" aria-label="Recipe book — use the arrow keys to page through recipes"
                     tabindex="0" @ref="shelfRef" @onkeydown="OnKey">
                    @for (var i = 0; i < filtered.Count; i++)
                    {
                        var idx = i;
                        var pr = filtered[i];
                        var isCurrent = i == index;
                        <button type="button" data-card="@i" tabindex="-1"
                                class="cookbook-preview @(isCurrent ? "is-current" : null)"
                                aria-current="@(isCurrent ? "true" : null)"
                                aria-label="@pr.Name"
                                @onclick="() => Center(idx)">
                            <span class="cookbook-preview-photo @(pr.ImagePath is null ? "is-placeholder" : null)">
                                @if (pr.ImagePath is not null)
                                {
                                    <img src="@PhotoUrl(pr)" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span aria-hidden="true">🍽</span>
                                }
                            </span>
                            <span class="cookbook-preview-name">@pr.Name</span>
                            <span class="cookbook-preview-badges">
                                <span class="@MakeableChipClass(pr)">@MakeableChipLabel(pr)</span>
                                @if (pr.IsVariant)
                                {
                                    <span class="chip variant-chip" title="Adapted to use what you have">🔀 adapted</span>
                                }
                            </span>
                            @if (pr.Tags.Count > 0)
                            {
                                <span class="cookbook-preview-tags">
                                    @foreach (var tag in SortedTagValues(pr))
                                    {
                                        <span class="tag-chip">@tag</span>
                                    }
                                </span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* The detail panel — the centred recipe in full, with every interactive control. Stable below
               the shelf (no layout shift as you drag). Keyed on the recipe id so changing the centre rebuilds
               it — resetting any open <details>, replaying the gentle fade (motion-safe), and giving the photo
               input + datalist a fresh instance — exactly as paging replaced the card before. *@
            <article class="recipe-card cookbook-detail" aria-label="@r.Name" @key="r.Id">
                <div class="recipe-card-top">
                    <h2>@r.Name</h2>
                    <span class="cookbook-badges">
                        <span class="@MakeableChipClass(r)">@MakeableChipLabel(r)</span>
                        @if (r.IsVariant)
                        {
                            <span class="chip variant-chip" title="Adapted to use what you have">🔀 adapted</span>
                        }
                    </span>
                </div>

                @if (r.ImagePath is not null)
                {
                    <img class="cookbook-photo" src="@PhotoUrl(r)" alt="Photo of @r.Name" loading="lazy" />
                }

                <div class="cookbook-tags">
                    @foreach (var tag in SortedTagValues(r))
                    {
                        <span class="tag-chip">@tag<button type="button" class="tag-x" @onclick="() => RemoveTag(tag)"
                                disabled="@taggingBusy" aria-label="Remove tag @tag from @r.Name">×</button></span>
                    }
                    <span class="cookbook-tag-add">
                        <input list="recipe-tag-vocab" placeholder="add a tag" @bind="newTag" @bind:event="oninput"
                               @onkeydown="AddTagOnEnter" disabled="@taggingBusy" aria-label="Add a tag to @r.Name" />
                        <button type="button" class="secondary" @onclick="AddTag"
                                disabled="@(taggingBusy || string.IsNullOrWhiteSpace(newTag))">Add</button>
                        <button type="button" class="secondary" @onclick="SuggestTags" disabled="@taggingBusy"
                                title="Let AI suggest tags for this recipe from its name and ingredients">
                            @(suggesting ? "Suggesting…" : "✨ Suggest tags")
                        </button>
                    </span>
                </div>
                @if (tagNote is not null)
                {
                    <p class="muted small cookbook-tag-note" role="status">@tagNote</p>
                }

                @if (r.Blurb is { Length: > 0 } blurb)
                {
                    <p class="muted">@blurb</p>
                }
                @if (r.EstimatedCaloriesPerServing is { } cal)
                {
                    <p class="recipe-cal">~@cal cal / serving <span class="muted">(est.)</span></p>
                }

                <h3 class="cookbook-subhead">Ingredients</h3>
                <ul class="ingredient-list">
                    @foreach (var i in r.MainIngredients)
                    {
                        var cover = i.CoverageBy(onHand);
                        var have = cover != IngredientCoverage.None;
                        <li class="@(have ? "have" : "grab")">
                            <span class="ingredient-name">@(have ? "✓" : "🛒") @RecipeFormat.Line(i.Quantity, i.Name)</span>
                            @* Covered only by a declared stand-in — the steps are written for the original and
                               may cook differently. The Cookbook browses/reads; Adapt lives on the Recipes page. *@
                            @if (cover == IngredientCoverage.Substitute)
                            {
                                <span class="swap-note" title="You don't have @i.Name, but a stand-in you own covers it — the steps are written for @i.Name and may cook differently. Adapt it on the Recipes page to rebuild them.">stand-in</span>
                            }
                        </li>
                    }
                    @{ var extras = r.Seasonings.Select(i => RecipeFormat.Line(i.Quantity, i.Name)).ToList(); }
                    @if (extras.Count > 0)
                    {
                        <li class="muted">+ @string.Join(", ", extras)</li>
                    }
                </ul>

                @if (r.Steps.Count > 0)
                {
                    <details class="recipe-steps" open>
                        <summary>Method (@r.Steps.Count @(r.Steps.Count == 1 ? "step" : "steps"))</summary>
                        <ol>
                            @foreach (var step in r.Steps.OrderBy(s => s.Order))
                            {
                                <li>@step.Text</li>
                            }
                        </ol>
                    </details>
                }

                <div class="cookbook-actions">
                    @if (r.Steps.Count > 0)
                    {
                        <button class="secondary" @onclick="() => StartReading(r)"
                                aria-label="Read @r.Name aloud"
                                title="Read it to me — synthesized once, then free to re-read.">🔊 Read it to me</button>
                    }
                    <button class="secondary" @onclick="PrintRecipe" aria-label="Print @r.Name">🖨 Print recipe</button>
                    <button class="secondary" @onclick="PrintProducts"
                            aria-label="Print the products needed for @r.Name">🛒 Print products</button>
                    @* Photo add/replace: the input is visually hidden and PRECEDES its label (the
                       .file-button pattern, sibling selector); @key gives a fresh input per pick so
                       re-picking the same file still fires a change. *@
                    <InputFile @key="@($"photo-{r.Id}-{photoGeneration}")" id="cookbook-photo"
                               OnChange="OnPhotoSelected" accept="image/*" disabled="@photoBusy"
                               class="visually-hidden"
                               aria-label="@(r.ImagePath is null ? $"Add a photo to {r.Name}" : $"Replace the photo for {r.Name}")" />
                    <label class="file-button" for="cookbook-photo">📷 @(r.ImagePath is null ? "Add photo" : "Replace photo")</label>
                    @if (r.ImagePath is not null)
                    {
                        <button class="secondary" @onclick="RemovePhoto" disabled="@photoBusy"
                                aria-label="Remove the photo for @r.Name">Remove photo</button>
                    }
                </div>
            </article>

            <datalist id="recipe-tag-vocab">
                @foreach (var v in tagVocabulary)
                {
                    <option value="@v"></option>
                }
            </datalist>

            @if (readingRecipe is not null)
            {
                @* Button-only read (no microphone). Keyed on the recipe so switching pages rebuilds it. *@
                <RecipeReadAloud Recipe="readingRecipe" HandsFree="false"
                                 @key="readingRecipe.Id" OnClosed="StopReading" />
            }
        }
    </section>
}
else
{
    <section class="panel">
        <p class="muted">
            Your cookbook is empty. Head to <a href="/recipes">Recipes</a>, ask "what can I make?", and
            Save the ideas you like — they'll appear here to browse, read aloud, and print.
        </p>
    </section>
}

@* ───────────────────────── Print-only surfaces (hidden on screen) ─────────────────────────
   Two layouts for the CURRENT recipe: the full recipe card, and a shopping list of its products.
   Which one prints is chosen just before window.print() (OnAfterRenderAsync), by the show-* class. *@
@if (Current is { } printMe)
{
    <div class="cookbook-print @(printTarget == PrintTarget.Products ? "show-products" : "show-recipe")">
        <section class="print-recipe">
            <h1>@printMe.Name</h1>
            @if (printMe.Blurb is { Length: > 0 } pblurb)
            {
                <p>@pblurb</p>
            }
            @if (printMe.EstimatedCaloriesPerServing is { } pcal)
            {
                <p>~@pcal cal / serving (est.)</p>
            }
            <h2>Ingredients</h2>
            <ul>
                @foreach (var i in printMe.Ingredients)
                {
                    <li>@RecipeFormat.Line(i.Quantity, i.Name)</li>
                }
            </ul>
            @if (printMe.Steps.Count > 0)
            {
                <h2>Method</h2>
                <ol>
                    @foreach (var step in printMe.Steps.OrderBy(s => s.Order))
                    {
                        <li>@step.Text</li>
                    }
                </ol>
            }
        </section>

        <section class="print-products">
            <h1>Shopping list</h1>
            <p>Products for <strong>@printMe.Name</strong>. Ticked items you already have on hand.</p>
            <h2>Main ingredients</h2>
            <ul class="print-products-list">
                @foreach (var i in printMe.MainIngredients)
                {
                    <li>@(i.IsSatisfiedBy(onHand) ? "☑" : "☐") @RecipeFormat.Line(i.Quantity, i.Name)</li>
                }
            </ul>
            @{ var pantry = printMe.Seasonings.ToList(); }
            @if (pantry.Count > 0)
            {
                <h2>Also needs (seasonings &amp; staples)</h2>
                <ul class="print-products-list">
                    @foreach (var i in pantry)
                    {
                        <li>@RecipeFormat.Line(i.Quantity, i.Name)</li>
                    }
                </ul>
            }
        </section>
    </div>
}

</div>

@code {
    private List<Recipe> allRecipes = [];
    private List<PantryProduct> onHand = [];
    private Dictionary<int, string> productNamesById = [];
    private List<(int Id, string Name)> productOptions = [];

    // The recipe tags, counted for the cloud (most-used first), plus the vocabulary for the add datalist.
    private List<(string Value, int Count)> tagCounts = [];
    private List<string> tagVocabulary = [];

    // The recipes that pass the current filters, in book (alphabetical) order — the deck we page through.
    private List<Recipe> filtered = [];
    private int index;                 // position within `filtered` (0-based)
    private string? filterProductName; // resolved from ?uses, shown in the banner
    private string productFilterText = ""; // the type-and-guess box's text; kept in step with the active filter
    private string? filterHint; // shown when a typed entry resolves to nothing/many, so a commit is never a silent no-op
    private string? activeTag;         // resolved from ?tag
    private bool showPlanRecipes;      // false = your own kept recipes; true = the meal-plan library
    private Recipe? readingRecipe;     // the recipe whose read-aloud panel is open (null = none)

    // Tag editing (all through RecipeTagService — the one write path)
    private string newTag = "";
    private bool taggingBusy;
    private bool suggesting;   // the single-recipe "Suggest tags" call is in flight
    private bool bulkTagging;  // the "Tag N untagged" sweep is in flight
    private int bulkDone;      // recipes processed so far in the sweep (for progress)
    private string? tagNote;   // result of the last tag action

    // Photos (RecipeImageStorage; served household-scoped via /api/recipe-image/{id})
    private readonly CancellationTokenSource pageCts = new();
    private bool photoBusy;
    private int photoGeneration; // bump to give the file input a fresh element after each pick

    private enum PrintTarget { Recipe, Products }
    private PrintTarget printTarget = PrintTarget.Recipe;
    private bool printPending;

    // ── Preview-shelf JS interop (mouse drag + centre sync). `index` stays the source of truth; the module
    //    reports the settled centre (OnCentered) and centres a given index on request (scrollToIndex). ──
    private ElementReference shelfRef;
    private IJSObjectReference? _carousel;
    private DotNetObjectReference<Cookbook>? _selfRef;
    private bool _shelfWired;     // the module is bound to the CURRENT shelf element
    private int? _pendingScroll;  // a centre .NET asked for (keyboard / click / filter reset), applied after render
    private bool _pendingSmooth;  // whether that pending scroll should animate

    /// <summary>Deep link / in-page product filter (/cookbook?uses={id}) — same shape and meaning as the
    /// Recipes page's ?uses, so a link works on either surface. Scopes the deck to recipes grounded to
    /// that product (Recipe.Uses — the one shared definition).</summary>
    [SupplyParameterFromQuery(Name = "uses")] public int? UsesProductId { get; set; }

    /// <summary>Deep link / tag-cloud filter (/cookbook?tag=Dinner) — scopes the deck to recipes carrying
    /// that tag. Combines with ?uses (both must match).</summary>
    [SupplyParameterFromQuery(Name = "tag")] public string? Tag { get; set; }

    private Recipe? Current => filtered.Count > 0 ? filtered[Math.Clamp(index, 0, filtered.Count - 1)] : null;

    // The makeability chip shows in THREE places — this page's preview and detail panel, and the Recipes
    // page. Its class and label get ONE definition (MakeabilityFormat, in Core) so they can't drift — e.g.
    // one surface reading "Ready to make" while another shows "Makeable with a swap" for the same recipe.
    // Food-family makeability via IngredientMatcher, exactly as the Recipes page decides it; seasonings don't count.
    private string MakeableChipClass(Recipe r) => MakeabilityFormat.ChipClass(r.MakeabilityWith(onHand));
    private string MakeableChipLabel(Recipe r) => MakeabilityFormat.Label(r.MakeabilityWith(onHand));

    // A recipe's tags in display order — used by both the preview and the detail panel, so the sort lives in
    // one place. (The tag CLOUD sorts by count instead; that's a different order, kept separate on purpose.)
    private static IEnumerable<string> SortedTagValues(Recipe r) =>
        r.Tags.Select(t => t.Value).OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase);

    private bool IsActiveTag(string value) => string.Equals(activeTag, value, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Runs on first render and every query-string change (the filters) — never on an internal
    // StateHasChanged, so paging with Prev/Next keeps its place while a filter change starts at page one.
    protected override void OnParametersSet()
    {
        index = 0;
        ApplyFilters();
        RequestScroll(smooth: false); // a filter change (or the first load) starts at page one — jump, don't glide
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // SQLite can't ORDER BY a DateTimeOffset column; order is applied in ApplyFilters anyway.
        allRecipes = await db.Recipes.AsNoTracking()
            .Include(r => r.Ingredients).Include(r => r.Steps).Include(r => r.Tags).ToListAsync();
        productNamesById = await db.Products.Select(p => new { p.Id, p.Name })
            .ToDictionaryAsync(x => x.Id, x => x.Name);

        // On-hand for the have/grab marks and the "Ready to make" chip — the same edible, tracked,
        // not-run-out set the Recipes page uses (PantryOnHand), so the two agree.
        var products = await db.Products.AsNoTracking()
            .Include(p => p.Purchases).Include(p => p.Signals).Include(p => p.Substitutes).ToListAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var trackExpirations = await Settings.GetTrackExpirationDatesAsync();
        onHand = PantryOnHand.EdibleInStock(products, today, trackExpirations)
            .Select(p => new PantryProduct(p.Name, p.Substitutes.Select(s => s.Value).ToList()))
            .OrderBy(x => x.Name)
            .ToList();

        // Products the dropdown offers = those some recipe is actually grounded to (else the filter would
        // just show "none"). Keyed by id so the filter deep-links like the Recipes page's ?uses.
        var used = new HashSet<string>(
            allRecipes.SelectMany(r => r.Ingredients)
                .Select(i => i.MatchedProduct)
                .Where(n => !string.IsNullOrWhiteSpace(n))!,
            StringComparer.OrdinalIgnoreCase);
        productOptions = productNamesById
            .Where(kv => used.Contains(kv.Value))
            .Select(kv => (kv.Key, kv.Value))
            .OrderBy(x => x.Value, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        // The tag cloud, counted over ALL recipes (most-used first), and the vocabulary for the add box.
        tagCounts = allRecipes.SelectMany(r => r.Tags.Select(t => t.Value))
            .GroupBy(v => v, StringComparer.OrdinalIgnoreCase)
            .Select(g => (Value: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count).ThenBy(x => x.Value, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        tagVocabulary = await RecipeTagService.VocabularyAsync(db);

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filterProductName = UsesProductId is { } pid && productNamesById.TryGetValue(pid, out var name) ? name : null;
        productFilterText = filterProductName ?? ""; // the box always shows the filter that's actually applied
        filterHint = null; // any navigation lands on a real filter, so a stale "no match" note must not linger
        activeTag = Tag is { Length: > 0 } ? Tag : null;

        // Source first: your own kept recipes by default, or the meal-plan library when that tab is picked —
        // so generated recipes accumulate as a browsable library without drowning your saved ones.
        IEnumerable<Recipe> q = allRecipes.Where(r => showPlanRecipes ? r.PlanGenerated : !r.PlanGenerated);
        if (filterProductName is { } productName)
        {
            q = q.Where(r => r.Uses(productName));
        }
        if (activeTag is { } tag)
        {
            q = q.Where(r => r.Tags.Any(t => string.Equals(t.Value, tag, StringComparison.OrdinalIgnoreCase)));
        }

        filtered = q.OrderBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        if (index >= filtered.Count) index = Math.Max(0, filtered.Count - 1);
    }

    // Switch between your own recipes and the meal-plan library. Resets to the first card and closes any open
    // reader (the deck it belonged to is changing out from under it).
    private void SetSource(bool plan)
    {
        if (showPlanRecipes == plan) return;
        showPlanRecipes = plan;
        readingRecipe = null;
        index = 0;
        ApplyFilters();
        _pendingScroll = 0;
    }

    private string FilterBannerText() => (filterProductName, activeTag) switch
    {
        ({ } p, null) => $"Showing recipes that use {p}",
        (null, { } t) => $"Showing recipes tagged “{t}”",
        ({ } p, { } t) => $"Showing recipes tagged “{t}” that use {p}",
        _ => "Showing all recipes",
    };

    private string EmptyMessage() => (filterProductName, activeTag) switch
    {
        (null, null) => "No saved recipes yet — head to Recipes, get some ideas, and Save the ones you like.",
        ({ } p, null) => $"No saved recipes use {p} yet.",
        (null, { } t) => $"No recipes tagged “{t}” yet.",
        ({ } p, { } t) => $"No recipes tagged “{t}” that use {p}.",
    };

    // Paging by keyboard or by clicking a preview. Each moves the centre by setting `index`, asks the shelf
    // to scroll the new centre into view (applied after the render, once the module has loaded), and closes
    // any open reader / tag box for the recipe we're leaving. A drag comes the OTHER way — see OnCentered.
    private void Prev() => Center(index - 1);

    private void Next() => Center(index + 1);

    private void Center(int i)
    {
        index = Math.Clamp(i, 0, Math.Max(0, filtered.Count - 1));
        RequestScroll(smooth: true);
        ResetTransient();
    }

    private void OnKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowLeft": Prev(); break;
            case "ArrowRight": Next(); break;
            case "Home": Center(0); break;
            case "End": Center(filtered.Count - 1); break;
        }
    }

    // Ask OnAfterRenderAsync to centre the shelf on `index`. Kept out of the handlers so the JS call lands
    // once per render (after the DOM reflects the new centre), and so a filter reset — which has no module
    // yet on the very first load — queues the same way and is applied when the module is ready.
    private void RequestScroll(bool smooth)
    {
        _pendingScroll = index;
        _pendingSmooth = smooth;
    }

    // The shelf settled on a new centre — a drag, swipe, or momentum fling reported by the JS module. Update
    // `index`, but never ask to scroll back (a report and a scroll would ping-pong forever). Mirrors paging:
    // it closes the reader / tag box for the recipe we've just left.
    [JSInvokable]
    public Task OnCentered(int i)
    {
        var target = Math.Clamp(i, 0, Math.Max(0, filtered.Count - 1));
        if (target == index) return Task.CompletedTask;
        index = target;
        ResetTransient();
        return InvokeAsync(StateHasChanged);
    }

    // The add box and the last tag note belong to the recipe on screen — clear them when it changes.
    private void ResetTransient()
    {
        newTag = "";
        tagNote = null;
        // Paging away closes the reader — it must not keep reading one recipe while the card shows another.
        readingRecipe = null;
    }

    // The product filter box committed (a suggestion picked, or free text entered). Resolve it to a product
    // and navigate to that ?uses deep link — the SAME URL the old dropdown produced, so a filter stays
    // shareable and still combines with the tag chips.
    //   • empty  → clear the filter (back to all)
    //   • a match → navigate to that product
    //   • no match → leave the current filter be; the typed text stays so it can be corrected (a search box
    //                doesn't erase what you typed), and the banner keeps showing the filter actually applied.
    private void CommitProductFilter()
    {
        var typed = productFilterText.Trim();
        filterHint = null;
        if (typed.Length == 0)
        {
            if (UsesProductId is not null) Nav.NavigateTo(FilterUri(null, activeTag));
            return;
        }
        if (ResolveProduct(typed) is { } id)
        {
            if (id != UsesProductId) Nav.NavigateTo(FilterUri(id, activeTag));
        }
        else
        {
            // Free text can resolve to nothing (a typo) or to several products (an ambiguous partial) —
            // neither navigates. The old dropdown couldn't do that; say so, or the box looks broken.
            filterHint = $"No single product matches “{typed}” — pick one from the list.";
        }
    }

    // Resolve typed text to one of the OFFERED products (the datalist set): an exact name (what picking a
    // suggestion yields), else a UNIQUE case-insensitive partial so a half-typed "chick" still lands. Null
    // when nothing — or more than one thing — matches, so an ambiguous or unknown entry changes no filter.
    private int? ResolveProduct(string query)
    {
        foreach (var (id, name) in productOptions)
        {
            if (string.Equals(name, query, StringComparison.CurrentCultureIgnoreCase)) return id;
        }
        var partial = productOptions
            .Where(o => o.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase))
            .Take(2)
            .ToList();
        return partial.Count == 1 ? partial[0].Id : null;
    }

    private void ToggleTag(string tag)
    {
        var next = IsActiveTag(tag) ? null : tag; // clicking the active tag clears it
        Nav.NavigateTo(FilterUri(UsesProductId, next));
    }

    // Build the /cookbook URL for the given filters. One helper so the dropdown, the tag chips, and the
    // "show all" link agree on the query shape (uses + tag combine).
    private static string FilterUri(int? uses, string? tag)
    {
        var query = new List<string>();
        if (uses is { } id) query.Add($"uses={id}");
        if (!string.IsNullOrEmpty(tag)) query.Add($"tag={Uri.EscapeDataString(tag)}");
        return query.Count == 0 ? "/cookbook" : "/cookbook?" + string.Join("&", query);
    }

    private void StartReading(Recipe r) => readingRecipe = r;
    private void StopReading() => readingRecipe = null;

    // ── Tag editing — every write goes through RecipeTagService, then a reload reflects it ──

    private async Task AddTag()
    {
        if (Current is not { } r || taggingBusy || string.IsNullOrWhiteSpace(newTag)) return;
        taggingBusy = true;
        tagNote = null;
        try
        {
            var added = await TagService.AddAsync(r.Id, newTag);
            tagNote = added is null ? "That tag is already there (or blank)." : null;
            newTag = "";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Adding a tag to recipe {RecipeId} failed.", r.Id);
            tagNote = "Couldn't add that tag — please try again.";
        }
        finally { taggingBusy = false; }
    }

    private async Task AddTagOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTag();
    }

    private async Task RemoveTag(string tag)
    {
        if (Current is not { } r || taggingBusy) return;
        taggingBusy = true;
        tagNote = null;
        try
        {
            await TagService.RemoveAsync(r.Id, tag);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Removing a tag from recipe {RecipeId} failed.", r.Id);
            tagNote = "Couldn't remove that tag — please try again.";
        }
        finally { taggingBusy = false; }
    }

    private async Task SuggestTags()
    {
        if (Current is not { } r || taggingBusy) return;
        taggingBusy = true;
        suggesting = true;
        tagNote = null;
        var blocked = await AiErrorText.BlockedReasonAsync(Entitlements, AiSettings);
        if (blocked is not null) { tagNote = blocked; suggesting = false; taggingBusy = false; return; }
        try
        {
            var added = await TagService.SuggestAndApplyAsync(r.Id);
            tagNote = added.Count > 0
                ? $"Added: {string.Join(", ", added)}."
                : "No new tags suggested for this one.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Suggesting tags for recipe {RecipeId} failed.", r.Id);
            tagNote = "Couldn't suggest tags just now — please try again.";
        }
        finally { suggesting = false; taggingBusy = false; }
    }

    // Tag every recipe that has none yet — one short AI call each. The user opts in (it can be many
    // calls on their key), sees progress, and the result is idempotent-ish: a recipe that gains tags
    // drops out of "untagged" and won't be re-asked.
    private async Task TagUntagged()
    {
        if (taggingBusy) return;
        var untagged = allRecipes.Where(r => r.Tags.Count == 0).Select(r => r.Id).ToList();
        if (untagged.Count == 0) return;

        taggingBusy = true;
        bulkTagging = true;
        bulkDone = 0;
        tagNote = null;
        var blocked = await AiErrorText.BlockedReasonAsync(Entitlements, AiSettings);
        if (blocked is not null) { tagNote = blocked; bulkTagging = false; taggingBusy = false; return; }
        var tagged = 0;
        try
        {
            foreach (var id in untagged)
            {
                var added = await TagService.SuggestAndApplyAsync(id);
                if (added.Count > 0) tagged++;
                bulkDone++;
                StateHasChanged();
            }
            tagNote = $"Tagged {tagged} of {untagged.Count} recipe{(untagged.Count == 1 ? "" : "s")}.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Bulk-tagging untagged recipes failed after {Done}.", bulkDone);
            tagNote = $"Tagged {tagged} before a hitch — reload and try the rest.";
        }
        finally { bulkTagging = false; taggingBusy = false; }
    }

    // ── Photos — read (cancellable) then write (uncancellable), the census teardown discipline ──

    private static string PhotoUrl(Recipe r) =>
        $"/api/recipe-image/{r.Id}?v={Uri.EscapeDataString(r.ImagePath!.Split('/').Last())}";

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (Current is not { } r || photoBusy) return;
        photoBusy = true;
        tagNote = null;
        var ct = pageCts.Token; // captured once, before the first await (teardown discipline)
        try
        {
            var result = await PickedFileReader.ReadPhotoAsync(PhotoLoader, e.File, ct, Logger);
            switch (result.Kind)
            {
                case PickedFileReader.Kind.Loaded:
                    await SavePhotoAsync(r.Id, result.Bytes!, result.MediaType!);
                    await LoadAsync();
                    break;
                case PickedFileReader.Kind.Refused:
                case PickedFileReader.Kind.Failed:
                    tagNote = result.Message ?? "Couldn't read that image.";
                    break;
                // TornDown / ConnectionLost: the page is going or the circuit dropped — say nothing.
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The READ never throws (PickedFileReader is fully guarded); a failure here is the WRITE
            // (SavePhotoAsync — disk/DB). Show a message and keep the page rather than tear down the circuit.
            Logger.LogError(ex, "Saving a photo for recipe {RecipeId} failed.", r.Id);
            tagNote = "Couldn't save that photo — please try again.";
        }
        finally
        {
            photoBusy = false;
            photoGeneration++; // fresh input so re-picking the same file fires a change
        }
    }

    // Save the picked photo to the store and point the recipe at it. A WRITE, so CancellationToken.None
    // (a navigate-away must not half-apply it); the read above was cancellable. The old image is deleted
    // only AFTER the row points at the new one, so a failed save never strands the recipe imageless.
    private async Task SavePhotoAsync(int recipeId, byte[] bytes, string mediaType)
    {
        var path = await Images.SaveAsync(bytes, mediaType, CancellationToken.None);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var recipe = await db.Recipes.FirstOrDefaultAsync(x => x.Id == recipeId);
            if (recipe is null) { Images.Delete(path); return; } // recipe vanished — don't orphan the new file
            var old = recipe.ImagePath;
            recipe.ImagePath = path;
            await db.SaveChangesAsync();
            if (old is not null) Images.Delete(old); // remove the replaced photo AFTER the row points at the new one
        }
        catch
        {
            // The DB write failed, so no row ever pointed at the file we just wrote — delete it rather than
            // strand it on disk (the same orphan-cleanup RecipeImport.Save does), then rethrow so
            // OnPhotoSelected's handler logs and shows a message.
            Images.Delete(path);
            throw;
        }
    }

    private async Task RemovePhoto()
    {
        if (Current is not { } r || photoBusy || r.ImagePath is null) return;
        photoBusy = true;
        tagNote = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var recipe = await db.Recipes.FirstOrDefaultAsync(x => x.Id == r.Id);
            if (recipe?.ImagePath is { } path)
            {
                recipe.ImagePath = null;
                await db.SaveChangesAsync();
                Images.Delete(path); // AFTER the row stops pointing at it
            }
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Removing the photo for recipe {RecipeId} failed.", r.Id);
            tagNote = "Couldn't remove that photo — please try again.";
        }
        finally { photoBusy = false; }
    }

    private void PrintRecipe() { printTarget = PrintTarget.Recipe; printPending = true; }
    private void PrintProducts() { printTarget = PrintTarget.Products; printPending = true; }

    // First render: load the shelf's JS module. Every render: keep it bound to the current shelf element and
    // apply any pending centre. Then the print flow — AFTER the render that reflects printTarget, so the right
    // print-only block is showing when the browser dialog opens (the click handler flips printTarget +
    // printPending; that render lands here).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _carousel = await JS.InvokeAsync<IJSObjectReference>("import", "/js/cookbook-carousel.js");
                _selfRef = DotNetObjectReference.Create(this);
            }
            catch (JSDisconnectedException)
            {
                return; // circuit gone before the module loaded — nothing more to wire up
            }
            catch (JSException ex)
            {
                // The shelf module failed to load (404 / CSP / syntax). Degrade gracefully rather than fault
                // the whole page over a missing static asset: keyboard paging still works through OnKey and
                // the detail panel still tracks `index`; only the drag and the scroll-to-centre are inert.
                Logger.LogError(ex, "The cookbook shelf module failed to load; drag and scroll-sync are off.");
                return;
            }
        }

        await SyncShelfAsync();

        if (printPending)
        {
            printPending = false;
            try
            {
                await JS.InvokeVoidAsync("window.print");
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone (tab closed / navigated away) before the dialog opened — nothing to print.
            }
        }
    }

    // Keep the JS module bound to the CURRENT shelf element and apply any centre .NET asked for. The shelf
    // element is reused across filter changes (same position in the tree), but is created fresh when the deck
    // goes from empty back to non-empty — rebind on that transition. Every JS call guards the dropped circuit.
    private async Task SyncShelfAsync()
    {
        if (_carousel is null || _selfRef is null) return;

        var shelfPresent = filtered.Count > 0;
        try
        {
            if (shelfPresent && !_shelfWired)
            {
                // Mark wired BEFORE the await: renders can overlap an in-flight OnAfterRenderAsync, and this
                // keeps a re-entrant call out of this branch so init runs once. init() is idempotent anyway
                // (it unbinds first), so this is belt-and-braces — and the pending-scroll below still waits on
                // the same _shelfWired, applied after init has bound the shelf in this call.
                _shelfWired = true;
                await _carousel.InvokeVoidAsync("init", shelfRef, _selfRef);
            }
            else if (!shelfPresent && _shelfWired)
            {
                _shelfWired = false; // the element's gone; init rebinds fresh when the deck refills
            }

            if (_pendingScroll is { } target && _shelfWired)
            {
                _pendingScroll = null;
                await _carousel.InvokeVoidAsync("scrollToIndex", target, _pendingSmooth);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone — the shelf and its listeners went with it.
        }
    }

    public async ValueTask DisposeAsync()
    {
        pageCts.Cancel();

        if (_carousel is not null)
        {
            try
            {
                await _carousel.InvokeVoidAsync("dispose");
                await _carousel.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit already gone — its listeners went with it */ }
        }

        _selfRef?.Dispose();
        pageCts.Dispose();
    }
}
