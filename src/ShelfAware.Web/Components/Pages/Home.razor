@page "/"
@implements IDisposable
@using ShelfAware.Core.Chat
@using ShelfAware.Core.Prediction
@using ShelfAware.Core.Settings
@using ShelfAware.Core.Shopping
@using ShelfAware.Web.Undo
@inject IHouseholdDbFactory DbFactory
@inject IAppSettings SettingsStore
@inject IPantryChat Chat
@inject IPantryStore Store
@inject ActivityLogService ActivityLog
@inject NavigationManager Nav
@inject VoiceCoordinator Coordinator
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>Shelf Aware</PageTitle>

<OnboardingBanner CatalogEmpty="@(products is { Count: 0 })" OnSeeded="LoadAsync" />

<header class="page-head">
    <h1>Running Low</h1>
    @if (products is not null)
    {
        <div class="summary">
            @if (runningLow.Count == 0)
            {
                <span class="all-good">You're all stocked up.</span>
            }
            else
            {
                @if (overdueCount > 0)
                {
                    <span class="chip chip-overdue">@overdueCount overdue</span>
                }
                @if (dueSoonCount > 0)
                {
                    <span class="chip chip-duesoon">@dueSoonCount due soon</span>
                }
            }
        </div>
    }
</header>

@* Inline "↩ Undo" for the action just taken — the same one-service undo the /history page uses,
   reached without leaving the dashboard (one outstanding at a time, like the Ate-it notice). *@
@if (lastAction is { } a)
{
    <div class="panel inline-confirm" role="status">
        <span>Recorded: @a.Summary</span>
        <button type="button" class="secondary" @onclick="UndoLast" disabled="@actionBusy">↩ Undo</button>
        <button type="button" class="secondary" @onclick="DismissLast" disabled="@actionBusy">Dismiss</button>
        @if (actionNote is not null)
        {
            <span class="muted">@actionNote</span>
        }
    </div>
}

@if (products is null)
{
    <p>Loading…</p>
}
else
{
    @if (runningLow.Count == 0)
    {
        <div class="empty-state">
            <img src="icons/icon-512.png" alt="" class="mascot empty-mascot" />
            <p class="muted empty-note">Nothing's running low right now. Tracked items show up here as they approach their predicted run-out date.</p>
        </div>
    }
    else
    {
        @* A PERSISTENT live region: screen readers announce text CHANGING inside an existing
           region, not a region inserted already holding its text — so this stays mounted and
           the visible per-card note is presentation only. *@
        <div class="visually-hidden copy-announcer" role="status" aria-live="polite">@copyAnnouncement</div>
        <ul class="cards">
            @foreach (var p in runningLow)
            {
                var r = predictions[p.Id];
                <li class="card accent-@ChipClass(r.Status)">
                    <div class="card-body">
                        <div class="card-top">
                            <a class="card-name" href="/product/@p.Id">@p.Name</a>
                            <button type="button" class="icon-btn copy-name" @onclick="() => CopyName(p)"
                                    title="Copy name" aria-label="Copy @p.Name to the clipboard">📋</button>
                            @if (copyNote is { } cn && cn.ProductId == p.Id)
                            {
                                <span class="muted copy-note">@cn.Text</span>
                            }
                            <span class="chip chip-@ChipClass(r.Status)">@StatusLabel(r.Status)</span>
                        </div>
                        @{
                            var size = SizeFormat.Normalize(r.RecommendedSize);
                            var brand = ShoppingEstimator.UsualBrandOf(p.Purchases);
                            var variety = ShoppingEstimator.UsualVarietyOf(p.Purchases);
                        }
                        @if (size is { Length: > 0 } || brand is not null || variety is not null)
                        {
                            <div class="item-meta">
                                @if (size is { Length: > 0 } sz)
                                {
                                    <span class="size-chip" title="Suggested size to buy">@sz</span>
                                }
                                <BrandVarietyHint UsualBrand="@brand" UsualVariety="@variety"
                                                  Brands="@ShoppingEstimator.BrandsBoughtOf(p.Purchases)"
                                                  Varieties="@ShoppingEstimator.VarietiesBoughtOf(p.Purchases)" />
                            </div>
                        }
                        @{
                            var urgency = Urgency(r);
                        }
                        @if (urgency.Length > 0)
                        {
                            <div class="card-urgency">@urgency</div>
                        }
                        @if (r.SignalNote is not null)
                        {
                            <div class="card-note">@if (r.Pinned) { <span aria-hidden="true">📌 </span> }@r.SignalNote</div>
                        }
                        @if (r.Expired && r.ExpiresOn is { } expiredOn)
                        {
                            @* The honest reason this card is red: the label, not the cadence — the user
                               can see the jug in the fridge, so the card must say WHY it counts as out. *@
                            <div class="card-note"><span aria-hidden="true">🏷️ </span>Expired @expiredOn.ToString("MMM d")</div>
                        }
                        <div class="card-basis muted">@r.Basis</div>
                    </div>
                    <div class="card-actions">
                        <SplitButton PrimaryLabel="Bought today" OnPrimary="() => BoughtToday(p)"
                                     PrimaryAriaLabel="@($"Mark {p.Name} bought today")" Disabled="actionBusy">
                            <button class="secondary" @onclick="() => Restocked(p)" disabled="@actionBusy" aria-label="Mark @p.Name restocked">Restocked</button>
                        </SplitButton>
                    </div>
                </li>
            }
        </ul>
    }

    @if (comingUp.Count > 0)
    {
        @* A gentle pre-warning: Stocked items whose predicted run-out is within the next week, so a
           slower-moving item surfaces before it crosses into the (deliberately tight) Due-soon window
           and lands in Running Low. The grocery list's "Coming up" lists EVERY stocked item; this is the
           dashboard-sized near-term slice of the same idea. *@
        <section class="panel coming-up">
            <h2>Coming up this week</h2>
            <p class="muted">Not low yet, but likely due within the next week — here so a slower-moving item doesn't sneak up on you between trips.</p>
            <ul class="habit-list">
                @foreach (var p in comingUp)
                {
                    var r = predictions[p.Id];
                    <li>
                        <a href="/product/@p.Id" class="habit-name">@p.Name</a>
                        <span class="habit-note">@Urgency(r)</span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (runsOutEarly.Count > 0)
    {
        <section class="panel runs-out-early">
            <h2>You keep running out of these</h2>
            <p class="muted">You go through these faster than you rebuy them — worth buying sooner, or a bigger size.</p>
            <ul class="habit-list">
                @foreach (var p in runsOutEarly)
                {
                    var r = predictions[p.Id];
                    var gap = (int)Math.Round(r.RebuyBurnGapDays ?? 0);
                    <li>
                        <a href="/product/@p.Id" class="habit-name">@p.Name</a>
                        <span class="habit-note">lasts ~@Days(r.BurnRateDays) days but you rebuy ~every @Days(r.RebuyIntervalDays) — out ~@gap day@(gap == 1 ? "" : "s") each cycle</span>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="panel quick-update">
        <h2>Quick update</h2>
        <form @onsubmit="SendChat" @formname="quick-update">
            <input @bind="chatInput" @bind:event="oninput" placeholder="e.g. we're out of dog food, almost out of coffee"
                   aria-label="Quick update — say what you bought or ran low on" disabled="@chatBusy" />
            @* Disabled on busy ONLY — not on an empty box. The browser's implicit form submission
               (Enter in the input) no-ops when the default submit button is disabled, and the
               enable-on-first-keystroke round-trips the circuit, so a fast "type, Enter" lost the
               race and silently did nothing. SendChat already refuses a blank input. *@
            <button type="submit" disabled="@chatBusy">
                @(chatBusy ? "Working…" : "Send")
            </button>
        </form>
        <div role="status" aria-live="polite">
            @if (chatReply is not null)
            {
                <p class="@(chatError ? "error" : "chat-reply")">@chatReply</p>
            }
        </div>
        <div class="voice-divider"><span>or hold to talk</span></div>
        <PushToTalk OnApplied="LoadAsync" />
        <p class="muted small quick-update-hint">For a back-and-forth that keeps listening as you move around, use the 🎙 Assistant in the corner.</p>
    </section>

    <details class="everything-else">
        <summary>Everything else (@everythingElse.Count)</summary>
        @if (everythingElse.Count == 0)
        {
            <p class="muted">No other tracked products yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Item</th><th>Status</th><th>Why</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in everythingElse)
                    {
                        var r = predictions[p.Id];
                        <tr>
                            <td>@p.Name</td>
                            <td><span class="chip chip-@ChipClass(r.Status)">@StatusLabel(r.Status)</span></td>
                            <td class="muted">@(r.Status == PredictionStatus.Unknown ? LearningHint(p) : r.Basis)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </details>
}

@code {
    private List<Product>? products;
    private Dictionary<int, PredictionResult> predictions = [];
    private List<Product> runningLow = [];
    private List<Product> comingUp = [];
    private List<Product> everythingElse = [];
    private List<Product> runsOutEarly = [];

    // "Coming up this week": Stocked items whose predicted run-out is within this many days — the
    // dashboard's near-term slice of the grocery list's full "Coming up" (which lists every stocked item).
    private const int ComingUpHorizonDays = 7;

    private DateOnly today;

    private string chatInput = "";
    private string? chatReply;
    private bool chatError;
    private bool chatBusy;

    private int overdueCount => runningLow.Count(p => predictions[p.Id].Status == PredictionStatus.Overdue);
    private int dueSoonCount => runningLow.Count(p => predictions[p.Id].Status == PredictionStatus.DueSoon);

    protected override async Task OnInitializedAsync()
    {
        // The voice assistant now lives in the layout, so it can't call OnApplied directly. It pings the
        // coordinator after a voice data change; the dashboard reloads to reflect it.
        Coordinator.PantryChanged += OnPantryChangedAsync;
        await LoadAsync();
    }

    private async Task OnPantryChangedAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Coordinator.PantryChanged -= OnPantryChangedAsync;

    private async Task LoadAsync()
    {
        // A reload can empty the cards and a later one repopulate them; feedback from before the
        // reload must not survive that — above all the announcer, which would otherwise REMOUNT
        // already holding old text (the inserted-with-its-text shape it exists to avoid, and a
        // stale claim spoken minutes after the fact).
        copyNote = null;
        copyAnnouncement = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        products = await db.Products
            .AsNoTracking() // read-only view; Bought-today/Restocked write through their own contexts
            .Where(p => p.IsTracked)
            .Include(p => p.Purchases)
            .Include(p => p.Signals)
            .OrderBy(p => p.Name)
            .ToListAsync();

        today = DateOnly.FromDateTime(DateTime.Today);
        var trackExpirations = await SettingsStore.GetTrackExpirationDatesAsync();
        predictions = products.ToDictionary(p => p.Id, p => ReplenishmentPredictor.Predict(p, today, trackExpirations, honorQuantity: true));

        // Running Low = Overdue + DueSoon, signal-pinned first, then most overdue first (§8).
        runningLow = products
            .Where(p => predictions[p.Id].Status is PredictionStatus.Overdue or PredictionStatus.DueSoon)
            .OrderByDescending(p => predictions[p.Id].Pinned)
            .ThenByDescending(p => predictions[p.Id].Status)
            .ThenBy(p => predictions[p.Id].DueDate ?? DateOnly.MaxValue)
            .ThenBy(p => p.Name)
            .ToList();

        // "Coming up this week" — Stocked and predicted due within the horizon, so a slower-moving item
        // surfaces before it hits the (deliberately tight) DueSoon window. NOT fresh-counted items
        // (CountConfidence.Counted): you told the app how many you have, so a rhythm-based heads-up would
        // bother you about exactly what you're managing by count (item 28, "don't bother me while I track
        // quantity"). This is stronger than excluding only SuppressedByCount: suppression fires ONLY when
        // the rhythm would already ask (Overdue/DueSoon), so a fresh-counted item that's Stocked BY RHYTHM
        // isn't suppressed and would otherwise leak in. A STALE count (Aging/Spent) is NOT excluded — it's
        // no longer trusted, so it correctly defers to the rhythm and can appear here like any other item.
        comingUp = products
            .Where(p => predictions[p.Id] is { Status: PredictionStatus.Stocked, CountConfidence: not CountConfidence.Counted, DueDate: { } due }
                        && due > today && due <= today.AddDays(ComingUpHorizonDays))
            .OrderBy(p => predictions[p.Id].DueDate!.Value)
            .ThenBy(p => p.Name)
            .ToList();

        // Everything else: the remaining tracked items (Stocked or still-learning), minus the ones already
        // called out under "Coming up" — one item, one section.
        var comingUpIds = comingUp.Select(p => p.Id).ToHashSet();
        everythingElse = products
            .Where(p => predictions[p.Id].Status is PredictionStatus.Stocked or PredictionStatus.Unknown)
            .Where(p => !comingUpIds.Contains(p.Id))
            .ToList();

        // Habit insight, independent of due status: items you burn through faster than you rebuy them.
        runsOutEarly = products
            .Where(p => predictions[p.Id].RunsOutEarly)
            .OrderByDescending(p => predictions[p.Id].RebuyBurnGapDays)
            .ToList();
    }

    // Guards the quick-buy buttons against a double-tap while the save is in flight (the buttons also
    // disable via actionBusy). Note the cadence itself is already safe — the predictor collapses same-day
    // purchases — so this is about not recording a stray duplicate row / showing a snappy disabled state.
    private bool actionBusy;

    // The action just taken, offered for an inline "↩ Undo" (id + stored summary from the store's
    // recorded entry). One outstanding at a time, like the Ate-it notice; actionNote carries a rare
    // undo-failure reason.
    private (int Id, string Summary)? lastAction;
    private string? actionNote;

    // One purchase write path for every surface (dashboard, chat) — IPantryStore.AddPurchaseAsync, which
    // also records the undoable activity entry. Was an inline PurchaseEvents.Add here; consolidated so the
    // buy and its log entry are the one recorded path (plan §6).
    private async Task BoughtToday(Product p)
    {
        if (actionBusy) return;
        actionBusy = true;
        actionNote = null;
        try
        {
            var result = await Store.AddPurchaseAsync(p.Id, DateOnly.FromDateTime(DateTime.Today), 1, PurchaseSource.Manual);
            if (result.Recorded is { } rec) lastAction = (rec.Id, rec.Summary);
            await LoadAsync();
        }
        finally { actionBusy = false; }
    }

    // One restock write path for every surface (dashboard, grocery list, chat) — IPantryStore.
    private async Task Restocked(Product p)
    {
        if (actionBusy) return;
        actionBusy = true;
        actionNote = null;
        try
        {
            var rec = await Store.RecordSignalAsync(p.Id, SignalKind.Restocked);
            if (rec is not null) lastAction = (rec.Id, rec.Summary);
            await LoadAsync();
        }
        finally { actionBusy = false; }
    }

    // The inline undo reverses the last dashboard action through the ONE undo path (the /history page
    // uses the same ActivityLogService.UndoAsync). On the rare race where it's changed since, the notice
    // stays with a reason rather than silently doing nothing.
    private async Task UndoLast()
    {
        if (actionBusy || lastAction is not { } a) return;
        actionBusy = true;
        try
        {
            var outcome = await ActivityLog.UndoAsync(a.Id);
            if (outcome == UndoOutcome.Done)
            {
                lastAction = null;
                actionNote = null;
            }
            else
            {
                actionNote = "Couldn't undo that — it changed since. Check History.";
            }
            await LoadAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undoing the last dashboard action failed.");
            actionNote = "Couldn't undo just now — please try again.";
        }
        finally { actionBusy = false; }
    }

    private void DismissLast()
    {
        lastAction = null;
        actionNote = null;
    }

    private async Task SendChat()
    {
        if (chatBusy) return;
        if (string.IsNullOrWhiteSpace(chatInput))
        {
            // The button stays enabled on a blank box so the browser's implicit Enter-submission
            // works (it no-ops on a disabled default button) — so a blank send must answer with
            // SOMETHING, or an active-looking button does nothing in silence.
            chatReply = "Say what you bought or ran low on first — e.g. \"we're out of coffee\".";
            chatError = false;
            return;
        }
        chatBusy = true;
        chatReply = null;
        try
        {
            var result = await Chat.HandleAsync(chatInput);
            chatReply = result.Reply;
            chatError = !result.Success;
            if (result.Success)
            {
                chatInput = "";
                await LoadAsync(); // reflect new signals/purchases in the lists
                // A navigation tool ran ("show me the grocery list", "read me the ribs recipe") —
                // the reply stays visible for a beat via the aria-live region, then the page changes.
                if (result.NavigateTo is { } url) Nav.NavigateTo(url);
            }
        }
        finally
        {
            chatBusy = false;
        }
    }

    private (int ProductId, string Text)? copyNote; // one note at a time, tied to the card it is about
    private string? copyAnnouncement; // feeds the persistent live region beside the cards

    // Copies the bare item name — what pastes usefully into a store search; the brand/size hints
    // stay on the card.
    private async Task CopyName(Product p)
    {
        var ok = await ClipboardCopy.TryWriteAsync(JS, Logger, p.Name);
        copyNote = (p.Id, ok ? "Copied" : "Couldn't copy");
        copyAnnouncement = $"{copyNote.Value.Text} {p.Name}";
    }

    private static string Days(double? d) => d is { } v ? ((int)Math.Round(v)).ToString() : "?";

    private static string ChipClass(PredictionStatus s) => s switch
    {
        PredictionStatus.Overdue => "overdue",
        PredictionStatus.DueSoon => "duesoon",
        PredictionStatus.Stocked => "stocked",
        _ => "unknown"
    };

    private static string StatusLabel(PredictionStatus s) => s switch
    {
        PredictionStatus.Overdue => "Overdue",
        PredictionStatus.DueSoon => "Due soon",
        PredictionStatus.Stocked => "Stocked",
        _ => "Still learning"
    };

    // Translate the predicted run-out date into plain urgency — the answer to the app's one question.
    private string Urgency(PredictionResult r)
    {
        if (r.DueDate is not { } due) return "";
        var days = due.DayNumber - today.DayNumber;
        return days switch
        {
            < 0 => $"{-days} day{Plural(-days)} overdue",
            0 => "Due today",
            _ => $"Due in {days} day{Plural(days)}"
        };
    }

    private static string Plural(int n) => n == 1 ? "" : "s";

    // Honest thin-data message: how many more purchases until the engine can predict (needs ≥ 2
    // distinct purchase dates, §6.2). PURCHASES only — since the two-stream model, restocks anchor the
    // due date but never feed the rhythm, so counting them here promised predictions that never came.
    private static string LearningHint(Product p)
    {
        var distinctDates = p.Purchases.Select(x => x.PurchasedAt).Distinct().Count();
        var needed = 2 - distinctDates;
        return needed <= 0
            ? "still learning"
            : $"{needed} more purchase{Plural(needed)} to start predicting";
    }
}
