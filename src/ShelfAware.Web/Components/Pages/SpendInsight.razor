@page "/trends"
@using ShelfAware.Core.Domain
@using ShelfAware.Core.Prediction
@using ShelfAware.Core.Settings
@using ShelfAware.Core.Shopping
@inject IHouseholdDbFactory DbFactory
@inject IAppSettings SettingsStore

<PageTitle>Trends — Reginald</PageTitle>

<h1>Trends</h1>
<p class="muted">Grocery spend over time, and how each item's price is moving.</p>

@if (!loaded)
{
    <p>Loading…</p>
}
else
{
    <div class="portfolio">
        <div class="stat"><span class="stat-label">This month</span><span class="stat-value">@Money(thisMonth)</span></div>
        <div class="stat"><span class="stat-label">Last month</span><span class="stat-value">@Money(lastMonth)</span></div>
        <div class="stat"><span class="stat-label">This year</span><span class="stat-value">@Money(thisYear)</span></div>
        <div class="stat forecast">
            <span class="stat-label">Forecast · next month</span>
            <span class="stat-value">@Money(nextMonthForecast)</span>
        </div>
    </div>

    @if (tickers.Count == 0)
    {
        <p class="muted">No price history yet. Prices are read from confirmed receipts.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption class="visually-hidden">Price history and recent change for each product and size, highest yearly spend first.</caption>
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Category</th>
                        <th scope="col">Price history</th>
                        <th scope="col">Current</th>
                        <th scope="col">Change</th>
                        <th scope="col">Spend (yr)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in tickers)
                    {
                        @* One row per SIZE the product is bought in (most-bought first), so every chart,
                           current price and change is one size's story — never a bag against a single.
                           Spend is the product's, whatever size it came in, so it spans the size rows
                           rather than being split by size (a purchase priced from the all-sizes estimate
                           has no size series to sit on) or repeated (which would read as double). *@
                        @foreach (var (s, i) in t.Sizes.Select((size, idx) => (size, idx)))
                        {
                            <tr>
                                <td>
                                    <a href="/product/@t.ProductId">@t.Name</a>
                                    @if (s.SizeLabel is { } sz)
                                    {
                                        <span class="size-chip" title="This item is bought in more than one size — each size is charted on its own row, most-bought first">@sz</span>
                                    }
                                </td>
                                <td>@t.Category</td>
                                <td><LineChart Values="s.Prices" Stroke="@TrendColor(s)" AriaLabel="@SeriesLabel(t, s)" /></td>
                                <td>@Money(s.Current)</td>
                                <td>
                                    @if (s.PrevDelta is { } delta && s.PrevPct is { } pct)
                                    {
                                        <span class="@ChangeClass(delta)">@Arrow(delta) @Math.Abs(pct).ToString("0.#")%</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                @if (i == 0)
                                {
                                    <td rowspan="@(t.Sizes.Count > 1 ? t.Sizes.Count : (int?)null)">@Money(t.SpendThisYear)</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="muted">▲ = price went up since the previous purchase (costs more); ▼ = down. Spend is valued from receipt prices. Items bought in mixed sizes get one row per size (labelled, most-bought first), so a bag is never compared against a single; the spend covers every size.</p>
    }
}

@code {
    private bool loaded;
    private decimal thisMonth, lastMonth, thisYear, nextMonthForecast;
    private List<Ticker> tickers = [];

    /// <summary>One product's ticker: its yearly spend (every size) and one <see cref="SizeTicker"/> per
    /// size it is bought in, in <see cref="PriceSeries.BySize"/> rank order — most-bought first, so the
    /// first row is the SAME series Product Detail charts (its chart is that list's head).</summary>
    private record Ticker(int ProductId, string Name, Category Category, decimal SpendThisYear, List<SizeTicker> Sizes);

    /// <summary>One size's price story: the series charted, its latest price, and the move since the
    /// trip before. SizeLabel is null on a single-size product — a label there would be noise.</summary>
    private record SizeTicker(string? SizeLabel, List<decimal> Prices, decimal Current, decimal? PrevDelta, decimal? PrevPct);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var products = await db.Products
            .AsNoTracking() // read-only trends
            .Include(p => p.Purchases)
            .Include(p => p.Signals)
            .ToListAsync();

        var lineData = await db.ReceiptLines
            .Where(l => l.ProductId != null && l.UnitPrice != null)
            .Select(l => new { ProductId = l.ProductId!.Value, l.ReceiptId, l.Size, Price = l.UnitPrice!.Value, Date = l.Receipt!.PurchasedAt })
            .ToListAsync();

        // The ticker compares like with like: each size bucket's prices form their OWN series, one row
        // per size ($/bag never sits next to $/lime — that read as a 3,100% "price increase"), most-bought
        // first. Loose/"each" purchases share one bucket regardless of how many were bought (SizeBucket).
        // PriceSeries.BySize is the ONE definition — Product Detail charts its head (PriceSeries.Dominant)
        // and Reports' unit-price metric reads the same head — and it is empty when a product has no
        // positively-priced line (every line was $0 — a coupon/void/misread), so those products get no
        // ticker rather than an empty row.
        var seriesByProduct = lineData
            .GroupBy(x => x.ProductId)
            .Select(g => (g.Key, Series: PriceSeries.BySize(g.Select(x => new PricePoint(x.Size, x.Date, x.Price)).ToList())))
            .Where(x => x.Series.Count > 0)
            .ToDictionary(x => x.Key, x => x.Series);

        // Per size bucket with an all-sizes fallback, for valuing a purchase of a KNOWN size and for
        // pricing the forecast's recommended size — an $8 bag purchase shouldn't be valued at the
        // loose-lime average (ProductPriceIndex folds the loose/"each" spellings together).
        var priceIndex = new ProductPriceIndex(lineData.Select(x => (x.ProductId, x.Size, x.Price)));
        var byReceiptProduct = lineData
            .GroupBy(x => (x.ReceiptId, x.ProductId))
            .ToDictionary(g => g.Key, g => g.Average(x => x.Price));

        decimal? PriceFor(PurchaseEvent pe)
        {
            // The purchase's own receipt line is the exact paid price; the index is the estimate.
            if (pe.ReceiptId is { } rid && byReceiptProduct.TryGetValue((rid, pe.ProductId), out var p)) return p;
            return priceIndex.PriceFor(pe.ProductId, pe.Size);
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var firstThisMonth = new DateOnly(today.Year, today.Month, 1);
        var firstLastMonth = firstThisMonth.AddMonths(-1);
        var firstNextMonth = firstThisMonth.AddMonths(1);
        var lastNextMonth = firstNextMonth.AddMonths(1).AddDays(-1);

        var spendThisYearByProduct = new Dictionary<int, decimal>();
        foreach (var p in products)
        {
            foreach (var pe in p.Purchases)
            {
                if (PriceFor(pe) is not { } price) continue;
                var spend = price * pe.Quantity;
                if (pe.PurchasedAt.Year == today.Year && pe.PurchasedAt.Month == today.Month) thisMonth += spend;
                if (pe.PurchasedAt >= firstLastMonth && pe.PurchasedAt < firstThisMonth) lastMonth += spend;
                if (pe.PurchasedAt.Year == today.Year)
                {
                    thisYear += spend;
                    spendThisYearByProduct[p.Id] = spendThisYearByProduct.GetValueOrDefault(p.Id) + spend;
                }
            }
        }

        // Forecast next month: step each tracked item's due date by its interval through the window.
        var trackExpirations = await SettingsStore.GetTrackExpirationDatesAsync();
        foreach (var p in products.Where(p => p.IsTracked))
        {
            var prediction = ReplenishmentPredictor.Predict(p, today, trackExpirations, honorQuantity: true);
            if (prediction.MedianIntervalDays is not { } m) continue;
            // Price the size we'd actually tell the user to buy (same idea as the grocery list),
            // falling back to the all-sizes average when that size has no priced line.
            if (priceIndex.PriceFor(p.Id, prediction.RecommendedSize) is not { } price) continue;
            // The stepping — and the count-aware start date it begins from — is SpendForecast (Core), so
            // it's testable; this page keeps only the loading and the pricing.
            if (SpendForecast.FirstBuy(prediction) is not { } firstBuy) continue;

            var typicalQty = ShoppingEstimator.For(p, prediction, today, price).TypicalQuantity;
            nextMonthForecast += SpendForecast.InWindow(
                firstBuy, m, today, firstNextMonth, lastNextMonth, price * typicalQty);
        }

        foreach (var p in products)
        {
            if (!seriesByProduct.TryGetValue(p.Id, out var bySize)) continue;
            var sizes = new List<SizeTicker>(bySize.Count);
            foreach (var series in bySize)
            {
                var prices = series.Points.Select(pt => pt.UnitPrice).ToList();
                var current = prices[^1];
                decimal? delta = prices.Count >= 2 ? current - prices[^2] : null;
                decimal? pct = delta is { } dl && prices[^2] != 0 ? dl / prices[^2] * 100 : null;
                // Label the rows only when the product actually mixes sizes, so the reader can see
                // WHICH price is trending ("Limes · each") without noise on single-size products.
                var sizeLabel = bySize.Count > 1 ? series.SizeKey : null;
                sizes.Add(new SizeTicker(sizeLabel, prices, current, delta, pct));
            }
            tickers.Add(new Ticker(p.Id, p.Name, p.Category, spendThisYearByProduct.GetValueOrDefault(p.Id), sizes));
        }
        tickers = tickers.OrderByDescending(t => t.SpendThisYear).ThenBy(t => t.Name).ToList();
        loaded = true;
    }

    private static string Money(decimal amount) => amount.ToString("C");

    /// <summary>The sparkline's accessible name, naming the size when the product mixes sizes — the
    /// same "{name} price history, {size} size" shape Product Detail's chart uses.</summary>
    private static string SeriesLabel(Ticker t, SizeTicker s) =>
        $"{t.Name} price history{(s.SizeLabel is { } sz ? $", {sz} size" : "")}";

    // Grocery semantics: a price increase costs more (red), a decrease is cheaper (green).
    // `_ when` guards, not bare relational patterns: Razor reads a leading `<` as markup (docs/environment.md).
    private static string TrendColor(SizeTicker s) => s.PrevDelta switch
    {
        _ when s.PrevDelta > 0 => "var(--overdue-line)",
        _ when s.PrevDelta < 0 => "var(--stocked-line)",
        _ => "var(--accent)"
    };

    private static string ChangeClass(decimal delta) => delta > 0 ? "change-up" : delta < 0 ? "change-down" : "";

    private static string Arrow(decimal delta) => delta > 0 ? "▲" : delta < 0 ? "▼" : "→";
}
