@page "/list"
@using ShelfAware.Core.Chat
@using ShelfAware.Core.MealPlanning
@using ShelfAware.Core.Prediction
@using ShelfAware.Core.Recipes
@using ShelfAware.Core.Settings
@using ShelfAware.Core.Shopping
@using ShelfAware.Web.Undo
@implements IAsyncDisposable
@inject IHouseholdDbFactory DbFactory
@inject IAppSettings SettingsStore
@inject IPantryStore Store
@inject MealPlanService Planner
@inject LookalikeNudgeService Nudges
@inject ProductMergeService Merge
@inject ActivityLogService ActivityLog
@inject IJSRuntime JS
@inject ILogger<GroceryList> Logger

<PageTitle>Grocery List — Reginald</PageTitle>

<div class="page-head">
    <h1>Grocery List</h1>
    @if (loaded)
    {
        <span class="summary">
            <strong>Next run ≈ @Money(buyNowTotal)</strong>
            @if (buyNowUnknownCount > 0)
            {
                <span class="muted">+@buyNowUnknownCount with no price yet</span>
            }
        </span>
    }
</div>

@* Eggs flags two products on the list that look like the same thing and gently offers to merge them.
   The ask stays gentle the whole way; only his face + one line degrade the longer a pair lingers. *@
@foreach (var n in nudges)
{
    <section class="panel nudge nudge-@n.Mood.ToString().ToLowerInvariant()">
        <EggsMascot Mood="n.Mood" Size="72" />
        <div class="nudge-body">
            <p class="nudge-line">@NudgeMoods.Line(n.Mood)</p>
            <p class="nudge-pair"><strong>@n.Pair.LowerName</strong> and <strong>@n.Pair.HigherName</strong> look like the same thing — want to roll them into one? Keep:</p>
            <div class="nudge-actions">
                <button class="secondary" @onclick="() => MergeKeeping(n.Pair.LowerId, n.Pair.LowerName, n.Pair.HigherId, n.Pair.HigherName)" disabled="@nudgeBusy">@n.Pair.LowerName</button>
                <button class="secondary" @onclick="() => MergeKeeping(n.Pair.HigherId, n.Pair.HigherName, n.Pair.LowerId, n.Pair.LowerName)" disabled="@nudgeBusy">@n.Pair.HigherName</button>
                <button class="linkish" @onclick="() => DismissNudge(n)" disabled="@nudgeBusy">They're different</button>
            </div>
        </div>
    </section>
}
@if (mergedNotice is { } mn)
{
    <section class="panel callout ok nudge-done">
        <span>@mn.Message</span>
        <button class="linkish" @onclick="UndoMerge" disabled="@nudgeBusy">↩ Undo</button>
    </section>
}
@if (nudgeError is not null)
{
    <p class="error" role="alert">@nudgeError</p>
}

<section class="panel extras">
    <h2>Extras <span class="muted">— add anything manually, or from a recipe</span></h2>
    <div class="tag-list">
        @foreach (var e in extras)
        {
            <span class="tag-chip">@e.Name<button type="button" class="tag-x" @onclick="() => RemoveExtra(e)" aria-label="Remove @e.Name">×</button></span>
        }
        @if (extras.Count == 0)
        {
            <span class="muted">Nothing extra yet.</span>
        }
    </div>
    <div class="tag-add">
        <input placeholder="+ add an item" @bind="newExtra" @bind:event="oninput" aria-label="Add an item to the grocery list" />
        <button type="button" @onclick="AddExtra" disabled="@string.IsNullOrWhiteSpace(newExtra)">Add</button>
    </div>
</section>

@if (loaded && buyNow.Count > 0)
{
    <div class="list-actions">
        <button class="secondary" @onclick="CopyList">Copy list</button>
        <button class="secondary" @onclick="PrintList">Print</button>
        <button class="secondary" @onclick="DownloadList">Download</button>
        <span class="muted kbd-hint">press <kbd>D</kbd> to download</span>
        @* Persistent live region (mounted before any copy) — see the same pattern on the dashboard
           cards: an inserted-with-its-text region is not reliably announced. *@
        <span class="visually-hidden copy-announcer" role="status" aria-live="polite">@copyStatus</span>
        @if (copyStatus is not null)
        {
            <span class="muted copy-note">@copyStatus</span>
        }
    </div>
}

@if (!loaded)
{
    <p>Loading…</p>
}
else if (buyNow.Count == 0 && comingUp.Count == 0 && learning.Count == 0)
{
    <p class="muted">No tracked products yet. Add some on the <a href="/products">Products</a> page.</p>
}
else
{
    @if (buyNow.Count > 0)
    {
        <h2>Buy now <span class="muted">— @buyNow.Count item@(buyNow.Count == 1 ? "" : "s")</span></h2>
        @ReportTable(buyNow, buyNowTotal, buyNowUnknownCount, canIgnore: true)
    }

    @if (comingUp.Count > 0)
    {
        <h2>Coming up</h2>
        @ReportTable(comingUp, comingUpTotal, comingUpUnknownCount, canIgnore: false)
    }

    @if (buyNow.Count > 0 && comingUp.Count > 0)
    {
        <p class="grand-total"><strong>Everything tracked: @Money(buyNowTotal + comingUpTotal)</strong> <span class="muted">(known prices)</span></p>
    }

    @if (learning.Count > 0)
    {
        <details class="everything-else">
            <summary>Still learning (@learning.Count)</summary>
            <p class="muted">No estimate yet — buy each a couple of times and it'll move up: @string.Join(", ", learning.Select(e => e.Name)).</p>
        </details>
    }
}

@code {
    private bool loaded;
    private List<GroceryRow> buyNow = [];
    private List<GroceryRow> comingUp = [];
    private List<ProductEstimate> learning = [];
    private decimal buyNowTotal, comingUpTotal;
    private int buyNowUnknownCount, comingUpUnknownCount;

    private List<GroceryExtra> extras = [];
    private string newExtra = "";

    private List<LookalikeNudge> nudges = [];
    private (int EntryId, string Message)? mergedNotice;
    private string? nudgeError;
    private bool nudgeBusy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        extras = await db.GroceryExtras.OrderBy(e => e.Name).ToListAsync();
        var products = await db.Products
            .AsNoTracking() // read-only list
            .Where(p => p.IsTracked)
            .Include(p => p.Purchases)
            .Include(p => p.Signals)
            .Include(p => p.Tags)
            .OrderBy(p => p.Name)
            .ToListAsync();

        var priceLines = await db.ReceiptLines
            .Where(l => l.ProductId != null && l.UnitPrice != null)
            .Select(l => new { Id = l.ProductId!.Value, l.Size, Price = l.UnitPrice!.Value })
            .ToListAsync();
        // Price the recommended (dominant) size specifically, not a blend across every size bought —
        // so a half-gallon-vs-gallon item estimates the size we actually tell you to buy.
        // ProductPriceIndex folds the loose/"each" spellings together (per-each produce matches a
        // null recommended size) and falls back to the product's overall average.
        var prices = new ProductPriceIndex(priceLines.Select(x => (x.Id, x.Size, x.Price)));

        var today = DateOnly.FromDateTime(DateTime.Today);
        var trackExpirations = await SettingsStore.GetTrackExpirationDatesAsync();
        var all = products.Select(p =>
        {
            var prediction = ReplenishmentPredictor.Predict(p, today, trackExpirations, honorQuantity: true);
            return ShoppingEstimator.For(p, prediction, today, prices.PriceFor(p.Id, prediction.RecommendedSize));
        }).ToList();

        // The plan's shop items (§6): ingredients the current meal plan needs in the next couple of weeks
        // that you don't have. Derived every load — reality (the same on-hand set the recipe pages use) is an
        // input, so this can't contradict a real signal and writes nothing back.
        var onHand = PantryOnHand.EdibleInStock(products, today, trackExpirations)
            .Select(p => new PantryProduct(p.Name, p.Substitutes.Select(s => s.Value).ToList()))
            .ToList();
        var plannedMeals = (await Planner.GetCurrentPlanAsync())?.Meals
            .Select(m => new PlannedMealView(
                m.Date, m.Slot, m.Recipe!.Name,
                [.. m.Recipe.MainIngredients.Select(i => new PlannedIngredient(i.Name, i.MatchedProduct))]))
            .ToList() ?? [];
        var planItems = MealPlanProjection.ShopItems(plannedMeals, onHand, today);

        // Combine the two provenances into one set of rows (the ONE definition, shared with the dashboard),
        // deduped by food so a product wanted by both shows once. Still-learning items stay predictor-only.
        var board = GroceryBoard.Combine(all.Where(e => e.Status != PredictionStatus.Unknown).ToList(), planItems);

        // Both tables ordered by aisle (category) so the whole page matches how you walk a store, then by
        // urgency within each aisle. Plan-only rows have no known aisle, so they fall to the end. The date
        // column still carries the chronology.
        buyNow = board.Where(r => r.BuyNow).OrderBy(SortAisle).ThenBy(r => r.DaysUntil ?? int.MaxValue).ThenBy(r => r.Name).ToList();
        comingUp = board.Where(r => !r.BuyNow).OrderBy(SortAisle).ThenBy(r => r.DaysUntil ?? int.MaxValue).ThenBy(r => r.Name).ToList();
        learning = all
            .Where(e => e.Status == PredictionStatus.Unknown)
            .OrderBy(e => e.Name)
            .ToList();

        buyNowTotal = buyNow.Sum(r => r.Estimate?.ExpectedCost ?? 0m);
        comingUpTotal = comingUp.Sum(r => r.Estimate?.ExpectedCost ?? 0m);
        buyNowUnknownCount = buyNow.Count(r => r.Estimate?.ExpectedCost is null);
        comingUpUnknownCount = comingUp.Count(r => r.Estimate?.ExpectedCost is null);

        // Eggs's lookalike nudges. Every tracked product shows somewhere on this page (buy-now, coming-up,
        // or still-learning), so the whole tracked set IS "the list" the detector runs over. The service
        // remembers when each pair was first flagged (for the mood) and honours any dismissal.
        nudges = [.. await Nudges.GetActiveAsync(products, DateTimeOffset.Now)];

        loaded = true;
    }

    // Merge a lookalike pair the gentle way: the user picks which name to KEEP, and the other folds into it
    // through the ONE undoable merge path (ProductMergeService). The result carries an inline ↩ Undo — the
    // SAME reversal /history runs — so a wrong guess is one tap back.
    private async Task MergeKeeping(int keepId, string keepName, int dropId, string dropName)
    {
        if (nudgeBusy) return;
        nudgeBusy = true;
        nudgeError = null;
        try
        {
            var result = await Merge.MergeAsync(sourceId: dropId, targetId: keepId);
            if (result.Ok)
                mergedNotice = (result.UndoEntryId, $"Merged {dropName} into {keepName}.");
            else
                nudgeError = result.Message;
            await LoadAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Merging a lookalike pair failed.");
            nudgeError = "Couldn't merge just now — please try again.";
        }
        finally { nudgeBusy = false; }
    }

    // "They're different" — a permanent, per-pair dismissal Eggs remembers (and surfaces on each product's
    // page, where it can be undone). He stops nudging about this pair.
    private async Task DismissNudge(LookalikeNudge n)
    {
        if (nudgeBusy) return;
        nudgeBusy = true;
        nudgeError = null;
        try
        {
            await Nudges.DismissAsync(n.Pair.LowerId, n.Pair.HigherId, DateTimeOffset.Now);
            await LoadAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dismissing a lookalike nudge failed.");
            nudgeError = "Couldn't dismiss just now — please try again.";
        }
        finally { nudgeBusy = false; }
    }

    // Undo the last merge inline, through the ONE undo path. On the rare race where it's changed since, the
    // notice stays with a reason rather than silently doing nothing (the dashboard's UndoLast pattern).
    private async Task UndoMerge()
    {
        if (nudgeBusy || mergedNotice is not { } mn) return;
        nudgeBusy = true;
        nudgeError = null;
        try
        {
            var outcome = await ActivityLog.UndoAsync(mn.EntryId);
            mergedNotice = null;
            if (outcome != UndoOutcome.Done)
                nudgeError = "Couldn't undo that — it changed since. Check History.";
            await LoadAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undoing a lookalike merge failed.");
            nudgeError = "Couldn't undo just now — please try again.";
        }
        finally { nudgeBusy = false; }
    }

    // Sort key for the aisle walk: a row's category, with un-categorized plan rows falling after every real
    // aisle (int.MaxValue) rather than jumping to the front.
    private static int SortAisle(GroceryRow r) => r.Category is { } c ? (int)c : int.MaxValue;

    // Column sort. The DEFAULT — and the third "un-sort" click — is the aisle-walk order buyNow/comingUp are
    // built in (walk the store once); a header click re-sorts BOTH tables the same way and is saved per
    // device (via the shared TableSortController). No tiebreak, so ties keep the aisle-walk order (OrderBy is
    // stable). Plan rows have no rhythm: status sorts them to the front (-1); qty/cost to the end (MaxValue).
    private readonly TableSortController sort = new("grocery", "item", "category", "status", "nextbuy", "qty", "cost");

    private IComparable? GroceryKey(GroceryRow r) => sort.Sort.Column switch
    {
        "item" => r.Name,
        "category" => SortAisle(r),
        "status" => r.Estimate is { } e ? (int)e.Status : -1,
        "nextbuy" => r.DueDate ?? DateOnly.MaxValue,
        "qty" => r.Estimate?.RecommendedQuantity ?? decimal.MaxValue,
        "cost" => r.Estimate?.ExpectedCost ?? decimal.MaxValue,
        _ => r.Name,
    };

    private Task SortBy(string column) => sort.ToggleAsync(column);

    private RenderFragment ReportTable(List<GroceryRow> rows, decimal subtotal, int unknownCount, bool canIgnore) =>
        @<div class="table-scroll">
            <table>
                <caption class="visually-hidden">Grocery items with source, category, replenishment status, next buy date, quantity, and estimated cost.</caption>
                <thead>
                    <tr>
                        <SortableHeader Column="item" Label="Item" Sort="sort.Sort" OnSort="SortBy" />
                        <SortableHeader Column="category" Label="Category" Sort="sort.Sort" OnSort="SortBy" />
                        <SortableHeader Column="status" Label="Status" Sort="sort.Sort" OnSort="SortBy" />
                        <SortableHeader Column="nextbuy" Label="Next buy" Sort="sort.Sort" OnSort="SortBy" />
                        <SortableHeader Column="qty" Label="Qty" Sort="sort.Sort" OnSort="SortBy" />
                        <SortableHeader Column="cost" Label="Est. cost" Sort="sort.Sort" OnSort="SortBy" />
                        @if (canIgnore)
                        {
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in sort.Sort.Order(rows, GroceryKey))
                    {
                        @if (r.Source == ShoppingSource.Predictor)
                        {
                            var e = r.Estimate!;
                            <tr>
                                <td>
                                    <a class="item-name" href="/product/@e.ProductId">@e.Name</a>
                                    @if (e.RecommendedSize is { Length: > 0 } || e.UsualBrand is not null || e.UsualVariety is not null || e.Tags.Count > 0 || r.PlanFor is not null)
                                    {
                                        <div class="item-meta">
                                            @if (e.RecommendedSize is { Length: > 0 } sz)
                                            {
                                                <span class="size-chip" title="Suggested size to buy">@sz</span>
                                            }
                                            <BrandVarietyHint UsualBrand="@e.UsualBrand" UsualVariety="@e.UsualVariety"
                                                              Brands="@e.BrandsBought" Varieties="@e.VarietiesBought" />
                                            @foreach (var t in e.Tags)
                                            {
                                                <a class="tag-chip tag-chip-mini" href="/products?tag=@Uri.EscapeDataString(t)" title="See all @t products">@t</a>
                                            }
                                            @if (r.PlanFor is { } pf)
                                            {
                                                <span class="plan-for" title="Your meal plan needs this too">also for @MealHint(pf)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>@e.Category</td>
                                <td><span class="chip chip-@ChipClass(e.Status)">@StatusLabel(e.Status)</span></td>
                                <td>
                                    @if (e.CountNote is { } note)
                                    {
                                        @* The due date is deliberately left untouched by suppression, so
                                           printing it raw here would read "Stocked · 3 days overdue" on one
                                           row. CountNote is the one shared phrasing — the products grid
                                           reads the same string. §13.5 also asks for a one-tap correction
                                           WHERE the claim is made, so the fix is at hand rather than a page
                                           away: one package off, the same amount "Ate it" and the product
                                           page take, and the row returns to the buy list once it hits zero. *@
                                        <span>@note</span>
                                        <button type="button" class="linkish" @onclick="() => UsedOne(e)"
                                                disabled="@actionBusy"
                                                title="Take one off — @QuantityFormat.Describe(e.OnePackage, e.DefaultUnit) of @e.Name"
                                                aria-label="Used one @e.Name — correct the count without leaving the list">Used one</button>
                                    }
                                    else
                                    {
                                        @(r.DueDate is { } d ? d.ToString("MMM d") : "—")
                                        @if (r.DaysUntil is { } du)
                                        {
                                            <span class="muted"> (@Relative(du))</span>
                                        }
                                    }
                                </td>
                                <td>@e.RecommendedQuantity.ToString("0.##")</td>
                                <td>@(e.ExpectedCost is { } c ? Money(c) : "—")</td>
                                @if (canIgnore)
                                {
                                    <td class="row-actions">
                                        <button type="button" class="restock-btn" @onclick="() => Restocked(e)"
                                                disabled="@actionBusy"
                                                title="Just bought or got more @e.Name — a FRESH supply, so its next due date re-anchors a full cycle out"
                                                aria-label="Mark @e.Name restocked — a fresh supply">Restocked</button>
                                        <button type="button" class="stillstock-btn" @onclick="() => StillInStock(e)"
                                                disabled="@actionBusy"
                                                title="Still have some @e.Name — the reminder was early. Snoozes it a few days rather than assuming a fresh supply"
                                                aria-label="Mark @e.Name still in stock — you were early, snooze it">Still in stock</button>
                                        <button type="button" class="untrack-btn" @onclick="() => Untrack(e)"
                                                disabled="@actionBusy"
                                                title="Don't want @e.Name for a while — stops suggesting it until you buy it again (history kept)"
                                                aria-label="Untrack @e.Name — stop suggesting it until it's bought again">Untrack</button>
                                    </td>
                                }
                            </tr>
                        }
                        else
                        {
                            @* A plan-sourced row: an ingredient a planned meal needs that you don't have. Leaner
                               than a predictor row (no rhythm, cost, size or actions — it's derived from the plan),
                               tinted + tagged so it reads as plan-driven at a glance and to a screen reader. *@
                            <tr class="grocery-src-plan">
                                <td>
                                    <span class="item-name">@r.Name</span>
                                    @if (r.PlanFor is { } pf)
                                    {
                                        <div class="item-meta"><span class="plan-for">for @MealHint(pf)</span></div>
                                    }
                                </td>
                                <td class="muted">—</td>
                                <td><span class="chip chip-plan">Plan</span></td>
                                <td>
                                    @(r.DueDate is { } d ? d.ToString("MMM d") : "—")
                                    @if (r.DaysUntil is { } du)
                                    {
                                        <span class="muted"> (@Relative(du))</span>
                                    }
                                </td>
                                <td class="muted">—</td>
                                <td class="muted">—</td>
                                @if (canIgnore)
                                {
                                    <td></td>
                                }
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="subtotal-label">Subtotal@(unknownCount > 0 ? $" ({unknownCount} without a price)" : "")</td>
                        <td class="subtotal">@Money(subtotal)</td>
                        @if (canIgnore)
                        {
                            <td></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>;

    // A compact "for Beef Tacos, Thu" hint for a plan row / annotation.
    private static string MealHint(PlanShopItem pf) => $"{pf.RecipeName}, {pf.MealDate:ddd}";

    private bool actionBusy;

    // Three row actions with genuinely different meanings, all real while staring at the list:
    // • Restocked = "I just bought/got more" — a FRESH supply, so it re-anchors the due date a full cycle
    //   out (status-only: §6 two-stream model, it never feeds the cadence). Same write as the dashboard's.
    // • Still in stock = "I never ran out — you were early" — the OLD stock, not a fresh supply, so the
    //   engine snoozes a modest slice of the cadence instead of re-anchoring (which would go silent while
    //   the leftovers run out). The honest half of what "Restocked" used to be asked to cover.
    // • Untrack = "don't want it for a while" — stops tracking, so the item leaves the list and dashboard
    //   until a purchase brings it back (any recorded purchase re-tracks automatically; the Products
    //   checkbox and set_tracking tool also work). History is kept.
    private async Task Restocked(ProductEstimate e)
    {
        if (actionBusy) return;
        actionBusy = true;
        try
        {
            copyStatus = null; // the copied list is now stale
            await Store.RecordSignalAsync(e.ProductId, SignalKind.Restocked);
            await LoadAsync();
        }
        finally { actionBusy = false; }
    }

    private async Task StillInStock(ProductEstimate e)
    {
        if (actionBusy) return;
        actionBusy = true;
        try
        {
            copyStatus = null; // the copied list is now stale
            await Store.RecordSignalAsync(e.ProductId, SignalKind.StillInStock);
            await LoadAsync();
        }
        finally { actionBusy = false; }
    }

    private async Task Untrack(ProductEstimate e)
    {
        if (actionBusy) return;
        actionBusy = true;
        try
        {
            copyStatus = null; // the copied list is now stale
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.Products.FindAsync(e.ProductId) is { } product)
            {
                product.IsTracked = false;
                await db.SaveChangesAsync();
            }
            await LoadAsync();
        }
        finally { actionBusy = false; }
    }

    /// <summary>§13.5's one-tap correction, offered WHERE the count is claimed. A row saying "You have 4"
    /// is the moment a household notices the number is wrong, and sending them to another page to fix it
    /// is how a count stops being maintained. Takes one package — <see cref="ProductEstimate.OnePackage"/>,
    /// the same amount "Ate it" and the product page take, so no surface disagrees about what "one" is —
    /// through the ONE quantity write path. Relative, so it moves the number without renewing the
    /// attestation (§13.1: only a look re-anchors the clock); reaching zero is the exception and records
    /// the outage, exactly as on the product page.</summary>
    private async Task UsedOne(ProductEstimate e)
    {
        if (actionBusy) return;
        actionBusy = true;
        try
        {
            copyStatus = null; // the copied list is now stale
            await Store.SetQuantityAsync(e.ProductId, -e.OnePackage, relative: true);
            await LoadAsync();
        }
        finally { actionBusy = false; }
    }

    private async Task AddExtra()
    {
        var name = newExtra.Trim();
        if (name.Length == 0) return;
        copyStatus = null; // the copied list is now stale
        await Store.AddGroceryExtrasAsync([name]); // dedupes existing + logs a GroceryExtrasAdded
        newExtra = "";
        await using var db = await DbFactory.CreateDbContextAsync();
        extras = await db.GroceryExtras.OrderBy(e => e.Name).ToListAsync();
    }

    private async Task RemoveExtra(GroceryExtra e)
    {
        copyStatus = null; // the copied list is now stale
        // Through the store: removes it (household-filtered — a miss is a no-op, not an error) and logs an
        // undoable GroceryExtraRemoved, so an accidental removal can be taken back.
        await Store.RemoveGroceryExtraAsync(e.Id);
        await using var db = await DbFactory.CreateDbContextAsync();
        extras = await db.GroceryExtras.OrderBy(x => x.Name).ToListAsync();
    }

    private string? copyStatus;

    private IJSObjectReference? downloadModule;
    private DotNetObjectReference<GroceryList>? selfRef;

    // Wire the "D" download shortcut once the page is interactive. The module + self-reference are cleaned
    // up in DisposeAsync so the listener doesn't outlive the page.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            downloadModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/download.js");
            selfRef = DotNetObjectReference.Create(this);
            await downloadModule.InvokeVoidAsync("registerShortcut", selfRef, "d");

            if (await sort.LoadAsync(JS)) StateHasChanged();
        }
        catch (JSDisconnectedException) { /* circuit gone before wiring — nothing to clean up yet */ }
    }

    [JSInvokable]
    public Task OnDownloadShortcut() => DownloadList();

    private async Task CopyList()
    {
        copyStatus = await ClipboardCopy.TryWriteAsync(JS, Logger, BuildListText())
            ? "Copied to clipboard"
            : "Couldn't copy";
    }

    private async Task PrintList() => await JS.InvokeVoidAsync("window.print");

    private async Task DownloadList()
    {
        downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/download.js");
        var name = $"grocery-list-{DateOnly.FromDateTime(DateTime.Today):yyyy-MM-dd}.txt";
        await downloadModule.InvokeVoidAsync("downloadText", name, BuildListText());
    }

    public async ValueTask DisposeAsync()
    {
        if (downloadModule is not null)
        {
            try
            {
                await downloadModule.InvokeVoidAsync("unregister");
                await downloadModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
        await sort.DisposeAsync();
        selfRef?.Dispose();
    }

    private string BuildListText()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Grocery List — {DateOnly.FromDateTime(DateTime.Today):yyyy-MM-dd}");
        sb.AppendLine($"Buy now (~{Money(buyNowTotal)}):");
        foreach (var r in buyNow)
        {
            if (r.Estimate is { } e)
            {
                var qualifiers = new List<string>();
                if (e.UsualBrand is { } b) qualifiers.Add(b);
                if (e.UsualVariety is { } v) qualifiers.Add(v);
                if (e.RecommendedSize is { Length: > 0 } s) qualifiers.Add(s);
                var q = qualifiers.Count > 0 ? $" ({string.Join(", ", qualifiers)})" : "";
                var cost = e.ExpectedCost is { } c ? $" — {Money(c)}" : "";
                var planNote = r.PlanFor is { } pf ? $" (also for {pf.RecipeName})" : "";
                sb.AppendLine($"- {e.Name}{q} ×{e.RecommendedQuantity:0.##}{cost}{planNote}");
            }
            else
            {
                sb.AppendLine($"- {r.Name}{(r.PlanFor is { } pf ? $" (for {pf.RecipeName})" : "")}");
            }
        }
        if (extras.Count > 0)
        {
            sb.AppendLine("Extras:");
            foreach (var x in extras) sb.AppendLine($"- {x.Name}");
        }
        return sb.ToString();
    }

    private static string Money(decimal amount) => amount.ToString("C");

    private static string Relative(int days) => days switch
    {
        < 0 => $"{-days} day{P(-days)} overdue",
        0 => "today",
        _ => $"in {days} day{P(days)}"
    };

    private static string P(int n) => n == 1 ? "" : "s";

    private static string ChipClass(PredictionStatus s) => s switch
    {
        PredictionStatus.Overdue => "overdue",
        PredictionStatus.DueSoon => "duesoon",
        PredictionStatus.Stocked => "stocked",
        _ => "unknown"
    };

    private static string StatusLabel(PredictionStatus s) => s switch
    {
        PredictionStatus.Overdue => "Overdue",
        PredictionStatus.DueSoon => "Due soon",
        PredictionStatus.Stocked => "Stocked",
        _ => "Still learning"
    };
}
