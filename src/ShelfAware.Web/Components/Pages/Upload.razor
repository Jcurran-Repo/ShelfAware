@page "/receipt"
@implements IAsyncDisposable
@using Microsoft.Extensions.Options
@using ShelfAware.Core.Census
@using ShelfAware.Core.Chat
@using ShelfAware.Core.Extraction
@using ShelfAware.Core.Ingest
@using ShelfAware.Core.Settings
@using ShelfAware.Core.Tagging
@using ShelfAware.Core.Shopping
@using ShelfAware.Llm
@using ShelfAware.Web.Ingest
@inject IHouseholdDbFactory DbFactory
@inject ITagAdvisor Advisor
@inject ReceiptIngestionService Ingestion
@inject ReceiptConfirmationService Confirmer
@inject ReceiptAutoConfirmer AutoConfirmer
@inject ReceiptDuplicateDetector Duplicates
@inject ReceiptRemovalService Removal
@inject IAppSettings SettingsStore
@inject IJSRuntime JS
@inject AntiforgeryStateProvider Antiforgery
@inject IOptions<LlmOptions> Llm
@inject ILogger<Upload> Logger

<PageTitle>Upload receipt — Shelf Aware</PageTitle>

<h1>Upload receipt</h1>

@if (phase is Phase.Idle or Phase.Error)
{
    <section class="panel">
        <p>
            Photograph paper receipts — several at once is fine, each image is read as its own receipt.
            Screenshots and print-to-PDF order pages also work. For one long receipt split across
            several photos, tick the box below and they'll be merged.
        </p>
        @if (uploadMode == ImportMode.Smart)
        {
            <p class="muted">
                Smart confirm is on: a receipt is recorded automatically when every line matches
                something you already buy — anything uncertain waits for your review below.
                Change this in <a href="/settings">Settings</a>.
            </p>
        }
        else if (uploadMode == ImportMode.Auto)
        {
            <p class="muted">
                Confirm-everything is on: uploads are recorded straight away, new products included.
                Change this in <a href="/settings">Settings</a>.
            </p>
        }
        @* A plain file input plus a mount that photo-upload.js fills — CLIENT-SIDE — with the staged list,
           the "one receipt" checkbox, and the Extract button. That whole flow runs off the SignalR circuit,
           so a mobile pick that drops the circuit still shows the photo AND its Extract button (the bug this
           fixes: the filename — or nothing — appeared but no button, because the staged list rode the
           circuit). The photo is resized in the browser and POSTed to /api/receipts/extract off the circuit;
           only the review screen that follows (OnExtracted) needs the circuit, and the module retries that
           until it's back.
           No `accept` filter, on purpose: iOS greys out HEIC when the picker is type-restricted; the
           module resizes whatever the browser can decode (HEIC included) and takes PDFs as-is.
           ⚠️ Never add accept="image/heic" here: Safari 17+ then stops transcoding and converts JPEG
           and PNG INTO HEIC, making the rare case universal. *@
        <input type="file" @ref="fileInput" multiple aria-label="Upload receipt photos or a PDF" />
        <div @ref="stagingMount"></div>
        @if (batch.Count > 0)
        {
            <ul class="batch-progress" aria-label="Receipt extraction results">
                @foreach (var b in batch)
                {
                    <li>
                        <span class="batch-icon" aria-hidden="true">@BatchIcon(b.Status)</span>
                        <span class="batch-name">@b.FileName</span>
                        <span class="@(b.Status == BatchStatus.Failed ? "error" : "muted")" role="status">@BatchNote(b)</span>
                    </li>
                }
            </ul>
        }
        @if (phase == Phase.Error)
        {
            <p class="error" role="alert">@errorMessage</p>
        }
    </section>

    @* Error included: with reads at selection time, a single refused file reaches Phase.Error —
       far more often than the old >MaxFiles case — and hiding the review queue behind it read as
       the queued receipts being LOST. Only Extracting (whose progress list owns the screen) and
       the review/done phases still stand the queue down. *@
    @if (phase is Phase.Idle or Phase.Error && pendingReceipts.Count > 0)
    {
        <section class="panel">
            <h2>Waiting for review (@pendingReceipts.Count)</h2>
            <p class="muted">Imports held for your approval, plus any receipt that couldn't be read.</p>
            <ul class="pending-receipts">
                @foreach (var pr in pendingReceipts)
                {
                    <li>
                        <span>
                            <strong>@(pr.Merchant ?? "Unknown merchant")</strong>
                            @if (pr.LineCount == 0)
                            {
                                <span class="error"> · couldn't be read — retry or discard</span>
                            }
                            else
                            {
                                <span class="muted"> · @(pr.PurchasedAt?.ToString("MMM d, yyyy") ?? "no date") · @pr.LineCount item(s)</span>
                            }
                            @if (pr.PossibleDuplicate)
                            {
                                <span class="chip chip-duesoon" title="Same date, items, and prices as a receipt you already confirmed">possible duplicate</span>
                            }
                        </span>
                        <span class="pending-actions">
                            @if (pr.LineCount == 0)
                            {
                                <button @onclick="() => RetryPending(pr.Id)" disabled="@(retryingId is not null)"
                                        aria-label="Retry reading receipt from @(pr.Merchant ?? "unknown merchant")">
                                    @(retryingId == pr.Id ? "Retrying…" : "Retry")
                                </button>
                            }
                            else
                            {
                                <button @onclick="() => ReviewPending(pr.Id)">Review</button>
                            }
                            <button class="secondary" @onclick="() => DiscardPending(pr.Id)" disabled="@(retryingId is not null)" aria-label="Discard receipt from @(pr.Merchant ?? "unknown merchant")">Discard</button>
                        </span>
                    </li>
                }
            </ul>
            @if (pendingError is not null)
            {
                <p class="error" role="alert">@pendingError</p>
            }
        </section>
    }
}
else if (phase == Phase.Review && receipt is not null)
{
    <section class="panel">
        <p>
            <strong>@(receipt.Merchant ?? "Unknown merchant")</strong> — @reviewLines.Count item(s). Review and correct before confirming.
        </p>
        @if (duplicateOf is { } dupe)
        {
            <p class="error" role="alert">
                ⚠️ This looks like an <strong>exact duplicate</strong> of the
                @(dupe.Merchant is { Length: > 0 } dm ? dm : "confirmed") receipt from
                @(dupe.PurchasedAt?.ToString("MMM d, yyyy") ?? "the same day") — same items, same prices
                (see it on the <a href="/receipts">Receipts</a> page). If you really bought this twice,
                “Confirm all” records it anyway; otherwise Discard it below.
            </p>
        }
        <p class="review-date">
            <label for="receipt-date"><strong>Purchase date</strong></label>
            <input id="receipt-date" type="date" @bind="reviewDate"
                   max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
            @if (receipt.PurchasedAt is null)
            {
                <span class="error">No date detected — set the actual purchase date so refill timing stays accurate.</span>
            }
            else
            {
                <span class="muted">Detected from the receipt. Correct it if it's wrong — this drives the refill predictions.</span>
            }
        </p>
        @if (reviewLines.Count == 0)
        {
            <p class="error">No purchasable items were found — this may not be a receipt. You can discard it below.</p>
        }
        <div class="table-scroll table-scroll--capped">
        <table>
            <thead>
                <tr>
                    <th scope="col">Receipt text</th>
                    <th scope="col">Item</th>
                    <th scope="col">Brand</th>
                    <th scope="col">Size</th>
                    <th scope="col">Variety</th>
                    @if (trackExpirations)
                    {
                        <th scope="col">Expires</th>
                    }
                    <th scope="col">Qty</th>
                    <th scope="col">Category</th>
                    <th scope="col">Tags</th>
                    <th scope="col">Product match</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in reviewLines)
                {
                    <tr class="@(line.Confidence < 0.6m ? "low-confidence" : "")">
                        <td class="raw">
                            @line.RawText
                            <div>
                                <span class="chip chip-@(line.Confidence < 0.6m ? "duesoon" : "stocked")"
                                      title="How confident the extraction was in this line">
                                    @line.Confidence.ToString("P0") sure
                                </span>
                            </div>
                        </td>
                        <td><input @bind="line.NormalizedName" aria-label="Item name for @line.RawText" /></td>
                        <td><input @bind="line.Brand" size="12" placeholder="—" aria-label="Brand for @line.RawText" /></td>
                        <td><input @bind="line.Size" size="8" placeholder="—" aria-label="Size for @line.RawText" /></td>
                        <td><input @bind="line.Variety" size="10" placeholder="—" aria-label="Variety for @line.RawText" /></td>
                        @if (trackExpirations)
                        {
                            <td class="expires-cell">
                                <input type="date" @bind="line.ExpirationDate" aria-label="Expiration date for @line.RawText" />
                                @if (line.ExpirationDate is { } exp)
                                {
                                    @if (exp < reviewDate)
                                    {
                                        <div class="error small" role="status">Before the purchase date — typo? If it's right, it marks the item out immediately.</div>
                                    }
                                    else if (exp < DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <div class="muted small" role="status">Already past — this will mark the item out.</div>
                                    }
                                }
                            </td>
                        }
                        <td><input type="number" step="0.01" min="0.01" @bind="line.Quantity" size="5" aria-label="Quantity for @line.RawText" /></td>
                        <td>
                            <select @bind="line.Category" aria-label="Category for @line.RawText">
                                @foreach (var c in Enum.GetValues<Category>())
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </td>
                        <td class="tags-cell">
                            <div class="tag-list">
                                @foreach (var t in line.Tags)
                                {
                                    <span class="tag-chip">@t<button type="button" class="tag-x" @onclick="() => line.Tags.Remove(t)" aria-label="Remove tag @t">×</button></span>
                                }
                            </div>
                            <div class="tag-add">
                                <input list="known-tags" placeholder="+ tag" size="9" @bind="line.NewTag" @bind:event="oninput" aria-label="Add a tag to @line.RawText" />
                                <button type="button" @onclick="() => AddTag(line)" disabled="@(line.Checking || string.IsNullOrWhiteSpace(line.NewTag))">@(line.Checking ? "…" : "Add")</button>
                            </div>
                            @if (line.Suggestion is { } sug)
                            {
                                <div class="tag-warning" role="status">
                                    “@line.PendingTag” looks like “<strong>@sug</strong>”.
                                    <button type="button" @onclick="() => UseSuggestion(line)">Use “@sug”</button>
                                    <button type="button" class="secondary" @onclick="() => AddAnyway(line)">Add “@line.PendingTag” anyway</button>
                                </div>
                            }
                        </td>
                        <td>
                            <select @bind="line.ProductId" aria-label="Product match for @line.RawText">
                                <option value="0">➕ create new product</option>
                                @foreach (var p in products)
                                {
                                    <option value="@p.Id">@OptionLabel(p)</option>
                                }
                            </select>
                            @if (line.AliasMatched)
                            {
                                <span role="img" aria-label="Matched a previous receipt line from this merchant" title="Matched a previous receipt line from this merchant">🔗</span>
                            }
                            @if (ShowTwinWarning(line))
                            {
                                @* ⚠️ Finding F: the name matches more than one product, so it was left unmatched
                                   rather than pre-selecting an arbitrary twin (or minting a third at confirm).
                                   Say so, and the options above carry their counts so the household can tell the
                                   twins apart. Clears once they pick — OR rename the line (ShowTwinWarning). *@
                                <div class="error small" role="status">
                                    More than one of your products answers to this name — pick which one above
                                    (they're shown with their counts), or leave it to add a new item.
                                </div>
                            }
                            @if (line.ProductId > 0 && products.FirstOrDefault(p => p.Id == line.ProductId) is { IsTracked: false })
                            {
                                <div class="muted small" role="status">Currently ignored — this purchase starts tracking it again.</div>
                            }
                        </td>
                        <td><button class="secondary" @onclick="() => reviewLines.Remove(line)" aria-label="Remove line @line.RawText"><span aria-hidden="true">✕</span></button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <datalist id="known-tags">
            @foreach (var t in allKnownTags)
            {
                <option value="@t" />
            }
        </datalist>
        <p class="verify-for-eval">
            <label>
                <input type="checkbox" @bind="verifiedForEval"
                       aria-label="I checked every line — use this receipt for accuracy checks" />
                I checked every line — use this receipt for accuracy checks
            </label>
            <span class="muted">Verified receipts become ground truth for the “Your receipts” accuracy
            check on the Accuracy page. Only tick it if you really read each line.</span>
        </p>
        <div class="review-actions">
            <button @onclick="ConfirmAll" disabled="@(reviewLines.Count == 0 || confirming)">@(confirming ? "Saving…" : "Confirm all")</button>
            <button class="secondary" @onclick="Discard" disabled="@confirming">Discard receipt</button>
        </div>
        @if (confirmError is not null)
        {
            <p class="error" role="alert">@confirmError</p>
        }
    </section>
}
else if (phase == Phase.Done)
{
    <section class="panel">
        <p>✅ @confirmSummary</p>
        @if (autoConfirmed)
        {
            <p class="muted">
                Confirmed automatically — every line matched something you already buy. Check it any
                time on the <a href="/receipts">Receipts</a> page, or switch to review-everything in
                <a href="/settings">Settings</a>.
            </p>
        }
        <div class="review-actions">
            <button @onclick="Reset">Upload another</button>
            @if (confirmedReceiptId is not null)
            {
                <button class="secondary" @onclick="UndoConfirm" disabled="@undoing">
                    @(undoing ? "Undoing…" : "↩ Undo — remove this receipt and its purchases")
                </button>
            }
        </div>
        @if (undoError is not null)
        {
            <p class="error" role="alert">@undoError</p>
        }
    </section>
}

@code {
    private enum Phase { Idle, Review, Done, Error }

    private Phase phase = Phase.Idle;
    private string? errorMessage;
    private Receipt? receipt;

    // photo-upload.js owns the whole staging UI: it holds the picked bytes AND renders the staged list, the
    // "one receipt" checkbox, and the Extract button into stagingMount — all client-side, so a mobile pick
    // that drops the SignalR circuit still shows the photo and its button. The page hears back only once, via
    // OnExtracted, with the finished ingest outcome(s).
    private ElementReference fileInput;
    private ElementReference stagingMount;
    private IJSObjectReference? uploader;
    private DotNetObjectReference<Upload>? selfRef;
    private string? antiforgeryToken;

    /// <summary>An extract's result from the browser module: the ingest outcome, or a request-level error.
    /// A failed READ comes back as Ok with <c>Outcome.Success</c> false — the receipt was still saved.
    /// <c>Name</c> is the file the module POSTed, for the batch readout. Plain get/set DTOs (not the
    /// service's positional record) so the JS-interop deserializer maps the camelCase JSON straight onto
    /// them — a positional record needs constructor-parameter matching that the interop deserializer doesn't
    /// do, and silently yields a null Outcome instead.</summary>
    public sealed class UploadResult
    {
        public bool Ok { get; set; }
        public UploadOutcome? Outcome { get; set; }
        public string? Error { get; set; }
        public string? Name { get; set; }
    }

    public sealed class UploadOutcome
    {
        public int ReceiptId { get; set; }
        public bool Success { get; set; }
        public string? Error { get; set; }
        public string? Merchant { get; set; }
        public DateOnly? PurchasedAt { get; set; }
        public int LineCount { get; set; }
        public bool AutoConfirmed { get; set; }
        public int Purchases { get; set; }
        public int NewProducts { get; set; }
        public int Retracked { get; set; }
        public bool PossibleDuplicate { get; set; }
    }

    // The file input + its staging mount live in the staging phases only (Idle/Error); moving to Review/Done
    // removes them from the DOM and returning re-creates them. So the uploader can't be wired just once —
    // it's (re)wired whenever the input is on screen but not currently attached, and torn down when it
    // leaves. The module is imported once and reused.
    private IJSObjectReference? _module;
    private bool uploaderWired;
    private bool uploaderWiring; // set across the import+init awaits so a re-render can't wire a second uploader

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            antiforgeryToken = Antiforgery.GetAntiforgeryToken()?.Value;
            selfRef = DotNetObjectReference.Create(this);
        }
        var inputOnScreen = phase is Phase.Idle or Phase.Error;
        try
        {
            if (inputOnScreen && !uploaderWired && !uploaderWiring && selfRef is not null)
            {
                // Guard the two-await window (import + init): a re-render firing OnAfterRenderAsync before
                // uploaderWired flips must not wire a SECOND uploader (two change listeners on one input).
                uploaderWiring = true;
                try
                {
                    _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/photo-upload.js");
                    uploader = await _module.InvokeAsync<IJSObjectReference>(
                        "init", fileInput, stagingMount, selfRef, new
                        {
                            maxEdgePx = Llm.Value.MaxImageEdgePx,
                            maxFiles = MaxFiles,
                            endpoint = "/api/receipts/extract",
                            extractLabel = "Extract",
                            busyLabel = "Reading your receipt… this usually takes a few seconds.",
                            noun = "file",
                            allowCombine = true,
                            token = antiforgeryToken,
                            reconnectMessage = "Your receipt was uploaded, but the connection dropped before the "
                                + "result could load. Reload the page — it'll be in the review queue below, or "
                                + "already recorded on the Receipts page if it auto-confirmed.",
                        });
                    uploaderWired = true;
                }
                finally { uploaderWiring = false; }
            }
            else if (!inputOnScreen && uploaderWired)
            {
                // The input is gone (Review/Done) — dispose the now-stale uploader; a return to staging rewires.
                await DisposeUploaderAsync();
                uploaderWired = false;
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-wiring — a reload re-runs this; nothing to do.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wiring up the receipt uploader failed.");
        }
    }

    private async Task DisposeUploaderAsync()
    {
        if (uploader is null) return;
        try
        {
            await uploader.InvokeVoidAsync("dispose");
            await uploader.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { uploader = null; }
    }

    /// <summary>Called by photo-upload.js once it has POSTed the staged photos and holds the finished ingest
    /// outcome(s) — the ONLY circuit-dependent moment in the flow (the module retries it across a reconnect,
    /// so it lands once the connection is back). <paramref name="combined"/> is true for a single receipt (one
    /// photo, or the pages of one long receipt ticked together) and false for a stack POSTed one-per-receipt.
    /// <c>fileCount</c> (the module's shared signature — the census page's "found in N photos" copy) is unused
    /// here: a receipt's item count comes from its own outcome.</summary>
    [JSInvokable]
    public async Task OnExtracted(UploadResult[] results, bool combined, int fileCount)
    {
        errorMessage = null;
        try
        {
            if (combined) await HandleCombinedAsync(results.FirstOrDefault());
            else await HandleBatchAsync(results);
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Handling the extracted receipt(s) failed.");
            errorMessage = "Sorry — something went wrong reading the receipt. Please try again.";
            phase = Phase.Error;
        }
        await InvokeAsync(StateHasChanged);
    }

    // One receipt (a single photo, or the pages of one long receipt): the module already POSTed it and the
    // server ingested + auto-routed it. A trusted receipt records itself and review never appears; anything
    // the router won't vouch for falls through to the normal review grid (the service already persisted it,
    // so a fresh extraction and a queued one share one pre-fill).
    private async Task HandleCombinedAsync(UploadResult? result)
    {
        if (result is null || !result.Ok || result.Outcome is null)
        {
            errorMessage = result?.Error ?? "Sorry — something went wrong reading that receipt. Please try again.";
            phase = Phase.Error;
            return;
        }
        var outcome = result.Outcome;
        if (!outcome.Success)
        {
            errorMessage = $"Sorry — that receipt couldn't be read. The image was kept for review. ({outcome.Error})";
            phase = Phase.Error;
            return;
        }
        if (outcome.AutoConfirmed)
        {
            confirmSummary = Summary(outcome.Purchases, outcome.NewProducts, outcome.Retracked,
                outcome.Merchant, outcome.PurchasedAt ?? DateOnly.FromDateTime(DateTime.Today));
            autoConfirmed = true;
            confirmedReceiptId = outcome.ReceiptId;
            await LoadPendingAsync();
            phase = Phase.Done;
            return;
        }
        await LoadReviewAsync(outcome.ReceiptId);
    }

    // A stack of separate receipts: the module POSTed each on its own and handed back every outcome. Each
    // read landed in the PendingReview queue below (a success or a saved failed read); the batch readout says
    // what happened to each, and the queue is refreshed so its Review/Retry apply.
    private async Task HandleBatchAsync(UploadResult[] results)
    {
        batch = results.Select(r =>
        {
            var item = new BatchItem { FileName = r.Name ?? "receipt" };
            if (r.Ok && r.Outcome is { } outcome)
            {
                item.InQueue = true; // a receipt row exists (success or a saved failed read), so Retry applies
                if (outcome.Success)
                {
                    item.Status = BatchStatus.Done;
                    item.Merchant = outcome.Merchant;
                    item.PurchasedAt = outcome.PurchasedAt;
                    item.LineCount = outcome.LineCount;
                    item.AutoConfirmed = outcome.AutoConfirmed;
                    item.PossibleDuplicate = outcome.PossibleDuplicate;
                }
                else
                {
                    item.Status = BatchStatus.Failed;
                }
            }
            else
            {
                // A request-level failure (bad upload, server error) — no receipt row was saved, so this
                // isn't a queue Retry case; the readout tells the user to pick + extract again.
                item.Status = BatchStatus.Failed;
            }
            return item;
        }).ToList();
        await LoadPendingAsync(); // the batch just filled the review queue
        phase = Phase.Idle;
    }
    private DateOnly reviewDate = DateOnly.FromDateTime(DateTime.Today);
    private List<ReviewLine> reviewLines = [];
    private List<Product> products = [];
    // Product names TWO OR MORE products share (by identity) — so the dropdown can annotate them with
    // their counts to tell them apart, the same way the census grid does. Recomputed with `products`.
    private HashSet<string> twinNames = new(StringComparer.OrdinalIgnoreCase);
    private string confirmSummary = "";
    private string? confirmError;
    private bool confirming;
    private bool autoConfirmed;                    // the Done panel explains an automatic confirm
    private ImportMode uploadMode = ImportMode.Review; // the household's active mode, shown pre-upload
    // The receipt the Done panel is ABOUT — what its Undo removes. Null when there's nothing
    // coherent to undo (an AlreadyConfirmed re-confirm, or after an undo ran).
    private int? confirmedReceiptId;
    private bool undoing;
    private string? undoError;
    // The user's explicit "I checked every line" opt-in — makes the confirmed lines extraction ground
    // truth (Receipt.VerifiedForEval). Off by default and reset per review; never set by machine confirms.
    private bool verifiedForEval;

    private List<PendingRow> pendingReceipts = [];
    private record PendingRow(int Id, string? Merchant, DateOnly? PurchasedAt, int LineCount, bool PossibleDuplicate);
    // The confirmed receipt the CURRENT review looks like a re-upload of (null = no match) — drives
    // the review screen's duplicate warning. Recomputed on every review load.
    private ReceiptDuplicateDetector.Match? duplicateOf;
    private int? retryingId;
    private string? pendingError;

    private class ReviewLine
    {
        public required string RawText { get; set; }
        public string NormalizedName { get; set; } = "";
        public string? Brand { get; set; }
        public string? Size { get; set; }
        public string? Variety { get; set; }
        public DateOnly? ExpirationDate { get; set; } // human-typed at review; never extracted
        public decimal Quantity { get; set; } = 1;
        public Category Category { get; set; }
        public decimal Confidence { get; set; }
        public decimal? UnitPrice { get; set; }
        public List<string> Tags { get; set; } = [];
        public string? NewTag { get; set; }           // the in-progress "add tag" input
        public string? PendingTag { get; set; }        // a new tag awaiting the user's dedup decision
        public string? Suggestion { get; set; }        // the existing tag PendingTag looks like
        public bool Checking { get; set; }             // an async synonym check is running
        public int ProductId { get; set; }            // 0 = create new
        public bool AliasMatched { get; set; }
        /// <summary>The line's name matches TWO OR MORE products (a twin) AT READ TIME, so it was left
        /// unmatched: the confirm can't tell twins apart, and left at create-new would mint a THIRD twin.
        /// Drives the grid's "pick which one" warning (finding F); see <see cref="ReadName"/>.</summary>
        public bool AmbiguousTwin { get; set; }
        /// <summary>The line's name as READ, before any human edit. <see cref="AmbiguousTwin"/> is a read-time
        /// fact, so once the human RENAMES the line they've taken over its identity and the stale twin warning
        /// is dropped — the same rename-suppression the census grid applies to its ambiguous-suggestion
        /// warning (finding C's EffectiveAmbiguousSuggestion). Cleared by a pick too (ProductId &gt; 0).</summary>
        public string ReadName { get; set; } = "";
    }

    /// <summary>Whether to show the twin "pick which one" warning: a read-time ambiguity, on an unresolved
    /// line, whose name the human hasn't edited away from what was read (the census grid's finding-C
    /// rename-suppression, applied to its sibling here). Live per render, so a rename drops it.</summary>
    private static bool ShowTwinWarning(ReviewLine line) =>
        line.AmbiguousTwin && line.ProductId == 0
            && string.Equals(line.NormalizedName.Trim(), line.ReadName.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>Recompute which product names are twins (shared by 2+ products, by the matcher's identity
    /// rule) — called whenever <see cref="products"/> is loaded, so <see cref="OptionLabel"/> is O(1).</summary>
    private void RecomputeTwinNames() =>
        twinNames = products
            .GroupBy(p => ProductMatcher.IdentityKey(p.Name))
            .Where(g => g.Count() > 1)
            .SelectMany(g => g.Select(p => p.Name))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    /// <summary>A twin-named product's dropdown option carries its on-hand count so the household can tell
    /// two identically-named products apart; a non-twin shows its plain name. The phrasing itself is
    /// <see cref="ProductOptionLabel"/> — ONE definition shared with the census grid, so the two dropdowns
    /// can't drift apart the first time one wording is edited.</summary>
    private string OptionLabel(Product p) =>
        !twinNames.Contains(p.Name)
            ? p.Name
            : ProductOptionLabel.ForTwin(p.Name, p.QuantityOnHand, counting: p.TrackQuantity, p.DefaultUnit);

    // Tag universe for suggestions + dedup: seed vocabulary ∪ tags already stored on products.
    private List<string> allKnownTags = [];

    // The household's expiration-tracking toggle — gates the review grid's "Expires" column. Refreshed
    // per review load (not just once) so a Settings change lands without a page reload.
    private bool trackExpirations;

    protected override async Task OnInitializedAsync()
    {
        trackExpirations = await SettingsStore.GetTrackExpirationDatesAsync();
        uploadMode = await AutoConfirmer.ModeAsync();
        await LoadPendingAsync();
    }

    // Everything PendingReview: receipts the importer queued (Smart/Review mode), abandoned manual
    // reviews, AND zero-line receipts whose extraction failed — those used to be filtered out and were
    // invisible forever (the only recovery was reading the server logs).
    private async Task LoadPendingAsync()
    {
        List<(int Id, string? Merchant, DateOnly? PurchasedAt, int LineCount)> rows;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            rows = (await db.Receipts
                    .Where(r => r.Status == ReceiptStatus.PendingReview)
                    .OrderBy(r => r.Id)
                    .Select(r => new { r.Id, r.Merchant, r.PurchasedAt, LineCount = r.Lines.Count })
                    .ToListAsync())
                .Select(r => (r.Id, r.Merchant, r.PurchasedAt, r.LineCount))
                .ToList();
        }
        // The queue is short and the detector's prefilter almost always returns nothing, so a
        // per-row check is cheap — and a "possible duplicate" chip is why a queued dupe gets
        // discarded instead of rubber-stamped.
        pendingReceipts = [];
        foreach (var r in rows)
        {
            var dupe = r.LineCount > 0 && await Duplicates.FindDuplicateAsync(r.Id) is not null;
            pendingReceipts.Add(new PendingRow(r.Id, r.Merchant, r.PurchasedAt, r.LineCount, dupe));
        }
    }

    // Load a queued receipt into the SAME editable review table the manual upload uses, so it can be
    // edited + confirmed (or discarded) — reusing ConfirmAll, which already works off the receipt id.
    private Task ReviewPending(int receiptId) => LoadReviewAsync(receiptId);

    // ONE review pre-fill for both entry paths (fresh extraction and auto-import queue): lines come
    // from the stored receipt — tags and the model's suggestion are persisted on ReceiptLine now —
    // with the product pre-filled by trust order: learned alias → model suggestion → matcher → new.
    private async Task LoadReviewAsync(int receiptId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var r = await db.Receipts.Include(x => x.Lines).FirstOrDefaultAsync(x => x.Id == receiptId);
        if (r is null || r.Status != ReceiptStatus.PendingReview) { await LoadPendingAsync(); return; }

        receipt = r;
        reviewDate = r.PurchasedAt ?? DateOnly.FromDateTime(DateTime.Today);
        trackExpirations = await SettingsStore.GetTrackExpirationDatesAsync();
        products = await db.Products.OrderBy(p => p.Name).ToListAsync();
        RecomputeTwinNames();
        var stored = await db.ProductTags.Select(t => t.Value).Distinct().ToListAsync();
        allKnownTags = TagVocabulary.Seed.Concat(stored).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToList();

        var merchant = r.Merchant ?? "";
        var aliases = await db.ProductAliases.Where(a => a.Merchant == merchant).ToListAsync();
        // One identity index per load, not a full-catalog ExactMatches scan per line — the same move the
        // census grid and the auto-confirmer make (they and this loop ask the identical questions).
        var catalogIndex = new CatalogIndex(products);
        reviewLines = r.Lines.Select(l =>
        {
            var alias = aliases.FirstOrDefault(a => a.RawText == l.RawText);
            Product? match = null;
            var ambiguousTwin = false;
            if (alias is null)
            {
                // Size is metadata, not identity — match on item name only (all sizes roll up). Resolve the
                // model's suggestion by the matcher's rule-1 identity set, not string.Equals: it folds a
                // punctuation variant onto the one product it names.
                match = l.SuggestedProduct is { Length: > 0 }
                        && catalogIndex.ExactMatches(l.SuggestedProduct) is { Count: 1 } one
                    ? one[0]
                    : null;
                match ??= ProductMatcher.Resolve(l.NormalizedName, products);
                // ⚠️ A name TWO OR MORE products share is a pick only the human can make: the confirm can't
                // tell the twins apart, so pre-selecting one is an arbitrary machine judgement — and left at
                // create-new it would mint a THIRD zero-history twin. So don't pre-select; flag the line so
                // the grid warns and the dropdown distinguishes the twins by count, the same treatment the
                // census grid gives them (finding F). The human picks; the auto-importer already routes such
                // lines to review, so an unreviewed confirm never reaches this branch.
                ambiguousTwin = match is not null && catalogIndex.ExactMatches(match.Name).Count > 1;
                if (ambiguousTwin) match = null;
            }
            return new ReviewLine
            {
                RawText = l.RawText,
                NormalizedName = l.NormalizedName,
                Brand = l.Brand,
                Size = l.Size,
                Variety = l.Variety,
                ExpirationDate = l.ExpirationDate,
                Quantity = l.Quantity,
                Category = l.Category,
                Confidence = l.Confidence,
                UnitPrice = l.UnitPrice,
                Tags = ReceiptConfirmationService.DeserializeTags(l.TagsJson),
                ProductId = alias?.ProductId ?? match?.Id ?? 0,
                AliasMatched = alias is not null,
                AmbiguousTwin = ambiguousTwin,
                ReadName = l.NormalizedName,
            };
        }).ToList();

        confirmError = null;
        verifiedForEval = false; // a fresh review starts unasserted
        duplicateOf = await Duplicates.FindDuplicateAsync(receiptId);
        phase = Phase.Review;
    }

    private async Task DiscardPending(int receiptId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var r = await db.Receipts.FirstOrDefaultAsync(x => x.Id == receiptId);
        if (r is not null)
        {
            r.Status = ReceiptStatus.Discarded;
            await db.SaveChangesAsync();
        }
        await LoadPendingAsync();
    }

    // Re-extract a failed (zero-line) receipt from the audit copy saved at import time — a transient
    // API blip during an auto-scan used to park the file permanently with no way back but the logs.
    private async Task RetryPending(int receiptId)
    {
        if (retryingId is not null) return;
        retryingId = receiptId;
        pendingError = null;
        try
        {
            // Re-extraction from the saved audit copy lives in the ingestion service (one home for the
            // catalog load, the line mapping, and persistence — shared with a fresh ingest).
            var result = await Ingestion.RetryAsync(receiptId);
            switch (result.Failure)
            {
                case ReceiptIngestionService.RetryFailure.Gone:
                    await LoadPendingAsync();
                    return;
                case ReceiptIngestionService.RetryFailure.MissingCopy:
                    pendingError = "The saved copy of this receipt is missing — discard it and re-upload.";
                    return;
                case ReceiptIngestionService.RetryFailure.ReadFailed:
                    pendingError = $"Still couldn't read it. ({result.Error})";
                    return;
            }

            await LoadReviewAsync(receiptId); // straight into the normal review flow
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Retry of pending receipt {ReceiptId} failed.", receiptId);
            pendingError = "Retry failed — please try again, or discard the receipt.";
        }
        finally
        {
            retryingId = null;
        }
    }


    private const int MaxFiles = 20;

    // The module reads each receipt itself and hands back only the finished results, so a batch row is only
    // ever a final Done or Failed — there is no Waiting/Reading state on the .NET side.
    private enum BatchStatus { Done, Failed }

    private sealed class BatchItem
    {
        public required string FileName { get; init; }
        public BatchStatus Status { get; set; } = BatchStatus.Failed;
        public string? Merchant { get; set; }
        public DateOnly? PurchasedAt { get; set; }
        public int LineCount { get; set; }
        public bool InQueue { get; set; } // a receipt row exists, so the pending list's Retry applies
        public bool AutoConfirmed { get; set; } // Smart/Auto recorded it; it never enters the queue
        public bool PossibleDuplicate { get; set; } // queued because it matches a confirmed receipt
    }

    private List<BatchItem> batch = [];

    private static string BatchIcon(BatchStatus s) => s switch
    {
        BatchStatus.Done => "✅",
        _ => "⚠️",
    };

    private static string BatchNote(BatchItem b) => b.Status switch
    {
        BatchStatus.Done => $"{b.Merchant ?? "Unknown merchant"} · {(b.PurchasedAt is { } d ? d.ToString("MMM d, yyyy") : "no date")} · {b.LineCount} item{(b.LineCount == 1 ? "" : "s")}" +
            (b.AutoConfirmed ? " — recorded automatically"
                : b.PossibleDuplicate ? " — ⚠️ possible duplicate, waiting for your review below"
                : " — in the review queue below"),
        _ => b.InQueue
            ? "couldn't be read — retry it from the queue below"
            // A request-level failure means the POST/save failed, never the read — the photo staged fine.
            // Don't send the user back to the picker for a failure the picker can't fix.
            : "something went wrong saving this receipt — pick it and extract again",
    };

    // The ONE "recorded" summary, so an automatic confirm reads exactly like a manual one.
    private static string Summary(int purchases, int newProducts, int retracked, string? merchant, DateOnly date) =>
        $"Recorded {purchases} purchases" +
        (newProducts > 0 ? $" ({newProducts} new product{(newProducts == 1 ? "" : "s")})" : "") +
        $" from {(string.IsNullOrEmpty(merchant) ? "unknown merchant" : merchant)} on {date:yyyy-MM-dd}." +
        (retracked > 0 ? $" Started tracking {retracked} previously ignored item{(retracked == 1 ? "" : "s")} again." : "");


    // Persistence lives in ReceiptConfirmationService — the ONE confirm path shared with the
    // auto-importer. The service is idempotent (an already-confirmed receipt is a no-op) and the
    // `confirming` flag keeps a double-click from even reaching it.
    private async Task ConfirmAll()
    {
        if (receipt is null || confirming) return;
        confirming = true;
        confirmError = null;
        try
        {
            var lines = reviewLines.Select(l => new ReceiptConfirmationService.ConfirmLine(
                l.RawText, l.NormalizedName, l.Brand, l.Size, l.Variety, l.Quantity, l.Category, l.Tags, l.ProductId,
                l.ExpirationDate)).ToList();
            // Use the user-confirmed receipt date (not the upload date) so refill intervals are accurate
            // even when many receipts are uploaded in one sitting. writeAliases: a human reviewed these
            // pairings, so they're allowed to become sticky merchant aliases.
            var outcome = await Confirmer.ConfirmAsync(receipt.Id, reviewDate, lines, writeAliases: true,
                verifiedForEval: verifiedForEval);

            confirmSummary = outcome.AlreadyConfirmed
                ? "These purchases were already recorded."
                : Summary(outcome.Purchases, outcome.NewProducts, outcome.Retracked, receipt.Merchant, reviewDate);
            // Undo is offered only for the confirm that just happened — re-confirming an already-
            // confirmed receipt records nothing, so there's nothing coherent for Undo to mean.
            confirmedReceiptId = outcome.AlreadyConfirmed ? null : receipt.Id;
            await LoadPendingAsync(); // a queued receipt just left the pending list
            phase = Phase.Done;
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            // One SaveChanges in a single transaction, so a failure persists nothing: keep the receipt in
            // review so the user can adjust a line and retry instead of losing the extraction to a crash.
            Logger.LogError(ex, "Confirming receipt {ReceiptId} failed.", receipt.Id);
            confirmError = "Couldn't save these purchases — nothing was recorded. Adjust a line and try again, or discard the receipt.";
        }
        finally
        {
            confirming = false;
        }
    }

    // Two-stage tag dedup so the cloud doesn't fragment: cheap plain-code near-duplicate first, then an
    // LLM synonym check only when that finds nothing. Either way the user can override and add it anyway.
    private async Task AddTag(ReviewLine line)
    {
        line.Suggestion = null;
        line.PendingTag = null;
        var tag = (line.NewTag ?? "").Trim();
        if (tag.Length == 0) return;
        if (line.Tags.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase))) { line.NewTag = ""; return; }

        var universe = allKnownTags.Concat(line.Tags).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        // Picked an existing tag verbatim → just add its canonical form, no dedup needed.
        var exact = universe.FirstOrDefault(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase));
        if (exact is not null) { AddNewTag(line, exact); return; }

        // Stage 1: instant plain-code near-duplicate (casing / plural / typo).
        if (TagVocabulary.FindNearDuplicate(tag, universe) is { } near)
        {
            line.PendingTag = tag;
            line.Suggestion = near;
            return;
        }

        // Stage 2: LLM synonym check (Soda ≈ Soft Drink) — only when the cheap check is clean.
        line.Checking = true;
        try
        {
            if (await Advisor.FindSynonymAsync(tag, universe) is { } synonym)
            {
                line.PendingTag = tag;
                line.Suggestion = synonym;
                return;
            }
        }
        finally
        {
            line.Checking = false;
        }

        AddNewTag(line, tag); // genuinely new
    }

    private void UseSuggestion(ReviewLine line)
    {
        if (line.Suggestion is { } s) AddNewTag(line, s);
        line.Suggestion = null;
        line.PendingTag = null;
    }

    private void AddAnyway(ReviewLine line)
    {
        if (line.PendingTag is { } t) AddNewTag(line, t);
        line.Suggestion = null;
        line.PendingTag = null;
    }

    private void AddNewTag(ReviewLine line, string tag)
    {
        if (!line.Tags.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase))) line.Tags.Add(tag);
        if (!allKnownTags.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase))) allKnownTags.Add(tag);
        line.NewTag = "";
    }

    private async Task Discard()
    {
        if (receipt is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbReceipt = await db.Receipts.FirstAsync(r => r.Id == receipt.Id);
            dbReceipt.Status = ReceiptStatus.Discarded;
            await db.SaveChangesAsync();
        }
        await LoadPendingAsync();
        Reset();
    }

    // The escape hatch under Smart confirm: a duplicate upload records duplicate purchases (uploads
    // have no file dedup), and the freshest moment to catch one is right here on the Done panel.
    private async Task UndoConfirm()
    {
        if (confirmedReceiptId is not { } id || undoing) return;
        undoing = true;
        undoError = null;
        try
        {
            var outcome = await Removal.RemoveAsync(id);
            if (outcome is { Found: true, Untraceable: false })
            {
                confirmSummary = $"Undone — the receipt and its {outcome.Purchases} purchase{(outcome.Purchases == 1 ? "" : "s")} were removed." +
                    (outcome.ProductsKept > 0 ? $" ({outcome.ProductsKept} product{(outcome.ProductsKept == 1 ? "" : "s")} kept — they have other history.)" : "");
                confirmedReceiptId = null;
                autoConfirmed = false;
                await LoadPendingAsync();
            }
            else
            {
                undoError = "Couldn't undo this receipt — manage it from the Receipts page instead.";
            }
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undo of receipt {ReceiptId} failed.", id);
            undoError = "Couldn't undo — nothing was changed. Try again, or use the Receipts page.";
        }
        finally
        {
            undoing = false;
        }
    }

    private void Reset()
    {
        // The JS uploader was disposed when we left staging (Review/Done); returning to Idle re-inits a
        // fresh, empty one, and it owns the staged list — so there's nothing .NET-side to clear here.
        phase = Phase.Idle;
        receipt = null;
        reviewLines = [];
        batch = [];
        errorMessage = null;
        confirmError = null;
        autoConfirmed = false;
        confirmedReceiptId = null;
        undoError = null;
        duplicateOf = null;
    }

    public async ValueTask DisposeAsync()
    {
        // Tear down the browser uploader (its change listener + JS ref) and the module + callback ref.
        // Extraction itself needs no cancellation: it's a plain HTTP POST the browser owns, so a
        // navigate-away can't interrupt it — a receipt mid-ingest still lands in the review queue (the
        // queue's Retry is the recovery path), exactly as before.
        await DisposeUploaderAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
