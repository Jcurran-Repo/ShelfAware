@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using ShelfAware.Web.Auth
@using ShelfAware.Web.Diagnostics
@using ShelfAware.Core.Billing
@using ShelfAware.Core.Evaluation
@using ShelfAware.Web.Services
@using ShelfAware.Web.Wishlist
@attribute [Authorize(Policy = AdminOptions.PolicyName)]
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AdminReportReader Reader
@inject ReportResolutionService Actions
@inject AdminHouseholdService HouseholdAdmin
@inject AdminAiSpendReader AiSpend
@inject ICiStatusProvider Ci
@inject ITestStatusProvider TestStatus
@inject IOptions<AdminOptions> AdminConfig
@inject ErrorLogSink Sink
@inject OnlinePresence Presence
@inject DemoUsageMeter DemoUsage
@inject IOptions<DemoOptions> DemoConfig
@inject ILogger<Admin> Logger

<PageTitle>Admin — Reginald</PageTitle>

<div class="page-head">
    <h1>Admin</h1>
</div>

@if (refused)
{
    @* The routed-page policy already turns strangers away; this is the same predicate asked again
       inside the component (defense in depth, and the layer a component test can pin). *@
    <p class="error">This page is only for the configured admin.</p>
}
else
{
    @* Persistent announcer (the copy-name precedent, item 47): a live region inserted WITH its
       text isn't reliably announced, so the slot exists before any action fills it. Success is
       otherwise silent — the row just moves lists. *@
    <div class="visually-hidden" role="status" aria-live="polite">@actionAnnouncement</div>
    @* One slot for action outcomes, above both sections — role=alert announces from anywhere,
       and both sections' buttons feed the same ActAsync. *@
    @if (actionError is not null)
    {
        <p class="error" role="alert">@actionError</p>
    }
    <section class="panel">
        <h2>At a glance</h2>
        @{
            // One presence snapshot for the whole page — this tile and the "Online now" section below both
            // read this `online` (declared here, in the shared else-block scope). Reading presence more than
            // once could show numbers that disagree for a frame, since it's mutated from other circuits'
            // threads.
            var online = Presence.Snapshot();
            var founderCount = households?.Count(h => h.Tier == HouseholdTier.Founder) ?? 0;
            int? openBugCount = bugReports?.Count(r => !r.Report.Resolved);
            int? openErrorCount = errors?.Count(e => !e.Resolved);
        }
        <p class="muted">A live snapshot across every household on this deployment. AI cost is what's been
            recorded this period across all key modes (the host's own keys and any brought in Settings) —
            the detail is in the panels below.</p>
        <div class="portfolio">
            <div class="stat">
                <div class="stat-value">@(households?.Count.ToString() ?? "…")</div>
                <div class="stat-label">Household@(households is { Count: 1 } ? "" : "s")@(founderCount > 0 ? $" · {founderCount} Founder" : "")</div>
            </div>
            <div class="stat">
                <div class="stat-value">@online.Count</div>
                <div class="stat-label">Online now</div>
            </div>
            <div class="stat">
                <div class="stat-value">@(aiSpend is null ? "…" : AiPricing.FormatMicros(aiSpend.Today.CostMicros))</div>
                <div class="stat-label">AI today@(aiSpend is null ? "" : $" · {aiSpend.Today.Calls} call{(aiSpend.Today.Calls == 1 ? "" : "s")}")</div>
            </div>
            <div class="stat">
                <div class="stat-value">@(aiSpend is null ? "…" : AiPricing.FormatMicros(aiSpend.Month.CostMicros))</div>
                <div class="stat-label">This month@(aiSpend is null ? "" : $" · {aiSpend.Month.Calls} call{(aiSpend.Month.Calls == 1 ? "" : "s")} · {aiSpend.ActiveHouseholdsThisMonth} active")</div>
            </div>
            <div class="stat">
                <div class="stat-value">@(openBugCount?.ToString() ?? "…")</div>
                <div class="stat-label">Open bug@(openBugCount == 1 ? "" : "s")</div>
            </div>
            <div class="stat">
                <div class="stat-value">@(openErrorCount?.ToString() ?? "…")</div>
                <div class="stat-label">Open error@(openErrorCount == 1 ? "" : "s")</div>
            </div>
        </div>
    </section>
    @if (DemoUsage.IsConfigured)
    {
        @* The managed demo box's box-wide daily AI valve — the wallet bound open registration needs that the
           per-household quotas can't give (every new household gets its own allowance). At the cap, every AI
           surface shows "come back tomorrow" until the day rolls over. Hidden entirely on a box with no Demo
           config (family / self-host). TTS isn't metered — the demo reads recipes with a free local voice. *@
        var demoCallsToday = demoUsage?.Calls ?? 0;
        var demoLimit = DemoConfig.Value.DailyGlobalCallLimit;
        var demoAtCap = demoLimit is { } cap && demoCallsToday >= cap;
        <section class="panel">
            <h2>Demo box usage</h2>
            <p class="muted">Host-key AI calls across ALL households today, against the box-wide daily cap.
                At the cap, every AI surface shows "come back tomorrow" until midnight (server time). The real
                ceiling is the spend limit on the key itself; this valve just hands the polite message first.</p>
            <div class="portfolio">
                <div class="@(demoAtCap ? "stat fail" : "stat")">
                    <div class="stat-value">@demoCallsToday@(demoLimit is { } shown ? $" / {shown}" : "")</div>
                    <div class="stat-label">AI calls today@(demoAtCap ? " · capped" : "")</div>
                </div>
                @if (DemoConfig.Value.AlertThreshold is { } threshold)
                {
                    <div class="@(demoCallsToday >= threshold ? "stat pass" : "stat")">
                        <div class="stat-value">@threshold</div>
                        <div class="stat-label">Alert threshold@(demoCallsToday >= threshold ? " · crossed" : "")</div>
                    </div>
                }
            </div>
        </section>
    }
    @if (Ci.Enabled)
    {
        <section class="panel">
            <h2>Continuous integration</h2>
            <p class="muted">The latest run of each GitHub Actions workflow — fetched after the page loads and
                cached a few minutes. Open a run for its full log.</p>
            @if (ciStatus is null)
            {
                <p>Loading…</p>
            }
            else if (ciStatus.Error is not null)
            {
                <p class="muted">Couldn't reach GitHub just now (@ciStatus.Error) — it'll retry on the next load.</p>
            }
            else if (ciStatus.Runs.Count == 0)
            {
                <p class="muted">No workflow runs found.</p>
            }
            else
            {
                <div class="portfolio">
                    @foreach (var run in ciStatus.Runs)
                    {
                        <div class="@CiTileClass(run.Outcome)">
                            <div class="stat-value">@CiOutcomeLabel(run.Outcome)</div>
                            <div class="stat-label">
                                @run.Workflow · @(string.IsNullOrEmpty(run.Branch) ? "—" : run.Branch) ·
                                <a href="@run.Url" target="_blank" rel="noopener noreferrer">@run.ShortSha</a> ·
                                @run.UpdatedAt.ToLocalTime().ToString("MMM d, HH:mm")
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
    <section class="panel">
        <h2>Tests &amp; quality</h2>
        @if (testStatus is null)
        {
            <p class="muted">No test snapshot yet. CI writes <code>test-status.json</code> from a real run; it's
                committed and served like the accuracy figures, so it appears here after the next deploy.</p>
        }
        else
        {
            <p class="muted">
                @if (!string.IsNullOrEmpty(testStatus.CommitSha))
                {
                    <text>From the run on <code>@testStatus.ShortSha</code>@(string.IsNullOrEmpty(testStatus.Branch) ? "" : $" ({testStatus.Branch})"), </text>
                }
                generated @testStatus.GeneratedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm").
                @if (testStatus.RunUrl is not null)
                {
                    <a href="@testStatus.RunUrl" target="_blank" rel="noopener noreferrer">View run</a>
                }
            </p>
            <div class="portfolio">
                <div class="@(testStatus.AllPassed ? "stat pass" : (testStatus.TotalFailed > 0 ? "stat fail" : "stat"))">
                    <div class="stat-value">@testStatus.TotalPassed / @testStatus.TotalTests</div>
                    <div class="stat-label">Tests passing</div>
                </div>
                @if (testStatus.TotalFailed > 0)
                {
                    <div class="stat fail">
                        <div class="stat-value">@testStatus.TotalFailed</div>
                        <div class="stat-label">Failing</div>
                    </div>
                }
                @if (testStatus.Warnings is { } warns)
                {
                    <div class="@(warns == 0 ? "stat pass" : "stat")">
                        <div class="stat-value">@warns</div>
                        <div class="stat-label">Build warning@(warns == 1 ? "" : "s")</div>
                    </div>
                }
                @if (testStatus.MutationScore is { } mut)
                {
                    <div class="@(mut >= 100 ? "stat pass" : "stat")">
                        <div class="stat-value">@mut.ToString("0.##")%</div>
                        <div class="stat-label">Core mutation score</div>
                    </div>
                }
            </div>
            @if (testStatus.Projects.Count > 0)
            {
                <table>
                    <caption class="visually-hidden">Test counts per project</caption>
                    <thead>
                        <tr><th>Project</th><th>Passed</th><th>Failed</th><th>Skipped</th><th>Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in testStatus.Projects)
                        {
                            <tr @key="p.Name">
                                <td>@p.Name</td>
                                <td>@p.Passed</td>
                                <td>@p.Failed</td>
                                <td>@p.Skipped</td>
                                <td>@p.Total</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </section>
    <section class="panel">
        <h2>Households</h2>
        <p class="muted">Every household on this deployment, its members, and its tier. Grant
            <strong>Founder</strong> to give a household unlimited AI on the host's keys (still recorded) —
            the thank-you tier for the people helping out.</p>
        @if (households is null)
        {
            <p>Loading…</p>
        }
        else if (households.Count == 0)
        {
            <p class="muted">No households yet.</p>
        }
        else
        {
            <table>
                <caption class="visually-hidden">Every household, its members, and its tier</caption>
                <thead>
                    <tr><th>Household</th><th>Members</th><th>Tier</th><th>Founder since</th><th><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var h in households)
                    {
                        <tr @key="h.Id">
                            <td>@h.Name</td>
                            <td>@(h.MemberEmails.Count == 0 ? "—" : string.Join(", ", h.MemberEmails))</td>
                            <td>@(h.Tier == HouseholdTier.Founder ? "★ Founder" : h.Tier.ToString())</td>
                            <td>@(h.FounderSince?.ToString("MMM d, yyyy") ?? "—")</td>
                            <td>
                                @if (h.Tier == HouseholdTier.Founder)
                                {
                                    <button class="secondary" @onclick="() => SetFounderAsync(h.Id, false)"
                                            disabled="@(busy || actionBusy)"
                                            aria-label="Remove Founder from @h.Name">Remove Founder</button>
                                }
                                else
                                {
                                    <button class="secondary" @onclick="() => SetFounderAsync(h.Id, true)"
                                            disabled="@(busy || actionBusy)"
                                            aria-label="Grant Founder to @h.Name">Grant Founder</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h2>Hosted wishlist</h2>
        <p class="muted">Pre-launch demand for a HOSTED Reginald, from the <a href="/about">/about</a> page.
            The interest total is soft (a public one-click counter can't be made fraud-proof); the distinct
            emails are the signal worth acting on — and your launch list. Bounded at @WishlistStore.MaxRows rows.</p>
        @if (wishlistSummary is null)
        {
            <p>Loading…</p>
        }
        else
        {
            <div class="portfolio">
                <div class="stat">
                    <div class="stat-value">@wishlistSummary.Total</div>
                    <div class="stat-label">Interest (soft)</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@wishlistSummary.DistinctEmails</div>
                    <div class="stat-label">Reserved email@(wishlistSummary.DistinctEmails == 1 ? "" : "s")</div>
                </div>
                @foreach (var t in WishlistTiers.All)
                {
                    <div class="stat">
                        <div class="stat-value">@(wishlistSummary.ByTier.TryGetValue(t.Key, out var n) ? n : 0)</div>
                        <div class="stat-label">@t.Name</div>
                    </div>
                }
            </div>
            @if (wishlistContacts is { Count: > 0 })
            {
                <p>
                    <button class="secondary" @onclick="CopyWishlistEmailsAsync" disabled="@(busy || actionBusy)">
                        Copy @wishlistContacts.Count email@(wishlistContacts.Count == 1 ? "" : "s")
                    </button>
                </p>
                @* Persistent announcer (the copy-name precedent): a live region inserted WITH its text
                   isn't reliably announced, so the slot exists before the copy fills it. *@
                <div class="visually-hidden" role="status" aria-live="polite">@wishlistCopyStatus</div>
                <table>
                    <caption class="visually-hidden">Wishlist notify list — one row per email, its latest tier</caption>
                    <thead>
                        <tr><th>Email</th><th>Tier</th><th>When</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in wishlistContacts)
                        {
                            <tr @key="c.Email">
                                <td>@c.Email</td>
                                <td>@(WishlistTiers.ByKey(c.Tier)?.Name ?? c.Tier)</td>
                                <td>@c.SignedUpAt.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="muted">No emails yet — any anonymous interest is counted above.</p>
            }
        }
    </section>

    <section class="panel">
        @* `online` is the single snapshot taken at the top of the block (shared with the glance strip) —
           reading presence more than once could show a header number that disagrees with the rows for a
           frame, since it's mutated from other circuits' threads. Count is the distinct-account count. *@
        <h2>Online now (@online.Count)</h2>
        <p class="muted">Accounts with the app open and connected right this moment — this updates live
            as people arrive and leave. Several tabs from one person count as one.</p>
        @if (online.Count == 0)
        {
            <p class="muted">Nobody's connected right now.</p>
        }
        else
        {
            <table>
                <caption class="visually-hidden">Accounts currently connected</caption>
                <thead>
                    <tr><th>Account</th><th>Connections</th><th>Since</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in online)
                    {
                        <tr @key="e.User.UserId">
                            <td>@e.User.Email</td>
                            <td>@e.Connections tab@(e.Connections == 1 ? "" : "s")</td>
                            <td>@e.Since.ToString("MMM d, HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h2>Logins</h2>
        <p class="muted">Every account's sign-in count, most-recently-active first — one row per account,
            counting registrations and each later sign-in.</p>
        @if (loginStats is null)
        {
            <p>Loading…</p>
        }
        else if (loginStats.Count == 0)
        {
            <p class="muted">No logins recorded yet.</p>
        }
        else
        {
            var totalLogins = loginStats.Sum(s => s.LoginCount);
            <p class="muted">@totalLogins total sign-in@(totalLogins == 1 ? "" : "s") across
                @loginStats.Count account@(loginStats.Count == 1 ? "" : "s").</p>
            <table>
                <caption class="visually-hidden">Per-account login counts, most recently active first</caption>
                <thead>
                    <tr><th>Account</th><th>Logins</th><th>Last seen</th><th>First</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in loginStats)
                    {
                        <tr @key="s.UserId">
                            <td>@s.Email</td>
                            <td>@s.LoginCount×</td>
                            <td>@s.LastLoginAt.ToString("MMM d, HH:mm")</td>
                            <td>@s.FirstLoginAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h2>Errors the app has logged</h2>
        <p class="muted">Every Error-level event, handled ones included, deduplicated by where it
            came from — one row per distinct error, counting repeats. Bounded at
            @ErrorLogStore.MaxRows rows (the quietest rows are trimmed first).</p>
        @if (Sink.Dropped > 0)
        {
            <p class="muted">⚠ @Sink.Dropped event@(Sink.Dropped == 1 ? "" : "s") dropped under load since the app started.</p>
        }
        <button class="secondary" @onclick="() => RefreshAsync()" disabled="@(busy || actionBusy)">@(busy ? "Refreshing…" : "Refresh")</button>
        @if (loadError is not null)
        {
            <p class="error" role="alert">@loadError</p>
        }
        @if (errors is null)
        {
            <p>Loading…</p>
        }
        else if (errors.Count == 0)
        {
            <p class="muted">Nothing logged — quiet so far.</p>
        }
        else
        {
            @* Open above, resolved collapsed below: the open table IS the to-do list, and 500 rows
               of handled noise in it would defeat the surface. "Open" is DERIVED (ErrorLogEntry
               .Resolved) — a resolved error that recurs is back up here on the next load, with its
               history saying so, and the capture pipeline never had to know. *@
            var open = errors.Where(e => !e.Resolved).ToList();
            var resolvedErrors = errors.Where(e => e.Resolved).ToList();
            @if (open.Count == 0)
            {
                <p class="muted">Nothing open — every logged error is marked handled.</p>
            }
            else
            {
                <table>
                    <caption class="visually-hidden">Distinct errors the app has logged, still open</caption>
                    <thead>
                        <tr>
                            <SortableHeader Column="lastseen" Label="Last seen" Sort="errorSort.Sort" OnSort="ErrorSortBy" />
                            <SortableHeader Column="count" Label="Count" Sort="errorSort.Sort" OnSort="ErrorSortBy" />
                            <SortableHeader Column="level" Label="Level" Sort="errorSort.Sort" OnSort="ErrorSortBy" />
                            <SortableHeader Column="what" Label="What" Sort="errorSort.Sort" OnSort="ErrorSortBy" />
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* @key: these lists lose and gain members per CLICK now, and without it
                           Blazor matches rows positionally — browser-held <details> state stuck to
                           a list POSITION, so resolving a row above an expanded stack trace showed
                           a different error's trace as expanded. *@
                        @foreach (var e in errorSort.Sort.Order(open, ErrorKey))
                        {
                            <tr @key="e.Id">
                                <td>@e.LastSeenAt.ToString("MMM d, HH:mm")</td>
                                <td>@e.Count×</td>
                                <td>@e.Level</td>
                                <td>
                                    <div>@e.LastMessage</div>
                                    <div class="muted small">@e.Category@(e.ExceptionType is null ? "" : $" · {e.ExceptionType}") · first seen @e.FirstSeenAt.ToString("MMM d")</div>
                                    @if (e.ExceptionDetail is not null)
                                    {
                                        <details>
                                            <summary>Detail</summary>
                                            <pre class="error-detail">@e.ExceptionDetail</pre>
                                        </details>
                                    }
                                    @if (e.ResolvedAt is { } was)
                                    {
                                        @* Resolved once and BACK — "open" would undersell a row the
                                           admin already dealt with; recurrence is the news. *@
                                        <div class="error small">⚠ seen again after being resolved @was.ToString("MMM d")</div>
                                    }
                                </td>
                                @* Resolve carries the LastSeenAt the admin is LOOKING AT: resolution
                                   means "handled through what I saw", so an occurrence from the
                                   render-to-click window (or one captured earlier but persisted
                                   later) lands past the mark and keeps the row open. Stamping "now"
                                   here silently swallowed exactly those. *@
                                <td><button class="secondary" @onclick="() => ResolveErrorAsync(e.Id, e.LastSeenAt)"
                                            disabled="@(busy || actionBusy)"
                                            aria-label="Resolve error: @e.LastMessage">Resolve</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (resolvedErrors.Count > 0)
            {
                <details>
                    <summary>Resolved (@resolvedErrors.Count)</summary>
                    @* Same columns as the open table — resolving must not cost the admin the level,
                       the category, or the stack trace (reopening a row just to read its detail is
                       a state mutation, and a resolved Critical is still a Critical). *@
                    <table>
                        <caption class="visually-hidden">Errors marked handled and quiet since</caption>
                        <thead>
                            <tr><th>Resolved</th><th>Last seen</th><th>Count</th><th>Level</th><th>What</th><th><span class="visually-hidden">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in resolvedErrors)
                            {
                                <tr class="muted" @key="e.Id">
                                    <td>@e.ResolvedAt?.ToString("MMM d, yyyy")</td>
                                    <td>@e.LastSeenAt.ToString("MMM d, HH:mm")</td>
                                    <td>@e.Count×</td>
                                    <td>@e.Level</td>
                                    <td>
                                        <div>@e.LastMessage</div>
                                        <div class="muted small">@e.Category@(e.ExceptionType is null ? "" : $" · {e.ExceptionType}") · first seen @e.FirstSeenAt.ToString("MMM d")</div>
                                        @if (e.ExceptionDetail is not null)
                                        {
                                            <details>
                                                <summary>Detail</summary>
                                                <pre class="error-detail">@e.ExceptionDetail</pre>
                                            </details>
                                        }
                                    </td>
                                    <td><button class="secondary" @onclick="() => ReopenErrorAsync(e.Id)"
                                                disabled="@(busy || actionBusy)"
                                                aria-label="Reopen error: @e.LastMessage">Reopen</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        }
    </section>

    @* The "link" between the audit log and the error log: the household activity trail sits right below
       the errors, so an operator can see what people were doing around the time an error fired. Read-only
       (AdminReportReader.ListRecentActivityAsync — admin-gated cross-household). A precise per-error
       breadcrumb would need to TAG each error with its household + capture the trail at error time, which
       the singleton logger can't do reliably mid-circuit — a documented follow-up. *@
    <section class="panel">
        <h2>Recent activity</h2>
        <p class="muted">The latest actions across every household — the audit trail from each household's
            History page, here so you can see what was happening around the time an error fired. Times are
            this server's local time.</p>
        @if (activity is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (activity.Count == 0)
        {
            <p class="muted">No recorded activity yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr><th>When</th><th>Household</th><th>Action</th><th>Where</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in activity)
                        {
                            <tr class="@(a.Undone ? "muted" : null)">
                                <td class="muted">@a.When.LocalDateTime.ToString("MMM d, HH:mm:ss")</td>
                                <td>@a.HouseholdName</td>
                                <td>@a.Summary@if (a.Undone) {<span class="muted"> (undone)</span>}</td>
                                <td class="muted">@(a.Source ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (activity.Count >= AdminReportReader.MaxActivity)
            {
                <p class="muted small">Showing the most recent @AdminReportReader.MaxActivity — older activity is on each household's History page.</p>
            }
        }
    </section>

    <section class="panel">
        <h2>Bug reports from households</h2>
        @if (bugReports is { Count: AdminReportReader.MaxReports })
        {
            <p class="muted">Showing @AdminReportReader.MaxReports reports, open ones first — more may exist beyond this cap.</p>
        }
        @if (bugReports is null)
        {
            <p>Loading…</p>
        }
        else if (bugReports.Count == 0)
        {
            <p class="muted">No reports yet.</p>
        }
        else
        {
            var openBugs = bugReports.Where(r => !r.Report.Resolved).ToList();
            var resolvedBugs = bugReports.Where(r => r.Report.Resolved).ToList();
            @if (openBugs.Count == 0)
            {
                <p class="muted">Nothing open — every report is marked resolved.</p>
            }
            else
            {
                <table>
                    <caption class="visually-hidden">Bug reports filed by every household, still open</caption>
                    <thead>
                        <tr><th>When</th><th>Household</th><th>Who</th><th>Where</th><th>What</th><th><span class="visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in openBugs)
                        {
                            <tr @key="r.Report.Id">
                                <td>@r.Report.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td>@r.HouseholdName</td>
                                <td>@(r.Report.ReportedBy ?? "—")</td>
                                <td class="muted">@(r.Report.PageUrl ?? "—")</td>
                                <td>
                                    @r.Report.Body
                                    <BugSnapshotView Json="@r.Report.StateJson" />
                                </td>
                                <td>
                                    @* Proposed → the reporter has been asked to confirm. Still offer the
                                       unilateral "Resolve" (the ghost-customer override) plus Withdraw.
                                       Open → Propose (the courteous default) or Resolve directly. *@
                                    @if (r.Report.AwaitingReporter)
                                    {
                                        <div class="muted small">Proposed @r.Report.ProposedResolvedAt?.ToString("MMM d") — awaiting the reporter</div>
                                        <button class="secondary" @onclick="() => ResolveBugAsync(r.Report.Id)"
                                                disabled="@(busy || actionBusy)"
                                                aria-label="Resolve the report from @r.HouseholdName: @r.Report.Body">Resolve</button>
                                        <button class="secondary" @onclick="() => WithdrawBugAsync(r.Report.Id)"
                                                disabled="@(busy || actionBusy)"
                                                aria-label="Withdraw the proposal on the report from @r.HouseholdName: @r.Report.Body">Withdraw</button>
                                    }
                                    else
                                    {
                                        <button class="secondary" @onclick="() => ProposeBugAsync(r.Report.Id)"
                                                disabled="@(busy || actionBusy)"
                                                aria-label="Propose the report from @r.HouseholdName as fixed for the reporter to confirm: @r.Report.Body">Propose resolved</button>
                                        <button class="secondary" @onclick="() => ResolveBugAsync(r.Report.Id)"
                                                disabled="@(busy || actionBusy)"
                                                aria-label="Resolve the report from @r.HouseholdName: @r.Report.Body">Resolve</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (resolvedBugs.Count > 0)
            {
                <details>
                    <summary>Resolved (@resolvedBugs.Count)</summary>
                    @* Who and Where stay — /bugs promises the reporter's email is attached "so they
                       can follow up", and resolving must not hide the address the follow-up needs
                       (reopening just to read it flips the reporter's chip back to open). *@
                    <table>
                        <caption class="visually-hidden">Bug reports marked resolved</caption>
                        <thead>
                            <tr><th>Resolved</th><th>When</th><th>Household</th><th>Who</th><th>Where</th><th>What</th><th><span class="visually-hidden">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in resolvedBugs)
                            {
                                <tr class="muted" @key="r.Report.Id">
                                    <td>@r.Report.ResolvedAt?.ToString("MMM d, yyyy")</td>
                                    <td>@r.Report.CreatedAt.ToString("MMM d, yyyy")</td>
                                    <td>@r.HouseholdName</td>
                                    <td>@(r.Report.ReportedBy ?? "—")</td>
                                    <td class="muted">@(r.Report.PageUrl ?? "—")</td>
                                    <td>
                                        @r.Report.Body
                                        <BugSnapshotView Json="@r.Report.StateJson" />
                                    </td>
                                    <td><button class="secondary" @onclick="() => ReopenBugAsync(r.Report.Id)"
                                                disabled="@(busy || actionBusy)"
                                                aria-label="Reopen the report from @r.HouseholdName: @r.Report.Body">Reopen</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        }
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ErrorLogEntry>? errors;

    // Column sort for the OPEN error log — the operator's triage table (by count, recency, level). Default
    // (and un-sort) is the reader's order; saved per device (via the shared TableSortController). The small
    // reference tables aren't sorted.
    private readonly TableSortController errorSort = new("admin-errors", "lastseen", "count", "level", "what");

    private IComparable? ErrorKey(ErrorLogEntry e) => errorSort.Sort.Column switch
    {
        "lastseen" => e.LastSeenAt,
        "count" => e.Count,
        "level" => e.Level,
        "what" => e.LastMessage,
        _ => e.LastSeenAt,
    };

    private Task ErrorSortBy(string column) => errorSort.ToggleAsync(column);

    private IReadOnlyList<AdminActivityRow>? activity;
    private IReadOnlyList<AdminBugReport>? bugReports;
    private IReadOnlyList<UserLoginStat>? loginStats;
    private IReadOnlyList<AdminHousehold>? households;
    private WishlistSummary? wishlistSummary;
    private IReadOnlyList<WishlistContact>? wishlistContacts;
    private string? wishlistCopyStatus;
    private AiSpendReport? aiSpend;
    private DemoUsageDay? demoUsage;
    private CiStatus? ciStatus;
    private bool ciLoaded;
    private TestStatusReport? testStatus;
    private bool refused;
    private bool subscribed;
    private bool busy;
    private bool actionBusy;
    private string? loadError;
    private string? actionError;
    private string? actionAnnouncement;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user is null || !AdminConfig.Value.IsAdmin(user))
        {
            refused = true;
            return;
        }
        // Live-update the "Online now" list. Subscribe only for the admin (a refused visitor renders none
        // of this), and only after the gate so a stranger's page never wires into presence.
        Presence.Changed += OnPresenceChanged;
        subscribed = true;
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || refused) return;

        // Restore this device's error-log sort (interop can't run during prerender, so it waits for here).
        if (await errorSort.LoadAsync(JS)) await InvokeAsync(StateHasChanged);

        // CI status is fetched from GitHub after the first paint, so a slow (or unreachable) GitHub never
        // blocks the admin page from rendering. The provider never throws — it returns an Error status — so
        // the only thing to guard is the teardown race (the admin navigated away mid-fetch).
        if (ciLoaded || !Ci.Enabled) return;
        ciLoaded = true;
        try
        {
            ciStatus = await Ci.GetAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or OperationCanceledException)
        {
            // The circuit went away between the fetch and the re-render.
        }
    }

    // Fired from the CHANGING circuit's thread (the user who just connected/left), so marshal to THIS
    // component's renderer — and never let anything escape: an exception out of an async void handler
    // re-raises onto that innocent user's circuit and faults it (OnlinePresence.Changed's "must not throw"
    // contract). A dispose/cancel race as this page tears down is expected and quiet; log anything else.
    private async void OnPresenceChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or OperationCanceledException)
        {
            // Expected: the admin's circuit went away between the event and the marshal.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "A live presence re-render on the admin page threw; swallowed so it can't fault the connecting user's circuit.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (subscribed) Presence.Changed -= OnPresenceChanged;
        await errorSort.DisposeAsync();
    }

    /// <summary>Self-reporting (returns whether it worked) so callers can split their advice by
    /// failure point — and it clears the action slots, so a manual Refresh also retires a stale
    /// action message instead of leaving an alert describing rows that are no longer there.</summary>
    private async Task<bool> RefreshAsync()
    {
        if (busy) return false;
        busy = true;
        loadError = null;
        actionError = null;
        actionAnnouncement = null;
        try
        {
            households = await HouseholdAdmin.ListAsync();
            errors = await Reader.ListErrorsAsync();
            activity = await Reader.ListRecentActivityAsync();
            bugReports = await Reader.ListBugReportsAsync();
            loginStats = await Reader.ListLoginStatsAsync();
            wishlistSummary = await Reader.GetWishlistSummaryAsync();
            wishlistContacts = await Reader.ListWishlistContactsAsync();
            aiSpend = await AiSpend.GetAsync();
            demoUsage = await DemoUsage.GetTodayAsync(); // null unless a Demo cap is configured (panel is gated on IsConfigured)
            testStatus = TestStatus.Read();
            return true;
        }
        catch (OperationCanceledException) { throw; }
        catch (UnauthorizedAccessException ex)
        {
            // The reader asks the same predicate — belt and braces. Logged: a refusal against a
            // caller the routed policy already admitted is the most diagnostic event this page has.
            Logger.LogError(ex, "The admin reader refused a caller the routed policy admitted.");
            refused = true;
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the admin view failed.");
            loadError = "Couldn't load just now — please try again.";
            return false;
        }
        finally
        {
            busy = false;
        }
    }

    // The error resolve carries the LastSeenAt the admin was LOOKING AT — see the button's comment
    // and ErrorLogEntry.ResolvedAt. The bug resolve stamps the clock: reports don't recur.
    private Task ResolveErrorAsync(int id, DateTimeOffset seenLastSeen) =>
        ActAsync(() => Actions.SetErrorResolvedAsync(id, seenLastSeen), "Resolved.");
    private Task ReopenErrorAsync(int id) => ActAsync(() => Actions.SetErrorResolvedAsync(id, null), "Reopened.");
    private Task ResolveBugAsync(int id) => ActAsync(() => Actions.SetBugResolvedAsync(id, DateTimeOffset.Now), "Resolved.");
    private Task ReopenBugAsync(int id) => ActAsync(() => Actions.SetBugResolvedAsync(id, null), "Reopened.");
    // Propose hands it to the reporter to confirm on /bugs; Withdraw (reopen while still unresolved) takes
    // the proposal back. Both route through the same cross-household service + ActAsync as the resolve.
    private Task ProposeBugAsync(int id) => ActAsync(() => Actions.SetBugProposedAsync(id, DateTimeOffset.Now), "Proposed — the reporter can confirm it.");
    private Task WithdrawBugAsync(int id) => ActAsync(() => Actions.SetBugResolvedAsync(id, null), "Withdrew the proposal — it's open again.");

    // Founder grant/revoke rides the same ActAsync as the resolve buttons: the write, then a refresh,
    // with the advice split by failure point and the roster re-read so the row's tier + button flip.
    private Task SetFounderAsync(string householdId, bool founder) =>
        ActAsync(() => HouseholdAdmin.SetFounderAsync(householdId, founder),
            founder ? "Granted Founder." : "Removed Founder.");

    /// <summary>One shape for all four actions, with the advice split by failure point (item 27):
    /// a failed WRITE says "nothing changed — try again" (safe: the write is idempotent), while a
    /// failed REFRESH after a successful write leads with "Saved" — the screen must never show a
    /// resolved row as open beside advice inviting a second resolve. Outcomes are set AFTER the
    /// refresh, which clears the action slots itself.</summary>
    private async Task ActAsync(Func<Task<bool>> action, string announcement)
    {
        if (actionBusy || busy) return;
        actionBusy = true;
        actionError = null;
        actionAnnouncement = null;
        try
        {
            var found = await action();
            var refreshed = await RefreshAsync();
            if (!found)
                actionError = "That row isn't there any more."; // trimmed, or deleted with its household's data
            else if (!refreshed)
                actionError = "Saved — but the lists couldn't refresh just now. Use Refresh to see it.";
            else
                actionAnnouncement = announcement;
        }
        catch (OperationCanceledException) { throw; }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogError(ex, "The resolve service refused a caller the routed policy admitted.");
            refused = true; // the service asks the same predicate — belt and braces
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resolving or reopening a report failed.");
            actionError = "Couldn't save that — nothing changed. Try again.";
        }
        finally
        {
            actionBusy = false;
        }
    }

    /// <summary>Export the notify list to the clipboard — newline-separated addresses, ready to paste into
    /// a mail tool's BCC. Reuses the app's clipboard posture (ClipboardCopy.TryWriteAsync — catches a
    /// refused clipboard so a denial can't tear the circuit down) and reports through the announcer.</summary>
    private async Task CopyWishlistEmailsAsync()
    {
        if (wishlistContacts is null or { Count: 0 }) return;
        var text = string.Join("\n", wishlistContacts.Select(c => c.Email));
        var ok = await ClipboardCopy.TryWriteAsync(JS, Logger, text);
        wishlistCopyStatus = ok
            ? $"Copied {wishlistContacts.Count} email address{(wishlistContacts.Count == 1 ? "" : "es")}."
            : "Couldn't copy — select the list and copy it manually.";
    }

    // The CI card's outcome → tile styling (.stat.pass/.fail reuse the accuracy page's green/red) and a
    // short label. The load-bearing status→outcome mapping lives on CiRun.Outcome (unit-tested); these are
    // just its presentation.
    private static string CiTileClass(CiOutcome outcome) => outcome switch
    {
        CiOutcome.Passed => "stat pass",
        CiOutcome.Failed => "stat fail",
        _ => "stat",
    };

    private static string CiOutcomeLabel(CiOutcome outcome) => outcome switch
    {
        CiOutcome.Passed => "✓ Passed",
        CiOutcome.Failed => "✗ Failed",
        CiOutcome.Running => "● Running",
        _ => "—",
    };
}
