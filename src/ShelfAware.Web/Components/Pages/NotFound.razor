@page "/not-found"
@layout MainLayout
@* Anonymous: the status-code re-execute must not bounce a signed-out visitor's 404 into a login loop. *@
@attribute [AllowAnonymous]

<PageTitle>Not found — Reginald</PageTitle>

<div class="page-head">
    <h1>Page not found</h1>
</div>
<div class="empty-state">
    <img src="icons/icon-512.png" alt="" class="mascot empty-mascot" />
    <div>
        <p class="muted">Even Eggs couldn't find that one — the page may have moved, or the link was mistyped.</p>
        <p><a href="/">← Back to the dashboard</a></p>
    </div>
</div>
