@page "/Account/ResetPassword"
@attribute [AllowAnonymous]
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<AppUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetPassword> Logger

<PageTitle>Set your password — Reginald</PageTitle>

@* One page for two links: a password RESET (an existing account, from ForgotPassword) and a new-account
   ACTIVATION (the registration email on a confirmation-required box). Both carry a reset token in ?code and
   set the password here — and a successful set also flips EmailConfirmed, which is what makes the activation
   case confirm the address. The wording is deliberately generic so it fits either arrival. *@
<h1>Set your password</h1>
<StatusMessage Message="@errorMessage" />

<EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
    <DataAnnotationsValidator />
    <div class="auth-field">
        <label for="email">Email</label>
        <InputText @bind-Value="Input.Email" id="email" type="email" autocomplete="username" required />
        <ValidationMessage For="() => Input.Email" />
    </div>
    <div class="auth-field">
        <label for="new-password">Password <span class="muted small">(at least 10 characters)</span></label>
        <InputText @bind-Value="Input.Password" id="new-password" type="password" autocomplete="new-password" required />
        <ValidationMessage For="() => Input.Password" />
    </div>
    <div class="auth-field">
        <label for="confirm-password">Confirm password</label>
        <InputText @bind-Value="Input.ConfirmPassword" id="confirm-password" type="password" autocomplete="new-password" required />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <button type="submit" class="auth-submit">Set password</button>
</EditForm>

<p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>

@code {
    private const string BadLinkMessage =
        "Error: this link is invalid or has expired. Request a fresh one from the sign-in page.";

    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        // Form binding runs before OnInitialized: a POST arrives bound, a GET gets a fresh model.
        Input ??= new();
        if (string.IsNullOrWhiteSpace(Code))
        {
            // No link, nothing to do — send them to where links come from. NOTE: this redirect
            // does NOT stop ResetAsync running on a POST (with BlazorDisableThrowNavigationException,
            // NavigateTo records the redirect and returns without unwinding, and the framework still
            // invokes the form handler in the same request) — the handler carries its own Code guard
            // for exactly that reason.
            RedirectManager.RedirectTo("Account/ForgotPassword");
        }
    }

    private async Task ResetAsync()
    {
        // Guard FIRST, before the user lookup. A hand-crafted code-less POST reaches this handler
        // despite OnInitialized's redirect (see the note there), and Base64UrlDecode(null) throws
        // ArgumentNullException — which the FormatException catch below does not catch. Unguarded,
        // that 500 fired only AFTER the lookup branched, so existing accounts answered 500 while
        // unknown ones answered 302: an account-enumeration oracle, found by the feature's review.
        // With the guard, every code-less POST takes the same path regardless of the email.
        if (string.IsNullOrWhiteSpace(Code))
        {
            errorMessage = BadLinkMessage;
            return;
        }

        // An unknown email gets the SAME sentence as a bad token: this form confirms account
        // existence no more than the request form does.
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            errorMessage = BadLinkMessage;
            return;
        }

        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            errorMessage = BadLinkMessage;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded)
        {
            // Setting the password here also CONFIRMS the email if it wasn't already — and on a
            // confirmation-required box that is the WHOLE activation step: the link was delivered to this
            // inbox and just proven under the user's control by setting a password through it, which is
            // exactly the possession proof confirmation exists to establish. So a new account created
            // passwordless (RegisterForConfirmationAsync) becomes confirmed AND signable in one go, and an
            // ordinary reset stops falling into the "password set — sign in" → "invalid email or password"
            // trap for an account that was never confirmed. Harmless where the flag is off (the account could
            // sign in regardless), and it tidies the data either way. Best-effort: a failed confirm-update
            // never turns a completed set into an error.
            if (!user.EmailConfirmed)
            {
                user.EmailConfirmed = true;
                var confirmed = await UserManager.UpdateAsync(user);
                if (!confirmed.Succeeded)
                {
                    Logger.LogWarning("Password reset completed but confirming the email failed: {Errors}",
                        string.Join("; ", confirmed.Errors.Select(e => e.Description)));
                }
            }

            // ResetPasswordAsync rotated the security stamp, so every existing session of this
            // account is evicted at the next revalidation — resetting a password signs out
            // whoever knew the old one.
            Logger.LogInformation("Password set via reset/activation link.");
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Your password is set — sign in with it.", HttpContext);
            return;
        }

        // Password-policy complaints are the user's own typing and safe to show; an invalid token
        // collapses into the same sentence as an unknown email.
        errorMessage = result.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.InvalidToken))
            ? BadLinkMessage
            : "Error: " + string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The password must be at least {2} characters long.", MinimumLength = 10)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
