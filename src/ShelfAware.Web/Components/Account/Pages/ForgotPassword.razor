@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@inject UserManager<AppUser> UserManager
@inject IAccountMailer Mailer
@inject IOptions<EmailOptions> Email
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot password — Shelf Aware</PageTitle>

<h1>Forgot your password?</h1>

@if (!Email.Value.IsConfigured)
{
    <p class="muted">
        This deployment can't send email, so there's no reset link to offer — whoever runs this
        server can recreate your account instead. The pantry is untouched either way: it belongs
        to the household, not the account.
    </p>
    <p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>
}
else
{
    <StatusMessage />
    <p class="muted">
        Enter your account's email and we'll send a reset link. The link expires after a day and
        stops working once used.
    </p>
    <EditForm Model="Input" method="post" OnValidSubmit="RequestResetAsync" FormName="forgot-password">
        <DataAnnotationsValidator />
        <div class="auth-field">
            <label for="email">Email</label>
            <InputText @bind-Value="Input.Email" id="email" type="email" autocomplete="username" required />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <button type="submit" class="auth-submit">Email me a reset link</button>
    </EditForm>
    <p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Form binding runs before OnInitialized: a POST arrives bound, a GET gets a fresh model.
        Input ??= new();
    }

    private async Task RequestResetAsync()
    {
        // ONE response for every outcome, delivered via redirect-with-status so a refresh can't
        // repost: this form must not reveal which emails have accounts. (The work below runs only
        // on the account-exists branch, so response TIMING still differs — accepted residual: the
        // per-IP limit on /Account POSTs bounds probing, and closing the timing channel would mean
        // doing fake work on the other branch.)
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            // Built from the live request (forwarded headers included), so the link carries
            // whichever front door the user is actually at — family.shelfaware.net, the tailnet
            // name, localhost.
            var url = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });
            try
            {
                await Mailer.SendPasswordResetAsync(Input.Email, url, HttpContext.RequestAborted);
                Logger.LogInformation("Password reset email sent.");
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                // A send failure (relay down, bad credentials) gets the SAME outward message:
                // "couldn't send" can only happen on the account-exists branch, so surfacing it
                // would answer exactly the question this form refuses to. Ops reads the log; the
                // user tries again later.
                Logger.LogError(ex, "Password reset email failed to send.");
            }
        }
        RedirectManager.RedirectToCurrentPageWithStatus(
            "If that email has an account here, a reset link is on its way.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
