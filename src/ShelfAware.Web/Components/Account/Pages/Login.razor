@page "/Account/Login"
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Options
@inject SignInManager<AppUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Login> Logger
@inject IOptions<EmailOptions> Email
@inject LoginAudit LoginAudit

<PageTitle>Sign in — Reginald</PageTitle>

<h1>Sign in</h1>
<StatusMessage Message="@errorMessage" />

<EditForm Model="Input" method="post" OnValidSubmit="LoginUserAsync" FormName="login">
    <DataAnnotationsValidator />
    <div class="auth-field">
        <label for="email">Email</label>
        <InputText @bind-Value="Input.Email" id="email" type="email" autocomplete="username" required />
        <ValidationMessage For="() => Input.Email" />
    </div>
    <div class="auth-field">
        <label for="password">Password</label>
        <InputText @bind-Value="Input.Password" id="password" type="password" autocomplete="current-password" required />
        <ValidationMessage For="() => Input.Password" />
    </div>
    <label class="auth-remember">
        <InputCheckbox @bind-Value="Input.RememberMe" /> Keep me signed in
    </label>
    <button type="submit" class="auth-submit">Sign in</button>
</EditForm>

@if (showResendConfirmation)
{
    @* Shown only after an unconfirmed sign-in attempt — the way out of a lost confirmation email. *@
    <p class="muted auth-alt"><a href="Account/ResendEmailConfirmation">Resend the confirmation email</a></p>
}

@if (Email.Value.IsConfigured)
{
    @* Config-gated like the external providers below: no email infrastructure, no dead link. *@
    <p class="muted auth-alt"><a href="Account/ForgotPassword">Forgot your password?</a></p>
}

@if (externalSchemes.Length > 0)
{
    <div class="auth-external">
        @foreach (var scheme in externalSchemes)
        {
            <form method="post" action="Account/PerformExternalLogin" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="provider" value="@scheme.Name" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <button type="submit" class="auth-external-btn">Continue with @(scheme.DisplayName ?? scheme.Name)</button>
            </form>
        }
    </div>
}

<p class="muted auth-alt">New here? <a href="Account/Register">Create an account</a> — or join your household with its invite code.</p>
<p class="muted auth-alt">Just looking? <a href="demo">Watch the 30-second tour</a> — no account needed.</p>
<p class="muted auth-alt"><a href="about">The story, the music &amp; a hosted version</a> — no account needed.</p>

@code {
    private string? errorMessage;

    // Set when a sign-in is refused for an unconfirmed email, so the resend link appears only when it's
    // the actual problem (not on a wrong password).
    private bool showResendConfirmation;

    // External providers are config-gated (registered only when credentials exist), so on most
    // deployments this is empty and the section renders nothing.
    private AuthenticationScheme[] externalSchemes = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Form binding runs before OnInitialized: a POST arrives bound, a GET gets a fresh model.
        // (An eager property initializer would be overwritten with null on posts — BL0008.)
        Input ??= new();
        externalSchemes = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear a stale external-provider cookie so a fresh sign-in starts clean.
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    private async Task LoginUserAsync()
    {
        // lockoutOnFailure: repeated bad passwords lock the account briefly (on top of the per-IP
        // rate limit on /Account POSTs). Outcomes are logged without the email or password.
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Logger.LogInformation("User signed in.");
            // Count the login for the admin view. Fully best-effort (the id lookup runs inside the audit's
            // guard too), so nothing here can turn a sign-in that already succeeded into an error page.
            await LoginAudit.RecordByEmailAsync(SignInManager.UserManager, Input.Email, DateTimeOffset.Now);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Sign-in blocked: account temporarily locked out.");
            errorMessage = "Error: this account is temporarily locked after repeated failed attempts. Try again in a few minutes.";
        }
        else if (result.IsNotAllowed)
        {
            // IsNotAllowed means the account EXISTS but is unconfirmed (RequireConfirmedAccount — the demo
            // box's Auth:RequireEmailConfirmation). ⚠️ Identity runs that gate in PreSignInCheck, BEFORE it
            // verifies the password, so this fires on ANY password — a wrong one included. Surfacing the
            // "confirm your email" hint + resend link on IsNotAllowed alone would therefore tell an
            // unauthenticated prober which addresses have unconfirmed accounts (the enumeration oracle the
            // pre-merge review caught). So reveal it ONLY when the password ALSO checks out: the real,
            // forgetful owner gets the helpful nudge, while a wrong password — like an unknown address or a
            // confirmed account's wrong password — falls through to the same generic message, leaving the
            // three indistinguishable. CheckPasswordAsync is a plain hash verify (no lockout side effect).
            var user = await SignInManager.UserManager.FindByEmailAsync(Input.Email);
            if (user is not null && await SignInManager.UserManager.CheckPasswordAsync(user, Input.Password))
            {
                Logger.LogInformation("Sign-in blocked: email not confirmed.");
                errorMessage = "Error: confirm your email address before signing in — check your inbox for the link we sent when you registered.";
                showResendConfirmation = true;
            }
            else
            {
                errorMessage = "Error: invalid email or password.";
            }
        }
        else
        {
            errorMessage = "Error: invalid email or password.";
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
