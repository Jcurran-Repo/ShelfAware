@page "/Account/RegisterConfirmation"
@attribute [AllowAnonymous]

<PageTitle>Confirm your email — Reginald</PageTitle>

<h1>Almost there — confirm your email</h1>

<p class="muted">
    We've emailed a confirmation link to the address you signed up with. Open it to finish setting up your
    account, then sign in. (If it doesn't arrive in a minute, check your spam folder.)
</p>

<p class="muted auth-alt"><a href="Account/ResendEmailConfirmation">Didn't get it? Resend the link</a></p>
<p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>
