@page "/Account/ResendEmailConfirmation"
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Options
@inject UserManager<AppUser> UserManager
@inject IAccountEmailQueue EmailQueue
@inject IOptions<AuthOptions> Auth
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResendEmailConfirmation> Logger

<PageTitle>Resend confirmation — Reginald</PageTitle>

<h1>Resend the confirmation email</h1>

@if (!Auth.Value.RequireEmailConfirmation)
{
    @* Gated on RequireEmailConfirmation, NOT merely EmailOptions.IsConfigured: a box can have email
       configured for the password reset while NOT requiring confirmation (the family box), and there every
       account is unconfirmed-but-fine — so resending a "confirm your account" link about a working account
       would be wrong (and an unauthenticated outbound-mail surface). The flag implies email is configured
       (startup validation refuses it otherwise), so this never dangles when the form IS shown. *@
    <p class="muted">This deployment doesn't require email confirmation, so there's nothing to resend.</p>
    <p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>
}
else
{
    <StatusMessage />
    <p class="muted">
        Enter your account's email. If it's registered and still needs confirming, we'll send a fresh link.
    </p>
    <EditForm Model="Input" method="post" OnValidSubmit="ResendAsync" FormName="resend-confirmation">
        <DataAnnotationsValidator />
        <div class="auth-field">
            <label for="email">Email</label>
            <InputText @bind-Value="Input.Email" id="email" type="email" autocomplete="username" required />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <button type="submit" class="auth-submit">Resend confirmation link</button>
    </EditForm>
    <p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Form binding runs before OnInitialized: a POST arrives bound, a GET gets a fresh model.
        Input ??= new();
    }

    private async Task ResendAsync()
    {
        // Server-side gate too, not just the hidden form: a hand-crafted POST to a box that doesn't require
        // confirmation gets the same generic redirect and sends nothing.
        if (!Auth.Value.RequireEmailConfirmation)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(GenericResponse, HttpContext);
            return;
        }

        // ONE response for every outcome (redirect-with-status so a refresh can't repost): unknown email,
        // already-confirmed, and queued all read the same — this form reveals no more than the ForgotPassword
        // one does. The link is QUEUED (not sent inline), so even the registered-and-unconfirmed branch
        // returns in ~ms — no send-timing difference between it and a miss.
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null && !await UserManager.IsEmailConfirmedAsync(user))
        {
            var token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            var url = AccountLinks.ConfirmEmailUrl(NavigationManager, user.Id, token);
            EmailQueue.Enqueue(new AccountEmailJob(AccountEmailKind.EmailConfirmation, Input.Email, url));
            Logger.LogInformation("Queued a resent email confirmation link.");
        }
        RedirectManager.RedirectToCurrentPageWithStatus(GenericResponse, HttpContext);
    }

    private const string GenericResponse =
        "If that email is registered and still needs confirming, a fresh link is on its way.";

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
