@page "/Account/ConfirmEmail"
@attribute [AllowAnonymous]
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<AppUser> UserManager
@inject ILogger<ConfirmEmail> Logger

<PageTitle>Confirm email — Reginald</PageTitle>

<h1>Confirm your email</h1>

@if (confirmed)
{
    @* Rendered IN-PAGE, not via a redirect-with-status cookie. The link is clicked from an email client,
       so the whole navigation chain is cross-site — a SameSite=Strict status cookie (what
       RedirectToWithStatus uses) is withheld by browsers on that chain, so a redirect to Login would land
       with no "confirmed!" notice for web-mail users. Showing the outcome here needs no cookie. *@
    <div class="auth-status auth-status-ok" role="status">
        Your email is confirmed — you can sign in now.
    </div>
    <p class="auth-alt"><a class="auth-submit" href="Account/Login">Sign in</a></p>
}
else
{
    <StatusMessage Message="@errorMessage" />
    <p class="muted auth-alt"><a href="Account/Login">← Back to sign in</a></p>
}

@code {
    // One sentence for every failure — unknown account, malformed code, expired/used token — so the page
    // confirms no account's existence and doesn't distinguish "already used" from "never valid".
    private const string BadLinkMessage =
        "Error: this confirmation link is invalid or has expired. Head to the sign-in page and use its " +
        "\"Confirm your email — resend the link\" option to get a fresh one.";

    private bool confirmed;
    private string? errorMessage;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // The link is a GET, so the confirmation happens here on load. Guard BOTH parameters first: a
        // hand-crafted link missing either takes the same generic path as a bad token (and a null Code
        // never reaches Base64UrlDecode, which throws ArgumentNullException rather than the FormatException
        // caught below — the enumeration-oracle shape the reset page documents).
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            errorMessage = BadLinkMessage;
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            errorMessage = BadLinkMessage;
            return;
        }

        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            errorMessage = BadLinkMessage;
            return;
        }

        var result = await UserManager.ConfirmEmailAsync(user, token);
        if (result.Succeeded)
        {
            Logger.LogInformation("An account confirmed its email address.");
            confirmed = true;
            return;
        }

        errorMessage = BadLinkMessage;
    }
}
