@* The diagnostic snapshot a reporter chose to attach to a bug report (BugReport.StateJson), rendered for
   the admin. Parses the stored blob forgivingly — a pre-feature or corrupt row renders nothing rather than
   throwing. Read-only: the admin reads what the household sent, never edits it. Shared by the open table
   and the resolved drawer so the two can't drift (the one-definition rule). *@
@using ShelfAware.Web.Diagnostics

@if (BugReportSnapshot.TryParse(Json) is { } snap)
{
    <details class="admin-attach">
        <summary>Attached details</summary>
        @if (snap.Diagnostics is { } d)
        {
            @* The SAME table the reporter reviewed on /bugs — one definition, so the two can't drift. *@
            <BugDiagnosticsView Diagnostics="d" />
        }
        @if (snap.PageContent is { } content)
        {
            <div class="muted small">What was on the page</div>
            <pre class="attach-content">@content</pre>
        }
    </details>
}

@code {
    [Parameter] public string? Json { get; set; }
}
