@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using ShelfAware.Web.Auth
@using ShelfAware.Web.Diagnostics
@using ShelfAware.Web.Services
@implements IDisposable
@inject IOptions<AdminOptions> Admin
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BugReportContext BugContext
@inject ILogger<SiteFooter> Logger

@if (Admin.Value.Configured)
{
    @* Gated on "an admin exists" — a report form on a deployment where nobody reads reports would
       be an invitation to shout into a void, so the whole entry point stands down (the same
       posture as the sign-in page's forgot-password link under EmailOptions.IsConfigured). *@
    <footer class="site-footer">
        @* An anchor, so it still works when JS is off or the click is a middle/modified one (a plain nav
           to /bugs, snapshot-less). A left click is intercepted to capture the page snapshot HERE — on the
           page the reporter is still looking at — before navigating; after /bugs loads, that page is gone. *@
        <a href="@BugsHref" @onclick="ReportAsync" @onclick:preventDefault>🐞 Report a bug</a>
        <AuthorizeView Policy="@AdminOptions.PolicyName">
            <a href="/admin">Admin</a>
        </AuthorizeView>
    </footer>
}

@code {
    // The link carries where the visitor currently IS, so the form can pre-fill "where it
    // happened" — into a visible, editable field, never as silent capture. PATH only: the current
    // page's own query string is noise in that pre-fill, and on /bugs itself it would compound the
    // from= into itself on every visit.
    private string BugsHref
    {
        get
        {
            var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            var query = relative.IndexOf('?');
            if (query >= 0) relative = relative[..query];
            return $"/bugs?from={Uri.EscapeDataString(relative)}";
        }
    }

    private bool capturing;

    /// <summary>Capture the page snapshot on THIS page (the one the reporter is looking at), stash it for
    /// /bugs to collect, then navigate. Capture never blocks the report: if snapshot() throws we file the
    /// report anyway, snapshot-less — the href already carries the from= pre-fill. Deliberately not silent:
    /// /bugs shows whatever was captured and lets the reporter drop either section before anything is stored.</summary>
    private async Task ReportAsync()
    {
        if (capturing) return;
        capturing = true;
        try
        {
            BugReportSnapshot? snapshot = null;
            try
            {
                snapshot = await JS.InvokeAsync<BugReportSnapshot>("shelfawareBugCapture.snapshot");
            }
            catch (JSException ex)
            {
                // snapshot() threw (e.g. bug-capture.js failed to load): log it and still open the form,
                // snapshot-less — capture is a bonus, never a gate on filing.
                Logger.LogWarning(ex, "Capturing the page snapshot for a bug report failed.");
            }
            BugContext.Stash(snapshot);
            Nav.NavigateTo(BugsHref);
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-capture (this footer is in MainLayout, so it's on every page):
            // swallow the teardown noise — there is nothing left to file or navigate. JSDisconnectedException
            // is NOT a JSException (it derives from Exception), so it must be caught on its own.
            // OperationCanceledException is left to propagate (the house rule) and is unreachable here anyway:
            // snapshot() is synchronous JS invoked with no cancellation token.
        }
        finally { capturing = false; }
    }

    // A parameterless component in a layout is skipped when the parent re-renders (nothing
    // changed, as far as Blazor can tell), so the href would go stale — re-render on navigation.
    protected override void OnInitialized() => Nav.LocationChanged += OnMoved;
    private void OnMoved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= OnMoved;
}
