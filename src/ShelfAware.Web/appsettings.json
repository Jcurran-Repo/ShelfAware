{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    // Whether visitors may self-register a NEW household (default true). Two paths stay open even
    // when false: the very first account (a fresh deploy must be enterable) and joining an existing
    // household with its invite code.
    "AllowRegistration": true
    // Demo box only (default off; §10). Require a confirmed email before sign-in — needs the "Email"
    // section configured, and locks out any account still unconfirmed, so back-fill EmailConfirmed=1
    // first on a box with existing accounts (the family box verifies email at the Cloudflare edge and
    // needs neither):
    //   "RequireEmailConfirmation": true
    // Box-wide cap on NEW accounts per day (default null = no limit; §10). A valid invite code is never
    // capped:
    //   "DailyAccountCreationLimit": 10
  },
  "Admin": {
    // In-app problem reporting: the sign-in emails granted the admin view (/admin — the error log
    // and every household's bug reports). Empty = no admin exists, and the whole feature stands
    // down: no footer link, no report form, /admin refuses everyone.
    "Emails": []
  },
  "Llm": {
    "Provider": "Anthropic",
    "ExtractionModel": "claude-haiku-4-5-20251001",
    "ChatModel": "claude-haiku-4-5-20251001",
    "MaxImageEdgePx": 1568
  }
}
