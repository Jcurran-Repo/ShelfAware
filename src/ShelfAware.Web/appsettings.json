{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    // Whether visitors may self-register a NEW household (default true). Two paths stay open even
    // when false: the very first account (a fresh deploy must be enterable) and joining an existing
    // household with its invite code.
    "AllowRegistration": true
    // Demo box only (default off; §10). Require a confirmed email before sign-in — needs the "Email"
    // section configured, and locks out any account still unconfirmed, so back-fill EmailConfirmed=1
    // first on a box with existing accounts (the family box verifies email at the Cloudflare edge and
    // needs neither):
    //   "RequireEmailConfirmation": true
    // Box-wide cap on NEW accounts per day (§10). Unset: on a RequireEmailConfirmation box it falls back to
    // a default of 10/day (never accidentally unbounded); on a direct box it means no limit. On a direct box
    // only the new-household path is capped (an invite-join is never turned away); on a confirmation box the
    // household is chosen later, so the cap gates EVERY registration (an invitee registers under it, then
    // joins uncapped at the chooser). Set explicitly to override (a high value runs a confirm box uncapped):
    //   "DailyAccountCreationLimit": 10
  },
  "Admin": {
    // In-app problem reporting: the sign-in emails granted the admin view (/admin — the error log
    // and every household's bug reports). Empty = no admin exists, and the whole feature stands
    // down: no footer link, no report form, /admin refuses everyone.
    "Emails": []
  },
  // --- Read-aloud voice (unset = ElevenLabs, the historical default) --------------------
  // A box that wants the FREE voice runs Kokoro-82M in this process: no key, no per-character
  // cost, nothing to meter and nothing to deploy beside the app. A Linux box sets these as
  // environment variables (deploy/env.example); a Windows box sets them here, in ITS OWN copy
  // of this file -- publish-family.ps1 carries the server folder's appsettings*.json across
  // every publish, OVER the one in the publish output, so editing this repo copy configures a
  // NEW box, never an existing one.
  //
  // ⚠️ Unpack the model BEFORE setting Provider. The app refuses to start when pointed at a
  // model directory that isn't there -- deliberately, because the native library answers a bad
  // path with a SIGSEGV on the first read-aloud rather than an exception. See
  // docs/deploy-kokoro.md for the archive, where to put it, and how to prove it speaks first.
  //
  //   "Speech": {
  //     "Provider": "Kokoro",
  //     "Kokoro": {
  //       // Absolute, or relative to the process's working directory. Forward slashes are fine
  //       // on Windows and avoid JSON's doubled backslashes.
  //       "ModelDirectory": "C:/Users/<you>/ShelfAware-server/app-data/models/kokoro-int8-en-v0_19",
  //       "SpeakerId": 0,          // 0-10 for that archive; audition them with tools/VoiceCheck
  //       "Speed": 0.9,            // under 1.0 so a busy cook can follow along
  //       "NumThreads": 2          // ~real time at 2; raise on a box with cores to spare
  //     },
  //     // Clips are WAV, ~10x an MP3, so 256 MB is ~90 minutes of speech per household.
  //     "CacheMegabytes": 256
  //   },
  "Llm": {
    "Provider": "Anthropic",
    "ExtractionModel": "claude-haiku-4-5-20251001",
    "ChatModel": "claude-haiku-4-5-20251001",
    "MaxImageEdgePx": 1568
  }
}
