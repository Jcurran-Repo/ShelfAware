<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ShelfAware.Tools.TestStatusGen</RootNamespace>
    <AssemblyName>TestStatusGen</AssemblyName>
    <!-- A build-time tool (CI folds the test .trx files into test-status.json); never packed or shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShelfAware.Core\ShelfAware.Core.csproj" />
  </ItemGroup>

</Project>
